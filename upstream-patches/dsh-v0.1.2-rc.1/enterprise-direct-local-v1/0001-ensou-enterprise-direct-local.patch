+function writeSkill(root: string, name: string, description: string, body: string): void {
+  const directory = join(root, name)
+  mkdirSync(directory, { recursive: true })
+  writeFileSync(join(directory, 'SKILL.md'), [
+    '---',
+    `name: ${name}`,
+    `description: ${description}`,
+    '---',
+    '',
+    body,
+    '',
+  ].join('\n'))
+}
+
+function environment(
+  signal?: string,
+  proxy: Record<string, string> = {},
+  includeManagedSkillsRoot = true,
+): LaunchEnvironmentSnapshot {
+  const managedProxy = signal === undefined
+    ? {}
+    : {
+      DEEPSEEK_BASE_URL: 'http://127.0.0.1:43123/v1',
+      DEEPSEEK_SEARCH_BASE_URL: 'http://127.0.0.1:43123/v1',
+      DEEPSEEK_API_KEY: 'AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA',
+      ...(includeManagedSkillsRoot ? { [MANAGED_SKILLS_ROOT_ENV]: defaultManagedSkillsRoot } : {}),
+    }
+  return createLaunchEnvironmentSnapshot([{
+    source: 'process',
+    values: signal === undefined ? proxy : { [MANAGED_BOOT_SIGNAL]: signal, ...managedProxy, ...proxy },
+  }])

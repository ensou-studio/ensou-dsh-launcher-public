{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher external signing response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "responseType",
    "orchestrationId",
    "edition",
    "releaseSetId",
    "planSha256",
    "requestSha256",
    "requestNonce",
    "completedAtUtc",
    "files",
    "authentication"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "responseType": { "const": "ensou-dsh-launcher-client-authenticode-signing-response" },
    "orchestrationId": { "type": "string", "format": "uuid" },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "releaseSetId": { "type": "string", "minLength": 1, "maxLength": 128 },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "requestSha256": { "$ref": "#/definitions/sha256" },
    "requestNonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "fileName",
          "relativePath",
          "inputSha256",
          "inputPeContentSha256",
          "sizeBytes",
          "sha256",
          "signedPeContentSha256"
        ],
        "properties": {
          "role": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "fileName": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$" },
          "relativePath": { "type": "string", "pattern": "^signed/[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$" },
          "inputSha256": { "$ref": "#/definitions/sha256" },
          "inputPeContentSha256": { "$ref": "#/definitions/sha256" },
          "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 536870912 },
          "sha256": { "$ref": "#/definitions/sha256" },
          "signedPeContentSha256": { "$ref": "#/definitions/sha256" }
        }
      }
    },
    "authentication": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "keyId", "value"],
          "properties": {
            "algorithm": { "const": "ES256" },
            "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["algorithm", "keyId", "purpose", "payloadType", "value"],
          "properties": {
            "algorithm": { "const": "ES256" },
            "keyId": { "type": "string", "minLength": 1, "maxLength": 128 },
            "purpose": { "const": "client-signing-response" },
            "payloadType": { "const": "ensou-dsh-launcher-external-signing-response-authentication-v2" },
            "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
          }
        }
      ]
    }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wholeSecondUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" }
  }
}

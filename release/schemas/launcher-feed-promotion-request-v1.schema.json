{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher offline feed-promotion request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestType",
    "operationId",
    "orchestrationId",
    "edition",
    "exposureRing",
    "feedChannel",
    "publishScope",
    "releaseSetId",
    "sourceState",
    "expectedFeedIdentitySha256",
    "feedCas",
    "feedCasSha256",
    "payloadSetSha256",
    "files",
    "authorizationTrust",
    "requestNonce",
    "createdAtUtc",
    "expiresAtUtc",
    "productionAdmission",
    "networkPublishPerformed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestType": {
      "const": "ensou-dsh-launcher-offline-feed-promotion-request"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "orchestrationId": { "$ref": "#/definitions/orchestrationId" },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "exposureRing": { "enum": ["pilot", "stable"] },
    "feedChannel": { "enum": ["pilot", "stable"] },
    "publishScope": {
      "enum": ["channel-head", "private-pilot-allowlist", "public-stable"]
    },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "sourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "targetChannel",
        "revision",
        "phase",
        "planSizeBytes",
        "planSha256",
        "identitySizeBytes",
        "identitySha256",
        "headSizeBytes",
        "headSha256",
        "receiptChainStartRevision",
        "receiptChainSha256",
        "candidateReceiptSha256"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "targetChannel": { "enum": ["pilot", "stable"] },
        "revision": { "enum": [7, 8] },
        "phase": {
          "enum": ["INSTALLER_SIGNATURE_IMPORTED", "PILOT_EVIDENCE_BOUND"]
        },
        "planSizeBytes": { "$ref": "#/definitions/positiveSize" },
        "planSha256": { "$ref": "#/definitions/sha256" },
        "identitySizeBytes": { "$ref": "#/definitions/positiveSize" },
        "identitySha256": { "$ref": "#/definitions/sha256" },
        "headSizeBytes": { "$ref": "#/definitions/positiveSize" },
        "headSha256": { "$ref": "#/definitions/sha256" },
        "receiptChainStartRevision": { "const": 1 },
        "receiptChainSha256": { "$ref": "#/definitions/sha256" },
        "candidateReceiptSha256": { "$ref": "#/definitions/sha256" }
      },
      "allOf": [
        {
          "if": { "properties": { "revision": { "const": 7 } } },
          "then": {
            "properties": { "phase": { "const": "INSTALLER_SIGNATURE_IMPORTED" } }
          }
        },
        {
          "if": { "properties": { "revision": { "const": 8 } } },
          "then": {
            "properties": { "phase": { "const": "PILOT_EVIDENCE_BOUND" } }
          }
        }
      ]
    },
    "expectedFeedIdentitySha256": { "$ref": "#/definitions/sha256" },
    "feedCas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["channelHead", "journalHead"],
      "properties": {
        "channelHead": { "$ref": "#/definitions/rawStateExpectation" },
        "journalHead": { "$ref": "#/definitions/rawStateExpectation" }
      }
    },
    "feedCasSha256": { "$ref": "#/definitions/sha256" },
    "payloadSetSha256": { "$ref": "#/definitions/sha256" },
    "files": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": { "$ref": "#/definitions/fileIdentity" }
    },
    "authorizationTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "x", "y"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/keyId" },
        "purpose": { "const": "feed-promotion-response" },
        "x": { "$ref": "#/definitions/p256Coordinate" },
        "y": { "$ref": "#/definitions/p256Coordinate" }
      }
    },
    "requestNonce": { "$ref": "#/definitions/base64url32" },
    "createdAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "expiresAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "productionAdmission": { "const": "NO_GO" },
    "networkPublishPerformed": { "const": false }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "edition": { "const": "Personal" },
          "exposureRing": { "const": "pilot" }
        },
        "required": ["edition", "exposureRing"]
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "pilot" },
          "publishScope": { "const": "channel-head" },
          "files": { "minItems": 3, "maxItems": 3 },
          "sourceState": {
            "properties": {
              "targetChannel": { "const": "pilot" },
              "revision": { "const": 7 },
              "phase": { "const": "INSTALLER_SIGNATURE_IMPORTED" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": { "const": "Personal" },
          "exposureRing": { "const": "stable" }
        },
        "required": ["edition", "exposureRing"]
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "stable" },
          "publishScope": { "const": "channel-head" },
          "files": { "minItems": 3, "maxItems": 3 },
          "sourceState": {
            "properties": {
              "targetChannel": { "const": "stable" },
              "revision": { "const": 8 },
              "phase": { "const": "PILOT_EVIDENCE_BOUND" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": { "const": "Enterprise" },
          "exposureRing": { "const": "pilot" }
        },
        "required": ["edition", "exposureRing"]
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "stable" },
          "publishScope": { "const": "private-pilot-allowlist" },
          "files": { "minItems": 5, "maxItems": 5 },
          "sourceState": {
            "properties": {
              "targetChannel": { "const": "stable" },
              "revision": { "const": 7 },
              "phase": { "const": "INSTALLER_SIGNATURE_IMPORTED" }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": { "const": "Enterprise" },
          "exposureRing": { "const": "stable" }
        },
        "required": ["edition", "exposureRing"]
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "stable" },
          "publishScope": { "const": "public-stable" },
          "files": { "minItems": 5, "maxItems": 5 },
          "sourceState": {
            "properties": {
              "targetChannel": { "const": "stable" },
              "revision": { "const": 8 },
              "phase": { "const": "PILOT_EVIDENCE_BOUND" }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "positiveSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "wholeSecondUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "orchestrationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "p256Coordinate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "base64url32": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "rawStateExpectation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": { "state": { "const": "missing" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "sizeBytes", "sha256"],
          "properties": {
            "state": { "const": "present" },
            "sizeBytes": { "$ref": "#/definitions/positiveSize" },
            "sha256": { "$ref": "#/definitions/sha256" }
          }
        }
      ]
    },
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "relativePath", "sizeBytes", "sha256"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 9,
          "maxLength": 263,
          "pattern": "^payload/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sizeBytes": { "$ref": "#/definitions/positiveSize" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}

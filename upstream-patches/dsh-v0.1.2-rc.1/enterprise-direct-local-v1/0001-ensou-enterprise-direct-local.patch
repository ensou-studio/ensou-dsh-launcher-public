+/** Resolve one trusted installation exclusively from the app's physical manifest anchor. */
+function findTrustedInstallation(installAnchor: string): TrustedInstallation {
+  if (!isAbsolute(installAnchor)) {
+    throw new Error(`dsh-app-boot: installation anchor must be absolute: ${installAnchor}`)
+  }
+  const anchorPath = resolve(installAnchor)
+  assertPhysicalMarker(anchorPath, 'installation anchor')
+  const anchorManifest = JSON.parse(readFileSync(anchorPath, 'utf8')) as PackageManifest
+  if (typeof anchorManifest.name !== 'string') {
+    throw new Error(`dsh-app-boot: installation anchor has no package name: ${anchorPath}`)
+  }
+  const nameParts = packageNameParts(anchorManifest.name)
+  if (nameParts === undefined) {
+    throw new Error(`dsh-app-boot: installation anchor has an invalid package name: ${anchorPath}`)
+  }

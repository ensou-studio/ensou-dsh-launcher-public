{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensou.example/schemas/managed-plugin-harness-compatibility-receipt-v1.schema.json",
  "title": "Managed plugin Harness compatibility receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "producer",
    "result",
    "startedAtUtc",
    "observedAtUtc",
    "launcherReleaseId",
    "launcherArtifact",
    "runtimeReleaseId",
    "runtimeArtifact",
    "harnessSourceTag",
    "policy",
    "plugins",
    "observations"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "receiptType": { "const": "managed-plugin-harness-compatibility" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "testRunId", "fileName", "sizeBytes", "sha256"],
      "properties": {
        "component": { "const": "Ensou.Dsh.EnterprisePluginCompatibilityRunner" },
        "testRunId": { "$ref": "#/$defs/uuid" },
        "fileName": { "const": "Ensou.Dsh.EnterprisePluginCompatibilityRunner.exe" },
        "sizeBytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "result": { "const": "PASS" },
    "startedAtUtc": { "$ref": "#/$defs/wholeSecondUtc" },
    "observedAtUtc": { "$ref": "#/$defs/wholeSecondUtc" },
    "launcherReleaseId": { "$ref": "#/$defs/releaseId" },
    "launcherArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": { "$ref": "#/$defs/fileName" },
        "sizeBytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "runtimeReleaseId": { "$ref": "#/$defs/releaseId" },
    "runtimeArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256", "sourceMetadataSha256"],
      "properties": {
        "fileName": { "$ref": "#/$defs/fileName" },
        "sizeBytes": { "$ref": "#/$defs/positiveSafeInteger" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "sourceMetadataSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "harnessSourceTag": { "const": "dsh-v0.1.2-rc.1" },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policyId",
        "generation",
        "archiveSha256",
        "metadataSha256",
        "rawPolicySha256",
        "executionAdmissionReceiptSha256"
      ],
      "properties": {
        "policyId": { "$ref": "#/$defs/uuid" },
        "generation": { "$ref": "#/$defs/positiveSafeInteger" },
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "metadataSha256": { "$ref": "#/$defs/sha256" },
        "rawPolicySha256": { "$ref": "#/$defs/sha256" },
        "executionAdmissionReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/pluginObservation" }
    },
    "observations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "launcherBinarySelfCheck",
        "runtimeHealth",
        "pluginPolicyInstalled",
        "pluginCommandExecuted",
        "managedPolicyEnforced",
        "startupUpdateCheck",
        "rollbackRestoredPreviousRuntime",
        "conversationHistoryPreserved",
        "workspacePreserved"
      ],
      "properties": {
        "launcherBinarySelfCheck": { "const": "PASS" },
        "runtimeHealth": { "const": "PASS" },
        "pluginPolicyInstalled": { "const": "PASS" },
        "pluginCommandExecuted": { "const": "PASS" },
        "managedPolicyEnforced": { "const": "PASS" },
        "startupUpdateCheck": { "const": "PASS" },
        "rollbackRestoredPreviousRuntime": { "const": "PASS" },
        "conversationHistoryPreserved": { "const": "PASS" },
        "workspacePreserved": { "const": "PASS" }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[^/\\\\]+$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9@+_.-]+(?:/[A-Za-z0-9@+_.-]+)*$"
    },
    "pluginObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "skillId",
        "version",
        "root",
        "declaredTreeSha256",
        "commandExecuted",
        "managedPolicyEnforced"
      ],
      "properties": {
        "skillId": { "$ref": "#/$defs/token" },
        "version": { "$ref": "#/$defs/token" },
        "root": { "$ref": "#/$defs/relativePath" },
        "declaredTreeSha256": { "$ref": "#/$defs/sha256" },
        "commandExecuted": { "const": "PASS" },
        "managedPolicyEnforced": { "const": "PASS" }
      }
    }
  }
}

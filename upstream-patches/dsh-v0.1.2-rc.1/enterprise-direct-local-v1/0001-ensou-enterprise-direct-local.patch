+  const deployedAnchor = join(runtimeRoot, 'node_modules', ...nameParts, 'package.json')
+  const runtimeMarker = join(runtimeRoot, 'runtime-closure.json')
+  if (anchorPath === deployedAnchor && existsSync(runtimeMarker)) {
+    const packageManifests = indexRuntimeClosurePackages(runtimeRoot)
+    if (packageManifests.get(anchorManifest.name) !== anchorPath) {
+      throw new Error('dsh-app-boot: installation anchor is not a direct package in the runtime closure')
+    }
+    return { kind: 'runtime-closure', root: runtimeRoot, packageManifests }
+  }

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ensou.example/release/enterprise-feed-promoter-production-bundle-v1.schema.json",
  "title": "Ensou DSH Enterprise FeedPromoter production bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleType",
    "product",
    "environment",
    "runtimeIdentifier",
    "selfContained",
    "singleFile",
    "sourceCommit",
    "dotnetSdkVersion",
    "manifestOrigin",
    "artifactOrigin",
    "releaseKeyIds",
    "certificationKeyIds",
    "files"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleType": {
      "const": "ensou-dsh-enterprise-feed-promoter-production-bundle-v1"
    },
    "product": { "const": "ensou-dsh-enterprise" },
    "environment": { "const": "production" },
    "runtimeIdentifier": { "const": "linux-x64" },
    "selfContained": { "const": true },
    "singleFile": { "const": true },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "dotnetSdkVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "manifestOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#]+/$"
    },
    "artifactOrigin": {
      "type": "string",
      "pattern": "^https://[^/?#]+/$"
    },
    "releaseKeyIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "certificationKeyIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/feedPromoterFile"
        },
        {
          "$ref": "#/$defs/productionTrustFile"
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "fileIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "sizeBytes", "sha256"],
      "properties": {
        "role": { "type": "string" },
        "fileName": { "type": "string" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "feedPromoterFile": {
      "allOf": [
        { "$ref": "#/$defs/fileIdentity" },
        {
          "properties": {
            "role": { "const": "feed-promoter" },
            "fileName": { "const": "ensou-dsh-enterprise-feed-promoter" }
          }
        }
      ]
    },
    "productionTrustFile": {
      "allOf": [
        { "$ref": "#/$defs/fileIdentity" },
        {
          "properties": {
            "role": { "const": "production-trust" },
            "fileName": { "const": "enterprise-feed-production-trust.json" },
            "sizeBytes": { "maximum": 262144 }
          }
        }
      ]
    }
  }
}

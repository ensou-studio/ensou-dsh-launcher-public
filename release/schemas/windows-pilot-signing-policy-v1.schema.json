{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Windows two-device Pilot signing execution policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "policyType", "executionAdmission", "profile",
    "signTool", "authenticode", "tsa", "responseKeys", "roots", "limits"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyType": { "const": "ensou-dsh-windows-pilot-signing-execution-policy" },
    "executionAdmission": {
      "enum": [
        "NO_GO_EXAMPLE",
        "PERSONAL_PILOT_SIGNING",
        "ENTERPRISE_PILOT_SIGNING"
      ]
    },
    "profile": {
      "enum": ["PersonalTwoDevice", "EnterpriseTwoDevice"]
    },
    "signTool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "fileVersion", "sha256"],
      "properties": {
        "path": { "$ref": "#/definitions/windowsFilePath" },
        "fileVersion": {
          "type": "string",
          "minLength": 3,
          "maxLength": 64,
          "pattern": "^[0-9]+(?:\\.[0-9]+){1,3}$"
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "authenticode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "storeLocation", "certificateThumbprintSha1", "certificateSha256",
        "provider", "algorithmGroup", "keySizeBits", "pilotRootCertificatePath",
        "pilotRootCertificateSha256", "minimumValidityDays"
      ],
      "properties": {
        "storeLocation": { "const": "CurrentUser/My" },
        "certificateThumbprintSha1": { "$ref": "#/definitions/sha1" },
        "certificateSha256": { "$ref": "#/definitions/sha256" },
        "provider": { "const": "Microsoft Software Key Storage Provider" },
        "algorithmGroup": { "const": "RSA" },
        "keySizeBits": { "const": 3072 },
        "pilotRootCertificatePath": { "$ref": "#/definitions/windowsFilePath" },
        "pilotRootCertificateSha256": { "$ref": "#/definitions/sha256" },
        "minimumValidityDays": { "type": "integer", "minimum": 1, "maximum": 90 }
      }
    },
    "tsa": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "canonicalUriSha256", "trustedSignerChains"],
      "properties": {
        "uri": {
          "type": "string",
          "minLength": 10,
          "maxLength": 2048,
          "pattern": "^https?://[^/?#]+(?:/[A-Za-z0-9._~-]+)*/?$"
        },
        "canonicalUriSha256": { "$ref": "#/definitions/sha256" },
        "trustedSignerChains": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/tsaSignerChain" }
        }
      }
    },
    "responseKeys": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientSigning"],
      "properties": {
        "clientSigning": {
          "allOf": [
            { "$ref": "#/definitions/responseKey" },
            {
              "properties": {
                "purpose": { "const": "client-signing-response" }
              }
            }
          ]
        },
        "personalInstallerSigning": {
          "allOf": [
            { "$ref": "#/definitions/responseKey" },
            {
              "properties": {
                "purpose": { "const": "personal-installer-signing-response" }
              }
            }
          ]
        },
        "enterpriseInstallerSigning": {
          "allOf": [
            { "$ref": "#/definitions/responseKey" },
            {
              "properties": {
                "purpose": { "const": "installer-signing-response" }
              }
            }
          ]
        }
      }
    },
    "roots": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestRoot", "transactionRoot", "outputRoot"],
      "properties": {
        "requestRoot": { "$ref": "#/definitions/windowsDirectoryPath" },
        "transactionRoot": { "$ref": "#/definitions/windowsDirectoryPath" },
        "outputRoot": { "$ref": "#/definitions/windowsDirectoryPath" }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signToolTimeoutSeconds", "maximumProcessOutputBytes"],
      "properties": {
        "signToolTimeoutSeconds": { "type": "integer", "minimum": 10, "maximum": 600 },
        "maximumProcessOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "profile": { "const": "PersonalTwoDevice" } },
        "required": ["profile"]
      },
      "then": {
        "properties": {
          "executionAdmission": {
            "enum": ["NO_GO_EXAMPLE", "PERSONAL_PILOT_SIGNING"]
          },
          "responseKeys": {
            "required": ["personalInstallerSigning"],
            "not": { "required": ["enterpriseInstallerSigning"] }
          }
        }
      },
      "else": {
        "properties": {
          "executionAdmission": {
            "enum": ["NO_GO_EXAMPLE", "ENTERPRISE_PILOT_SIGNING"]
          },
          "responseKeys": {
            "required": ["enterpriseInstallerSigning"],
            "not": { "required": ["personalInstallerSigning"] }
          }
        }
      }
    }
  ],
  "definitions": {
    "sha1": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "base64url32": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "windowsFilePath": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "pattern": "^[A-Za-z]:\\\\[^\\r\\n:*?\\\"<>|]+(?:\\\\[^\\r\\n:*?\\\"<>|]+)*$"
    },
    "windowsDirectoryPath": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^[A-Za-z]:\\\\[^\\r\\n:*?\\\"<>|]+(?:\\\\[^\\r\\n:*?\\\"<>|]+)*$"
    },
    "tsaSignerChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chainId", "validFromUtc", "validUntilUtc",
        "leafCertificateSha256", "intermediateCertificateSha256s",
        "rootCertificateSha256"
      ],
      "properties": {
        "chainId": { "$ref": "#/definitions/token" },
        "validFromUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "validUntilUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "leafCertificateSha256": { "$ref": "#/definitions/sha256" },
        "intermediateCertificateSha256s": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/sha256" }
        },
        "rootCertificateSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "responseKey": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm", "provider", "keyName", "keyId", "purpose", "x", "y"
      ],
      "properties": {
        "algorithm": { "const": "ES256" },
        "provider": { "const": "Microsoft Software Key Storage Provider" },
        "keyName": { "$ref": "#/definitions/token" },
        "keyId": { "$ref": "#/definitions/token" },
        "purpose": { "$ref": "#/definitions/token" },
        "x": { "$ref": "#/definitions/base64url32" },
        "y": { "$ref": "#/definitions/base64url32" }
      }
    }
  }
}

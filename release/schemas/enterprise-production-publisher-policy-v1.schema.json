{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Enterprise production Publisher policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "policyType",
    "launcherReleaseId",
    "pluginPolicyReleaseId",
    "generation",
    "sequence",
    "minAcceptedSequence",
    "expiresAtUtc",
    "revokedReleaseSetIds",
    "pluginGenerationLedgerNamespace"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyType": {
      "const": "ensou-dsh-enterprise-production-publisher-policy"
    },
    "launcherReleaseId": { "$ref": "#/definitions/releaseId" },
    "pluginPolicyReleaseId": { "$ref": "#/definitions/releaseId" },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "minAcceptedSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expiresAtUtc": {
      "type": "string",
      "minLength": 28,
      "maxLength": 28,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.0000000Z$"
    },
    "revokedReleaseSetIds": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/definitions/releaseId" }
    },
    "pluginGenerationLedgerNamespace": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._+-]*$"
    }
  },
  "definitions": {
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._+-]*$"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher Installer signing response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "responseType",
    "orchestrationId",
    "edition",
    "releaseSetId",
    "channel",
    "planSha256",
    "sourceTree",
    "sourceBuildInputSetSha256",
    "requestRelativePath",
    "requestSha256",
    "requestNonce",
    "baseHeadSha256",
    "admissionHeadSha256",
    "admissionRevision",
    "r6ReceiptRelativePath",
    "r6ReceiptSha256",
    "requestCreatedAtUtc",
    "requestExpiresAtUtc",
    "completedAtUtc",
    "candidateSetSha256",
    "payloadSetSha256",
    "r3SignedClientSetSha256",
    "releaseManifestTrustSha256",
    "releaseManifestTrustProbeSetSha256",
    "toolchainLockSha256",
    "targetBuildIdentitySha256",
    "unsignedInstaller",
    "signedInstaller",
    "authenticode",
    "payloadSelfCheck",
    "authentication"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "responseType": {
      "const": "ensou-dsh-launcher-installer-signing-response"
    },
    "orchestrationId": { "$ref": "#/definitions/orchestrationId" },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "releaseSetId": { "$ref": "#/definitions/releaseSetId" },
    "channel": { "enum": ["pilot", "stable"] },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "sourceTree": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sourceBuildInputSetSha256": { "$ref": "#/definitions/sha256" },
    "requestRelativePath": {
      "enum": [
        "requests/installer-signing.v1/installer-signing-request.v1.json",
        "requests/installer-signing.v2/installer-signing-request.v2.json"
      ]
    },
    "requestSha256": { "$ref": "#/definitions/sha256" },
    "requestNonce": { "$ref": "#/definitions/nonce" },
    "baseHeadSha256": { "$ref": "#/definitions/sha256" },
    "admissionHeadSha256": { "$ref": "#/definitions/sha256" },
    "admissionRevision": { "const": 6 },
    "r6ReceiptRelativePath": {
      "const": "receipts/0006-installer-signing-requested.json"
    },
    "r6ReceiptSha256": { "$ref": "#/definitions/sha256" },
    "requestCreatedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "requestExpiresAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "candidateSetSha256": { "$ref": "#/definitions/sha256" },
    "payloadSetSha256": { "$ref": "#/definitions/sha256" },
    "r3SignedClientSetSha256": { "$ref": "#/definitions/sha256" },
    "releaseManifestTrustSha256": { "$ref": "#/definitions/sha256" },
    "releaseManifestTrustProbeSetSha256": {
      "$ref": "#/definitions/sha256"
    },
    "toolchainLockSha256": { "$ref": "#/definitions/sha256" },
    "targetBuildIdentitySha256": { "$ref": "#/definitions/sha256" },
    "unsignedInstaller": { "$ref": "#/definitions/unsignedInstaller" },
    "signedInstaller": { "$ref": "#/definitions/signedInstaller" },
    "authenticode": { "$ref": "#/definitions/authenticode" },
    "payloadSelfCheck": { "$ref": "#/definitions/payloadSelfCheck" },
    "authentication": { "$ref": "#/definitions/authentication" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "edition": { "const": "Personal" } },
        "required": ["edition"]
      },
      "then": {
        "properties": {
          "unsignedInstaller": {
            "allOf": [
              { "$ref": "#/definitions/unsignedInstaller" },
              {
                "properties": {
                  "fileName": { "const": "Ensou.Dsh.Personal.Installer.exe" },
                  "relativePath": {
                    "const": "unsigned/Ensou.Dsh.Personal.Installer.exe"
                  }
                }
              }
            ]
          },
          "signedInstaller": {
            "allOf": [
              { "$ref": "#/definitions/signedInstaller" },
              {
                "properties": {
                  "fileName": { "const": "Ensou.Dsh.Personal.Installer.exe" },
                  "relativePath": {
                    "const": "signed/Ensou.Dsh.Personal.Installer.exe"
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "channel": { "const": "stable" },
          "unsignedInstaller": {
            "allOf": [
              { "$ref": "#/definitions/unsignedInstaller" },
              {
                "properties": {
                  "fileName": {
                    "const": "Ensou.Dsh.Enterprise.Installer.exe"
                  },
                  "relativePath": {
                    "const": "unsigned/Ensou.Dsh.Enterprise.Installer.exe"
                  }
                }
              }
            ]
          },
          "signedInstaller": {
            "allOf": [
              { "$ref": "#/definitions/signedInstaller" },
              {
                "properties": {
                  "fileName": {
                    "const": "Ensou.Dsh.Enterprise.Installer.exe"
                  },
                  "relativePath": {
                    "const": "signed/Ensou.Dsh.Enterprise.Installer.exe"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "orchestrationId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "releaseSetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "fileSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "installerFileSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "unsignedInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "fileName",
        "relativePath",
        "sizeBytes",
        "sha256",
        "peContentSha256"
      ],
      "properties": {
        "role": { "const": "installer" },
        "fileName": { "$ref": "#/definitions/fileName" },
        "relativePath": {
          "type": "string",
          "pattern": "^unsigned/Ensou[.]Dsh[.](?:Personal|Enterprise)[.]Installer[.]exe$"
        },
        "sizeBytes": { "$ref": "#/definitions/installerFileSize" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "peContentSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "signedInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "fileName",
        "relativePath",
        "sizeBytes",
        "sha256",
        "peContentSha256",
        "fullHashChangedFromUnsigned"
      ],
      "properties": {
        "role": { "const": "installer" },
        "fileName": { "$ref": "#/definitions/fileName" },
        "relativePath": {
          "type": "string",
          "pattern": "^signed/Ensou[.]Dsh[.](?:Personal|Enterprise)[.]Installer[.]exe$"
        },
        "sizeBytes": { "$ref": "#/definitions/installerFileSize" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "peContentSha256": { "$ref": "#/definitions/sha256" },
        "fullHashChangedFromUnsigned": { "const": true }
      }
    },
    "authenticode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "signatureType",
        "primarySignerCount",
        "signerCertificateSha256",
        "signerDigestAlgorithmOid",
        "spcIndirectDataContentTypeOid",
        "spcPeImageDataTypeOid",
        "spcDigestAlgorithmOid",
        "spcPeContentSha256",
        "timestampProtocol",
        "timestampTokenOid",
        "timestampContentTypeOid",
        "timestampSignerCertificateSha256",
        "timestampUtc",
        "rfc3161PrimarySignerBound"
      ],
      "properties": {
        "status": { "const": "Valid" },
        "signatureType": { "const": "Authenticode" },
        "primarySignerCount": { "const": 1 },
        "signerCertificateSha256": { "$ref": "#/definitions/sha256" },
        "signerDigestAlgorithmOid": {
          "const": "2.16.840.1.101.3.4.2.1"
        },
        "spcIndirectDataContentTypeOid": {
          "const": "1.3.6.1.4.1.311.2.1.4"
        },
        "spcPeImageDataTypeOid": {
          "const": "1.3.6.1.4.1.311.2.1.15"
        },
        "spcDigestAlgorithmOid": {
          "const": "2.16.840.1.101.3.4.2.1"
        },
        "spcPeContentSha256": { "$ref": "#/definitions/sha256" },
        "timestampProtocol": { "const": "RFC3161" },
        "timestampTokenOid": {
          "enum": [
            "1.2.840.113549.1.9.16.2.14",
            "1.3.6.1.4.1.311.3.3.1"
          ]
        },
        "timestampContentTypeOid": {
          "const": "1.2.840.113549.1.9.16.1.4"
        },
        "timestampSignerCertificateSha256": {
          "$ref": "#/definitions/sha256"
        },
        "timestampUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "rfc3161PrimarySignerBound": { "const": true }
      }
    },
    "payloadSelfCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "status",
        "exitCode",
        "inspectedInstallerSha256",
        "resultSha256",
        "candidateSetSha256",
        "payloadSetSha256",
        "r3SignedClientSetSha256",
        "releaseManifestTrustSha256",
        "releaseManifestTrustProbeSetSha256",
        "completedAtUtc"
      ],
      "properties": {
        "command": { "const": "--production-payload-self-check" },
        "status": { "const": "VERIFIED" },
        "exitCode": { "const": 0 },
        "inspectedInstallerSha256": { "$ref": "#/definitions/sha256" },
        "resultSha256": { "$ref": "#/definitions/sha256" },
        "candidateSetSha256": { "$ref": "#/definitions/sha256" },
        "payloadSetSha256": { "$ref": "#/definitions/sha256" },
        "r3SignedClientSetSha256": { "$ref": "#/definitions/sha256" },
        "releaseManifestTrustSha256": { "$ref": "#/definitions/sha256" },
        "releaseManifestTrustProbeSetSha256": {
          "$ref": "#/definitions/sha256"
        },
        "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "payloadType", "value"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/token" },
        "purpose": { "const": "installer-signing-response" },
        "payloadType": {
          "const": "ensou-dsh-launcher-installer-signing-response-authentication-v1"
        },
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}

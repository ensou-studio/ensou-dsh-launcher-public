<Application x:Class="Ensou.Dsh.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#0B0E12" />
    <SolidColorBrush x:Key="PanelBrush" Color="#12171D" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#182028" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#93A1AD" />
    <SolidColorBrush x:Key="AccentBrush" Color="#25D695" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#123F32" />

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#08110E" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="22,12" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#26313B" />
    </Style>
  </Application.Resources>
</Application>

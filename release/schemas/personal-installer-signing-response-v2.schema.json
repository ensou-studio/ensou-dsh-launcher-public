{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Personal Installer signing response v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "responseType", "orchestrationId", "edition",
    "releaseSetId", "channel", "planSha256", "requestRelativePath",
    "requestSha256", "requestNonce", "baseHeadSha256",
    "admissionHeadSha256", "admissionRevision", "r6ReceiptRelativePath",
    "r6ReceiptSha256", "requestCreatedAtUtc", "requestExpiresAtUtc",
    "completedAtUtc", "requestBindings", "unsignedInstaller",
    "signedInstaller", "authenticode", "payloadSelfCheck", "authentication"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "responseType": { "const": "ensou-dsh-personal-installer-signing-response" },
    "orchestrationId": { "$ref": "#/definitions/uuid" },
    "edition": { "const": "Personal" },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "channel": { "const": "pilot" },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "requestRelativePath": { "const": "requests/installer-signing.v2/installer-signing-request.v2.json" },
    "requestSha256": { "$ref": "#/definitions/sha256" },
    "requestNonce": { "$ref": "#/definitions/nonce" },
    "baseHeadSha256": { "$ref": "#/definitions/sha256" },
    "admissionHeadSha256": { "$ref": "#/definitions/sha256" },
    "admissionRevision": { "const": 6 },
    "r6ReceiptRelativePath": { "const": "receipts/0006-installer-signing-requested.json" },
    "r6ReceiptSha256": { "$ref": "#/definitions/sha256" },
    "requestCreatedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "requestExpiresAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "requestBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceSha256", "payloadSha256", "compiledTrustSha256",
        "toolchainSha256", "buildExecutionSha256", "resourceBindingSha256",
        "trustedBuildEvidenceSha256", "admissionSha256"
      ],
      "properties": {
        "sourceSha256": { "$ref": "#/definitions/sha256" },
        "payloadSha256": { "$ref": "#/definitions/sha256" },
        "compiledTrustSha256": { "$ref": "#/definitions/sha256" },
        "toolchainSha256": { "$ref": "#/definitions/sha256" },
        "buildExecutionSha256": { "$ref": "#/definitions/sha256" },
        "resourceBindingSha256": { "$ref": "#/definitions/sha256" },
        "trustedBuildEvidenceSha256": { "$ref": "#/definitions/sha256" },
        "admissionSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "unsignedInstaller": { "$ref": "personal-installer-trusted-build-evidence-v1.schema.json#/definitions/unsignedInstaller" },
    "signedInstaller": { "$ref": "#/definitions/signedInstaller" },
    "authenticode": { "$ref": "launcher-installer-signing-response-v1.schema.json#/definitions/authenticode" },
    "payloadSelfCheck": { "$ref": "personal-installer-production-payload-self-check-evidence-v1.schema.json" },
    "authentication": { "$ref": "#/definitions/authentication" }
  },
  "definitions": {
    "sha256": {
      "type": "string", "minLength": 64, "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuid": {
      "type": "string", "minLength": 36, "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "nonce": {
      "type": "string", "minLength": 43, "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "wholeSecondUtc": {
      "type": "string", "minLength": 20, "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "signedInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "fileName", "relativePath", "sizeBytes", "sha256",
        "peContentSha256", "fullHashChangedFromUnsigned"
      ],
      "properties": {
        "role": { "const": "installer" },
        "fileName": { "const": "Ensou.Dsh.Personal.Installer.exe" },
        "relativePath": { "const": "signed/Ensou.Dsh.Personal.Installer.exe" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "peContentSha256": { "$ref": "#/definitions/sha256" },
        "fullHashChangedFromUnsigned": { "const": true }
      }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "payloadType", "value"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/token" },
        "purpose": { "const": "personal-installer-signing-response" },
        "payloadType": { "const": "ensou-dsh-personal-installer-signing-response-authentication-v2" },
        "value": {
          "type": "string", "minLength": 86, "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}

<Window x:Class="Ensou.Dsh.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ensou DSH Launcher"
        Width="1020"
        Height="660"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="228" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#0F1419" BorderBrush="#222B33" BorderThickness="0,0,1,0">
      <Grid Margin="26,28,24,24">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="34" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal">
          <Border Width="44" Height="44" CornerRadius="12" Background="#FFFFFF" Padding="7">
            <Image Source="/Ensou.Dsh.Launcher;component/Assets/dsh-official-whale.png"
                   Stretch="Uniform" SnapsToDevicePixels="True" />
          </Border>
          <StackPanel Margin="12,1,0,0">
            <TextBlock Text="ENSOU" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="Bold" />
            <TextBlock Text="DSH LAUNCHER" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Border Background="{StaticResource AccentDarkBrush}" CornerRadius="8" Padding="12,10">
            <TextBlock Text="启动中心" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" />
          </Border>
          <TextBlock Text="更新通道" Foreground="{StaticResource MutedTextBrush}" Margin="12,20,0,0" />
          <TextBlock Text="本机诊断" Foreground="{StaticResource MutedTextBrush}" Margin="12,20,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" VerticalAlignment="Bottom" Margin="0,20,0,24">
          <TextBlock Text="PERSONAL 内测" Foreground="{StaticResource MutedTextBrush}" FontSize="10" />
          <TextBlock x:Name="AccountStatusText" Text="使用前需要登录" Foreground="{StaticResource TextBrush}"
                     Margin="0,6,0,10" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
          <Button x:Name="AccountButton" Content="邮箱登录" Click="AccountButton_Click" Padding="12,9"
                  Style="{StaticResource SecondaryButton}" />
          <Button x:Name="SignOutButton" Content="退出登录" Click="SignOutButton_Click" Padding="12,9"
                  Margin="0,8,0,0" Style="{StaticResource SecondaryButton}" />
        </StackPanel>

        <StackPanel Grid.Row="4">
          <TextBlock Text="DEVELOPER" Foreground="#5D6B76" FontSize="10" />
          <TextBlock Text="ensou studio" Foreground="{StaticResource MutedTextBrush}" Margin="0,4,0,0" />
          <TextBlock Text="基于 DeepSeek Harness 构建" Foreground="#64727D" FontSize="10" Margin="0,7,0,0" />
          <TextBlock Text="第三方 Launcher · 非 DeepSeek 官方产品" Foreground="#56636D"
                     FontSize="9" Margin="0,4,0,0" TextWrapping="Wrap" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="42,30,42,30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="22" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <Grid>
        <StackPanel>
          <TextBlock Text="DeepSeek Harness" Foreground="{StaticResource TextBrush}"
                     FontSize="29" FontWeight="SemiBold" />
          <TextBlock Text="本机运行 · 统一更新 · 数据留在你的电脑"
                     Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="0,7,0,0" />
        </StackPanel>
        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                Background="#17231F" BorderBrush="#275F4A" BorderThickness="1"
                CornerRadius="12" Padding="13,7">
          <StackPanel Orientation="Horizontal">
            <Ellipse x:Name="HealthDot" Width="8" Height="8" Fill="#6C7881" Margin="0,0,8,0" />
            <TextBlock x:Name="HealthText" Text="未启动" Foreground="#B9C4CB" FontSize="12" />
          </StackPanel>
        </Border>
      </Grid>

      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="14"
              BorderBrush="#222C35" BorderThickness="1" Padding="24">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <StackPanel>
            <TextBlock Text="本机 DSH" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
            <TextBlock x:Name="InstalledVersionText" Text="检查中" Foreground="{StaticResource TextBrush}"
                       FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="可用版本" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
            <TextBlock x:Name="AvailableVersionText" Text="尚未检查" Foreground="{StaticResource TextBrush}"
                       FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
          </StackPanel>
          <StackPanel Grid.Column="2">
            <TextBlock Text="更新通道" Foreground="{StaticResource MutedTextBrush}" FontSize="11" />
            <TextBlock x:Name="ChannelText" Text="Stable" Foreground="{StaticResource AccentBrush}"
                       FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0" />
          </StackPanel>
        </Grid>
      </Border>

      <Border Grid.Row="4" Background="{StaticResource PanelRaisedBrush}" CornerRadius="14" Padding="24">
        <StackPanel>
          <TextBlock x:Name="StatusTitleText" Text="正在读取本机状态" Foreground="{StaticResource TextBrush}"
                     FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="StatusDetailText" Text="Launcher 启动后会自动检查更新。"
                     Foreground="{StaticResource MutedTextBrush}" FontSize="13"
                     Margin="0,8,0,0" TextWrapping="Wrap" />
          <ProgressBar x:Name="UpdateProgress" Height="5" Margin="0,20,0,0"
                       Minimum="0" Maximum="100" Value="0"
                       Foreground="{StaticResource AccentBrush}" Background="#2A343C" />
          <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button x:Name="PrimaryActionButton" Content="启动 DSH" Width="152" Click="PrimaryActionButton_Click" />
            <Button Content="打开 WebUI" Width="132" Margin="12,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="OpenWebUiButton_Click" />
            <Button Content="检查更新" Width="122" Margin="12,0,0,0"
                    Style="{StaticResource SecondaryButton}" Click="CheckUpdateButton_Click" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Grid.Row="6" BorderBrush="#202933" BorderThickness="0,1,0,0" Padding="0,16,0,0">
        <Grid>
          <TextBlock x:Name="LastActivityText" Text="准备就绪" Foreground="#768590" FontSize="11" />
          <TextBlock Text="关闭窗口后仍在任务栏托盘运行" Foreground="#596771" FontSize="11"
                     HorizontalAlignment="Right" />
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

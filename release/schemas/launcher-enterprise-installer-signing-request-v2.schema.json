{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Enterprise Installer signing request v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestType",
    "orchestrationId",
    "edition",
    "releaseSetId",
    "channel",
    "planSha256",
    "sourceCommit",
    "sourceTree",
    "sourceBuildInputSetSha256",
    "sourceBuildInputs",
    "baseHeadSha256",
    "baseRevision",
    "basePhase",
    "requestedRevision",
    "requestNonce",
    "createdAtUtc",
    "expiresAtUtc",
    "r5Evidence",
    "candidate",
    "r3Evidence",
    "installerPayload",
    "toolchainLock",
    "toolchainLockSha256",
    "buildExecution",
    "unsignedInstaller",
    "resourceBinding",
    "trustedBuildEvidence",
    "responseAuthentication"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "requestType": {
      "const": "ensou-dsh-launcher-installer-signing-request"
    },
    "orchestrationId": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/orchestrationId"
    },
    "edition": { "const": "Enterprise" },
    "releaseSetId": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/releaseSetId"
    },
    "channel": { "const": "stable" },
    "planSha256": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sha256"
    },
    "sourceCommit": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sourceCommit"
    },
    "sourceTree": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sourceCommit"
    },
    "sourceBuildInputSetSha256": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sha256"
    },
    "sourceBuildInputs": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sourceBuildInputs"
    },
    "baseHeadSha256": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sha256"
    },
    "baseRevision": { "const": 5 },
    "basePhase": { "const": "STABLE_SIGNED_CANDIDATE_IMPORTED" },
    "requestedRevision": { "const": 6 },
    "requestNonce": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/nonce"
    },
    "createdAtUtc": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/wholeSecondUtc"
    },
    "expiresAtUtc": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/wholeSecondUtc"
    },
    "r5Evidence": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/r5Evidence"
    },
    "candidate": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/enterpriseCandidate"
    },
    "r3Evidence": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/enterpriseR3Evidence"
    },
    "installerPayload": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/enterpriseInstallerPayload"
    },
    "toolchainLock": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/toolchainLock"
    },
    "toolchainLockSha256": {
      "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sha256"
    },
    "buildExecution": {
      "$ref": "#/definitions/buildExecution"
    },
    "unsignedInstaller": {
      "allOf": [
        {
          "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/unsignedInstaller"
        },
        {
          "properties": {
            "fileName": {
              "const": "Ensou.Dsh.Enterprise.Installer.exe"
            },
            "relativePath": {
              "const": "unsigned/Ensou.Dsh.Enterprise.Installer.exe"
            }
          }
        }
      ]
    },
    "resourceBinding": { "$ref": "#/definitions/resourceBinding" },
    "trustedBuildEvidence": {
      "$ref": "#/definitions/trustedBuildEvidence"
    },
    "responseAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "purpose",
        "payloadType",
        "trustSha256",
        "maximumResponseAgeMinutes"
      ],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": {
          "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/token"
        },
        "purpose": { "const": "installer-signing-response" },
        "payloadType": {
          "const": "ensou-dsh-launcher-installer-signing-response-authentication-v1"
        },
        "trustSha256": {
          "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/sha256"
        },
        "maximumResponseAgeMinutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1440
        }
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "buildExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId",
        "targetBuildIdentitySha256",
        "reservationSha256",
        "buildOrdinal",
        "buildCountForTarget",
        "outputCreationMode",
        "rebuildPolicy",
        "startedAtUtc",
        "completedAtUtc",
        "exitCode"
      ],
      "properties": {
        "buildId": {
          "$ref": "launcher-installer-signing-request-v1.schema.json#/definitions/orchestrationId"
        },
        "targetBuildIdentitySha256": { "$ref": "#/definitions/sha256" },
        "reservationSha256": { "$ref": "#/definitions/sha256" },
        "buildOrdinal": { "const": 1 },
        "buildCountForTarget": { "const": 1 },
        "outputCreationMode": { "const": "create-new" },
        "rebuildPolicy": {
          "const": "rebuild-forbidden-exact-reserved-unsigned-bytes-replay-only"
        },
        "startedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "exitCode": { "const": 0 }
      }
    },
    "managedAssembly": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": { "const": "Ensou.Dsh.Enterprise.Installer.dll" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 256,
          "maximum": 1073741824
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role", "embeddedLogicalName", "sizeBytes", "sha256", "status"
      ],
      "properties": {
        "role": {
          "enum": ["install-manifest", "launcher", "runtime", "bootstrapper"]
        },
        "embeddedLogicalName": {
          "type": "string",
          "pattern": "^Ensou[.]Dsh[.]Enterprise[.]Installer[.]Payload[.][A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "status": { "const": "VERIFIED" }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationType",
        "verificationMethod",
        "status",
        "managedAssembly",
        "resourceSetSha256",
        "resources",
        "unsignedInstallerSha256"
      ],
      "properties": {
        "verificationType": {
          "const": "managed-assembly-resource-to-single-file-build-input-v1"
        },
        "verificationMethod": {
          "const": "collectible-load-context-manifest-resource-inspection-no-entrypoint"
        },
        "status": { "const": "VERIFIED" },
        "managedAssembly": { "$ref": "#/definitions/managedAssembly" },
        "resourceSetSha256": { "$ref": "#/definitions/sha256" },
        "resources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "additionalItems": false,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/resource" },
                {
                  "properties": {
                    "role": { "const": "install-manifest" },
                    "embeddedLogicalName": {
                      "const": "Ensou.Dsh.Enterprise.Installer.Payload.enterprise-install-manifest.json"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/resource" },
                {
                  "properties": {
                    "role": { "const": "launcher" },
                    "embeddedLogicalName": {
                      "const": "Ensou.Dsh.Enterprise.Installer.Payload.launcher.zip"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/resource" },
                {
                  "properties": {
                    "role": { "const": "runtime" },
                    "embeddedLogicalName": {
                      "const": "Ensou.Dsh.Enterprise.Installer.Payload.runtime.zip"
                    }
                  }
                }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/resource" },
                {
                  "properties": {
                    "role": { "const": "bootstrapper" },
                    "embeddedLogicalName": {
                      "const": "Ensou.Dsh.Enterprise.Installer.Payload.Ensou.Dsh.Enterprise.Bootstrapper.exe"
                    }
                  }
                }
              ]
            }
          ]
        },
        "unsignedInstallerSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "trustedBuildEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "fileName",
        "relativePath",
        "schemaVersion",
        "evidenceType",
        "sizeBytes",
        "sha256",
        "resourceBindingSha256",
        "sdkFileClosureStatus",
        "productionAdmission"
      ],
      "properties": {
        "role": { "const": "trusted-build-evidence" },
        "fileName": { "const": "trusted-build-evidence.v1.json" },
        "relativePath": {
          "const": "trusted-build/trusted-build-evidence.v1.json"
        },
        "schemaVersion": { "const": 1 },
        "evidenceType": {
          "const": "ensou-dsh-enterprise-installer-trusted-build"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "sha256": { "$ref": "#/definitions/sha256" },
        "resourceBindingSha256": { "$ref": "#/definitions/sha256" },
        "sdkFileClosureStatus": {
          "const": "VERIFIED"
        },
        "productionAdmission": { "const": "NO_GO" }
      }
    }
  }
}

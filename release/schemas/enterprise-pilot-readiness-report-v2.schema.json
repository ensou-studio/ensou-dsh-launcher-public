{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ensou.example/enterprise-pilot-readiness-report-v2.schema.json",
  "title": "Ensou DSH Enterprise Pilot readiness report v2 direct-local",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reportType",
    "decision",
    "generatedAtUtc",
    "environment",
    "channel",
    "publisherExecutableSha256",
    "releaseSetId",
    "generation",
    "sequence",
    "updateContractId",
    "brandAuthorizationId",
    "brandAuthorizationKeyId",
    "brandAuthorizationReceiptSha256",
    "brandAuthorizationExpiresAtUtc",
    "localDataCertificationId",
    "localDataCertificationKeyId",
    "localDataCertificationReceiptSha256",
    "localDataCertificationExpiresAtUtc",
    "checks",
    "failureCode",
    "failureMessage",
    "productionTrustContractId",
    "runtimeProfile",
    "apiProvider"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "reportType": {
      "const": "ensou-dsh-enterprise-pilot-readiness"
    },
    "decision": {
      "enum": [
        "ADMIT",
        "REJECT"
      ]
    },
    "generatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "environment": {
      "const": "production"
    },
    "channel": {
      "const": "pilot"
    },
    "publisherExecutableSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseSetId": {
      "type": [
        "string",
        "null"
      ]
    },
    "generation": {
      "type": [
        "integer",
        "null"
      ]
    },
    "sequence": {
      "type": [
        "integer",
        "null"
      ]
    },
    "updateContractId": {
      "const": "release-set-v2-startup-check-atomic-health-rollback-offline-7d-plugin-policy-v1"
    },
    "brandAuthorizationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "brandAuthorizationKeyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "brandAuthorizationReceiptSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "brandAuthorizationExpiresAtUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "localDataCertificationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "localDataCertificationKeyId": {
      "type": [
        "string",
        "null"
      ]
    },
    "localDataCertificationReceiptSha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "localDataCertificationExpiresAtUtc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9-]+$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    },
    "failureCode": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z0-9-]{1,128}$"
    },
    "failureMessage": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "maxLength": 512
    },
    "productionTrustContractId": {
      "const": "ensou-dsh-enterprise-production-trust-v2"
    },
    "runtimeProfile": {
      "const": "enterprise-direct-local"
    },
    "apiProvider": {
      "const": "deepseek"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "decision": {
            "const": "ADMIT"
          }
        }
      },
      "then": {
        "properties": {
          "releaseSetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sequence": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "failureCode": {
            "type": "null"
          },
          "failureMessage": {
            "type": "null"
          },
          "brandAuthorizationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "brandAuthorizationKeyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "brandAuthorizationReceiptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "brandAuthorizationExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "localDataCertificationId": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "localDataCertificationKeyId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
          },
          "localDataCertificationReceiptSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "localDataCertificationExpiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "checks": {
            "items": {
              "properties": {
                "status": {
                  "const": "PASS"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "releaseSetId": {
            "type": "null"
          },
          "generation": {
            "type": "null"
          },
          "sequence": {
            "type": "null"
          },
          "failureCode": {
            "type": "string"
          },
          "failureMessage": {
            "type": "string"
          },
          "brandAuthorizationId": {
            "type": "null"
          },
          "brandAuthorizationKeyId": {
            "type": "null"
          },
          "brandAuthorizationReceiptSha256": {
            "type": "null"
          },
          "brandAuthorizationExpiresAtUtc": {
            "type": "null"
          },
          "localDataCertificationId": {
            "type": "null"
          },
          "localDataCertificationKeyId": {
            "type": "null"
          },
          "localDataCertificationReceiptSha256": {
            "type": "null"
          },
          "localDataCertificationExpiresAtUtc": {
            "type": "null"
          },
          "checks": {
            "contains": {
              "type": "object",
              "properties": {
                "status": {
                  "const": "FAIL"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    }
  ]
}

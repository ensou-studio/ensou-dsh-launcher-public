+    /* v8 ignore next -- isRuntimePackagePath has already validated this exact name */
+    if (nameParts === undefined) throw new Error('dsh-app-boot: runtime closure package name was not validated')
+    const directPath = posix.join('node_modules', ...nameParts)
+    if (item.path !== directPath) continue
+    const packageDir = join(runtimeRoot, ...item.path.split('/'))
+    assertPhysicalRuntimeDirectory(runtimeRoot, packageDir)
+    const manifestPath = join(packageDir, 'package.json')
+    const manifest = readPhysicalPackageManifest(runtimeRoot, manifestPath)
+    if (manifest.name !== item.name || manifest.version !== item.version) {
+      throw new Error(
+        `dsh-app-boot: runtime closure package ${JSON.stringify(item.path)} does not match its physical manifest`,
+      )

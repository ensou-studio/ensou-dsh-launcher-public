+  const visit = (dir: string): void => {
+    const manifestPath = join(dir, 'package.json')
+    if (existsSync(manifestPath)) {
+      const manifest = readPhysicalPackageManifest(installationRoot, manifestPath)
+      if (typeof manifest.name === 'string') {
+        const previous = packages.get(manifest.name)
+        if (previous !== undefined) {
+          throw new Error(
+            `dsh-app-boot: source installation repeats package ${JSON.stringify(manifest.name)} at ${previous} and ${manifestPath}`,
+          )
+        }
+        packages.set(manifest.name, manifestPath)
+      }
+      return
+    }
+    const entries = readdirSync(dir, { withFileTypes: true })
+      .sort((left, right) => left.name < right.name ? -1 : left.name > right.name ? 1 : 0)
+    for (const entry of entries) {
+      if (entry.name === 'node_modules' || entry.name.startsWith('.')) continue
+      const path = join(dir, entry.name)
+      if (entry.isSymbolicLink()) {
+        throw new Error(`dsh-app-boot: source package index contains a reparse point: ${path}`)
+      }
+      if (entry.isDirectory()) visit(path)

<Application x:Class="Ensou.Dsh.Enterprise.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#0B0E12" />
    <SolidColorBrush x:Key="PanelBrush" Color="#12171D" />
    <SolidColorBrush x:Key="PanelRaisedBrush" Color="#182028" />
    <SolidColorBrush x:Key="TextBrush" Color="#F4F7F8" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="#93A1AD" />
    <SolidColorBrush x:Key="AccentBrush" Color="#25D695" />
    <SolidColorBrush x:Key="AccentDarkBrush" Color="#123F32" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F4B860" />

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#08110E" />
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="20,11" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}"
                    Opacity="{TemplateBinding Opacity}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.38" />
          <Setter Property="Cursor" Value="Arrow" />
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#26313B" />
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="Background" Value="#0F151B" />
      <Setter Property="BorderBrush" Value="#34424D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="FontSize" Value="14" />
    </Style>
  </Application.Resources>
</Application>

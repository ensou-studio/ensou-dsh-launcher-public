+++ b/packages/settings/settings-file/src/composition-only.ts
@@ -0,0 +1,23 @@
+/** Read-only settings descriptors without a user document or filesystem effects. */
+
+import { SettingsProvider } from '@deepseek-ai/dsh-settings'
+
+/**
+ * Resolve registered schemas and composition bases only. Credential providers
+ * remain independent; a writable credential does not make settings writable.
+ */
+export class CompositionOnlySettingsProvider extends SettingsProvider {
+  get writable(): boolean {
+    return false
+  }
+
+  protected load(): Promise<Record<string, unknown>> {
+    return Promise.resolve({})
+  }
+
+  protected persist(): Promise<void> {
+    return Promise.reject(new Error('composition-only settings cannot be persisted'))
+  }
+}
+
+export default CompositionOnlySettingsProvider

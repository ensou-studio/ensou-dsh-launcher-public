{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.ensou.example/schemas/certified-distribution-receipt-v1.schema.json",
  "title": "Ensou DSH certified distribution receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "channel",
    "releaseSetId",
    "manifestSha256",
    "installer",
    "feed",
    "certification",
    "approvedAtUtc",
    "distributionAuthorized"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "product": {
      "enum": ["ensou-dsh-personal", "ensou-dsh-enterprise"]
    },
    "channel": { "const": "stable" },
    "releaseSetId": {
      "type": "string",
      "pattern": "^managed-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "installer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fileName",
        "sizeBytes",
        "sha256",
        "authenticodeStatus",
        "signerSha256Thumbprint",
        "timestamped"
      ],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.exe$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "authenticodeStatus": { "const": "Valid" },
        "signerSha256Thumbprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "timestamped": { "const": true }
      }
    },
    "feed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestUri",
        "externalManifestSha256",
        "verifiedArtifactCount",
        "allArtifactSignaturesValid",
        "allArtifactHashesValid",
        "immutablePublication",
        "atomicChannelHead",
        "verifiedAtUtc"
      ],
      "properties": {
        "manifestUri": {
          "type": "string",
          "pattern": "^https://[^?#\\s]+/v2/channels/pilot/release-set[.]v2[.]json$",
          "description": "Exact externally verified Pilot head; Stable later promotes these same bytes."
        },
        "externalManifestSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "verifiedArtifactCount": { "type": "integer", "minimum": 2 },
        "allArtifactSignaturesValid": { "const": true },
        "allArtifactHashesValid": { "const": true },
        "immutablePublication": { "const": true },
        "atomicChannelHead": { "const": true },
        "verifiedAtUtc": { "type": "string", "format": "date-time" }
      }
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cleanInstallPassed",
        "oldInstallUpgradePassed",
        "actualRuntimeStarted",
        "webUiOpened",
        "wholeHomeRestorePassed",
        "interruptionMatrixPassed",
        "weakNetworkResumePassed",
        "offlineAndReplayMatrixPassed",
        "sameBytesAsPilot",
        "pilotSoakPassed",
        "cleanDeviceEvidenceSha256",
        "upgradeDeviceEvidenceSha256",
        "failureMatrixEvidenceSha256"
      ],
      "properties": {
        "cleanInstallPassed": { "const": true },
        "oldInstallUpgradePassed": { "const": true },
        "actualRuntimeStarted": { "const": true },
        "webUiOpened": { "const": true },
        "enterprisePluginLoaded": { "type": ["boolean", "null"] },
        "wholeHomeRestorePassed": { "const": true },
        "interruptionMatrixPassed": { "const": true },
        "weakNetworkResumePassed": { "const": true },
        "offlineAndReplayMatrixPassed": { "const": true },
        "sameBytesAsPilot": { "const": true },
        "pilotSoakPassed": { "const": true },
        "cleanDeviceEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "upgradeDeviceEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "failureMatrixEvidenceSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "approvedAtUtc": { "type": "string", "format": "date-time" },
    "distributionAuthorized": { "const": true }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>Ensou.Dsh.Bootstrapper</RootNamespace>
    <AssemblyName>Ensou.Dsh.Bootstrapper</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\branding\dsh-official-whale.ico</ApplicationIcon>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PersonalProductionBuild Condition="'$(PersonalProductionBuild)' == ''">false</PersonalProductionBuild>
    <PersonalDevelopmentPublish Condition="'$(PersonalDevelopmentPublish)' == ''">false</PersonalDevelopmentPublish>
    <PersonalDevelopmentE2E Condition="'$(PersonalDevelopmentE2E)' == ''">false</PersonalDevelopmentE2E>
    <PersonalChannel Condition="'$(PersonalChannel)' == '' and '$(PersonalProductionBuild)' != 'true' and '$(PersonalDevelopmentPublish)' != 'true'">stable</PersonalChannel>
    <PersonalCanonicalLowSFromSequence Condition="'$(PersonalCanonicalLowSFromSequence)' == '' and '$(PersonalProductionBuild)' != 'true' and '$(PersonalDevelopmentPublish)' != 'true'">1</PersonalCanonicalLowSFromSequence>
    <PersonalStartupStubVersion Condition="'$(PersonalStartupStubVersion)' == '' and '$(PersonalProductionBuild)' != 'true' and '$(PersonalDevelopmentPublish)' != 'true'">1.1.0</PersonalStartupStubVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Ensou.Dsh.Contracts\Ensou.Dsh.Contracts.csproj"
      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
    <ProjectReference Include="..\Ensou.Dsh.UpdateEngine\Ensou.Dsh.UpdateEngine.csproj"
      GlobalPropertiesToRemove="RuntimeIdentifier;SelfContained;PublishSingleFile" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="PersonalProductionBuild" Value="$(PersonalProductionBuild)" />
    <AssemblyMetadata Include="PersonalDevelopmentE2E" Value="$(PersonalDevelopmentE2E)" />
    <AssemblyMetadata Include="PersonalManifestOrigin" Value="$(PersonalManifestOrigin)" />
    <AssemblyMetadata Include="PersonalArtifactOrigin" Value="$(PersonalArtifactOrigin)" />
    <AssemblyMetadata Include="PersonalChannel" Value="$(PersonalChannel)" />
    <AssemblyMetadata Include="PersonalReleaseKeyId" Value="$(PersonalReleaseKeyId)" />
    <AssemblyMetadata Include="PersonalReleaseKeyX" Value="$(PersonalReleaseKeyX)" />
    <AssemblyMetadata Include="PersonalReleaseKeyY" Value="$(PersonalReleaseKeyY)" />
    <AssemblyMetadata Include="PersonalStartupStubVersion" Value="$(PersonalStartupStubVersion)" />
    <AssemblyMetadata Include="PersonalCanonicalLowSFromSequence" Value="$(PersonalCanonicalLowSFromSequence)" />
    <AssemblyMetadata Include="PersonalAuthenticodeSignerSha256Thumbprint" Value="$(PersonalAuthenticodeSignerSha256Thumbprint)" />
  </ItemGroup>
  <Target Name="ValidatePersonalStartupStubPublish" BeforeTargets="PrepareForPublish">
    <Error Condition="'$(RuntimeIdentifier)' != 'win-x64' or '$(SelfContained)' != 'true' or '$(PublishSingleFile)' != 'true' or '$(EnableCompressionInSingleFile)' != 'true'"
      Text="Personal Startup Stub production root must be compressed single-file, self-contained win-x64." />
    <Error Condition="'$(PublishTrimmed)' == 'true'"
      Text="Personal Startup Stub publish must not enable trimming." />
    <Error Condition="'$(PublishAot)' == 'true'"
      Text="Personal Startup Stub publish must not enable NativeAOT." />
    <Error Condition="'$(PersonalDevelopmentE2E)' == 'true' and ('$(PersonalDevelopmentPublish)' != 'true' or '$(PersonalProductionBuild)' == 'true')"
      Text="Personal development E2E layout is limited to an explicit development publish." />
    <Error Condition="('$(PersonalProductionBuild)' != 'true' and '$(PersonalDevelopmentPublish)' != 'true') or ('$(PersonalProductionBuild)' == 'true' and '$(PersonalDevelopmentPublish)' == 'true')"
      Text="Personal Startup Stub publish must select exactly one of production or development mode." />
    <Error Condition="'$(PersonalManifestOrigin)' == '' or '$(PersonalArtifactOrigin)' == '' or '$(PersonalChannel)' == '' or '$(PersonalReleaseKeyId)' == '' or '$(PersonalReleaseKeyX)' == '' or '$(PersonalReleaseKeyY)' == '' or '$(PersonalStartupStubVersion)' == '' or '$(PersonalCanonicalLowSFromSequence)' == ''"
      Text="Personal Startup Stub publish requires the complete immutable compiled release trust fingerprint." />
    <Error Condition="'$(PersonalProductionBuild)' == 'true' and '$(PersonalAuthenticodeSignerSha256Thumbprint)' == ''"
      Text="Production Personal Startup Stub requires the pinned Authenticode signer." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(PersonalCanonicalLowSFromSequence)', '^[1-9][0-9]{0,15}$'))"
      Text="Personal canonical low-S cutover must be one canonical positive decimal integer." />
    <Error Condition="$([System.Int64]::Parse('$(PersonalCanonicalLowSFromSequence)')) &gt; 9007199254740991"
      Text="Personal canonical low-S cutover must not exceed the maximum safe integer." />
  </Target>
  <Target Name="RejectLoosePersonalStartupStubAssemblies" AfterTargets="Publish">
    <ItemGroup>
      <_PersonalLooseManaged Include="$(PublishDir)Ensou.Dsh.*.dll" />
    </ItemGroup>
    <Error Condition="'@(_PersonalLooseManaged)' != ''"
      Text="Personal Startup Stub publish contains replaceable Ensou managed DLLs: @(_PersonalLooseManaged)" />
  </Target>
</Project>

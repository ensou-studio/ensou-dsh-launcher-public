{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher target-channel manifest publishing request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "requestType",
    "orchestrationId",
    "edition",
    "releaseSetId",
    "channel",
    "planSha256",
    "baseHeadSha256",
    "requestedRevision",
    "requestNonce",
    "createdAtUtc",
    "expiresAtUtc",
    "publisherInput",
    "releaseManifestTrust",
    "releaseCompatibility",
    "componentReleaseIds",
    "runtimeProvenance",
    "responseAuthentication"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "requestType": { "const": "ensou-dsh-launcher-manifest-publishing-request" },
    "orchestrationId": { "$ref": "#/definitions/orchestrationId" },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "channel": { "enum": ["pilot", "stable"] },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "baseHeadSha256": { "$ref": "#/definitions/sha256" },
    "requestedRevision": { "const": 4 },
    "requestNonce": { "$ref": "#/definitions/nonce" },
    "createdAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "expiresAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "publisherInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["descriptorRelativePath", "descriptorSha256", "files"],
      "properties": {
        "descriptorRelativePath": { "const": "publisher-input.v1.json" },
        "descriptorSha256": { "$ref": "#/definitions/sha256" },
        "files": {
          "type": "array",
          "minItems": 7,
          "maxItems": 64,
          "items": { "$ref": "#/definitions/file" }
        }
      }
    },
    "releaseManifestTrust": { "$ref": "#/definitions/releaseManifestTrust" },
    "releaseCompatibility": { "type": "object" },
    "componentReleaseIds": { "type": "object" },
    "runtimeProvenance": { "$ref": "#/definitions/runtimeProvenance" },
    "runtimeSourceReleaseExpectation": { "$ref": "#/definitions/runtimeSourceReleaseExpectation" },
    "responseAuthentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "payloadType"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/token" },
        "purpose": { "const": "manifest-publishing-response" },
        "payloadType": {
          "const": "ensou-dsh-launcher-manifest-publishing-response-authentication-v1"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["runtimeSourceReleaseExpectation"] },
      "then": {
        "properties": {
          "edition": { "const": "Enterprise" },
          "channel": { "const": "stable" }
        }
      }
    },
    {
      "if": {
        "properties": { "edition": { "const": "Personal" } },
        "required": ["edition"]
      },
      "then": {
        "properties": {
          "releaseCompatibility": { "$ref": "#/definitions/personalReleaseCompatibility" },
          "componentReleaseIds": { "$ref": "#/definitions/personalComponentReleaseIds" }
        }
      },
      "else": {
        "properties": {
          "channel": { "const": "stable" },
          "releaseCompatibility": { "$ref": "#/definitions/enterpriseReleaseCompatibility" },
          "componentReleaseIds": { "$ref": "#/definitions/enterpriseComponentReleaseIds" }
        }
      }
    }
  ],
  "definitions": {
    "githubRepository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?$"
    },
    "githubCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "managedRuntimeTag": {
      "type": "string",
      "minLength": 21,
      "maxLength": 128,
      "pattern": "^managed-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "runtimeSourceReleaseExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tagName", "targetCommit"],
      "properties": {
        "repository": { "$ref": "#/definitions/githubRepository" },
        "tagName": { "$ref": "#/definitions/managedRuntimeTag" },
        "targetCommit": { "$ref": "#/definitions/githubCommit" }
      }
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9_-]{43}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "orchestrationId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "p256Coordinate": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9_-]{43}$"
    },
    "releaseManifestTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "x", "y"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/token" },
        "purpose": { "const": "release-manifest-signing" },
        "x": { "$ref": "#/definitions/p256Coordinate" },
        "y": { "$ref": "#/definitions/p256Coordinate" }
      }
    },
    "personalReleaseCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startupStubVersion", "canonicalLowSFromSequence"],
      "properties": {
        "startupStubVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9]+(?:\\.[0-9]+){1,3}(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "canonicalLowSFromSequence": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "enterpriseReleaseCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startupStubProtocol"],
      "properties": {
        "startupStubProtocol": { "const": 1 }
      }
    },
    "personalComponentReleaseIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clientBundle", "runtime"],
      "properties": {
        "clientBundle": { "$ref": "#/definitions/releaseId" },
        "runtime": { "$ref": "#/definitions/releaseId" }
      }
    },
    "enterpriseComponentReleaseIds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["launcher", "runtime", "pluginPolicy"],
      "properties": {
        "launcher": { "$ref": "#/definitions/releaseId" },
        "runtime": { "$ref": "#/definitions/releaseId" },
        "pluginPolicy": { "$ref": "#/definitions/releaseId" }
      }
    },
    "releaseId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "runtimeProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnessSourceTag", "harnessSourceCommit"],
      "properties": {
        "harnessSourceTag": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "harnessSourceCommit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?![\\s\\S]*\\p{Cc})(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        }
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "relativePath", "sizeBytes", "sha256"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[a-z][a-z0-9-]*$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 9,
          "maxLength": 263,
          "pattern": "^(?![\\s\\S]*\\p{Cc})payload/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}

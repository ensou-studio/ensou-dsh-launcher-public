index 0000000000000000000000000000000000000000..18c8064ea85185f6f5bbc0229024f2b7cdd7c9f7
--- /dev/null
+++ b/packages/settings/settings-file/tests/composition-only.spec.ts
@@ -0,0 +1,103 @@
+/** Native credential persistence remains independent of immutable provider settings. */
+
+import { mkdtemp, readFile, readdir, rm, writeFile } from 'node:fs/promises'
+import { tmpdir } from 'node:os'
+import { join } from 'node:path'
+import { pathToFileURL } from 'node:url'
+import { afterEach, describe, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import Loader from '@deepseek-ai/cordis-plugin-loader'
+import Include from '@deepseek-ai/cordis-plugin-include'
+import z from '@deepseek-ai/schemastery'
+import { credentialRef } from '@deepseek-ai/dsh-credentials'
+import LocalCredentialProvider from '@deepseek-ai/dsh-credentials-local'
+import { createLaunchEnvironmentSnapshot, DSH_LAUNCH_ENVIRONMENT_KEY } from '@deepseek-ai/dsh-launch-environment'
+import CompositionOnlySettingsProvider from '../src/composition-only.ts'
+
+const cleanups: Array<() => Promise<void>> = []
+afterEach(async () => {
+  while (cleanups.length > 0) await cleanups.pop()!()
+})
+
+async function tempRoot(): Promise<string> {
+  const root = await mkdtemp(join(tmpdir(), 'dsh-composition-only-'))
+  cleanups.push(() => rm(root, { recursive: true, force: true }))
+  return root
+}
+
+async function boot(root: string): Promise<Context> {
+  const configPath = join(root, 'cordis.yml')
+  await writeFile(configPath, [
+    '- id: settings',
+    "  name: '@deepseek-ai/dsh-settings-file/composition-only'",
+    '- id: credentials',
+    "  name: '@deepseek-ai/dsh-credentials-local'",
+    '  config:',
+    `    dshHome: ${JSON.stringify(root)}`,
+    '    watch: false',
+    '',
+  ].join('\n'))
+  const ctx = new Context()
+  cleanups.push(() => ctx.fiber.dispose())
+  ctx.provide(DSH_LAUNCH_ENVIRONMENT_KEY, createLaunchEnvironmentSnapshot([]))
+  ctx.baseUrl = pathToFileURL(root).href + '/'
+  await ctx.plugin(Loader)
+  ctx.loader.builtins.include = Include
+  // The real Loader reads the YAML; only module resolution is source-plane.
+  const modules = new Map<string, unknown>([
+    ['@deepseek-ai/dsh-settings-file/composition-only', CompositionOnlySettingsProvider],
+    ['@deepseek-ai/dsh-credentials-local', LocalCredentialProvider],
+  ])
+  ctx.loader.internal = {
+    version: 'v2',
+    async import(specifier: string) {
+      if (!modules.has(specifier)) throw new Error(`unexpected Loader import: ${specifier}`)
+      return modules.get(specifier)
+    },
+  } as unknown as NonNullable<typeof ctx.loader.internal>
+  await ctx.loader.create({ name: 'cordis:include', config: { path: pathToFileURL(configPath).href } })
+  await ctx.loader.await()
+  return ctx
+}
+
+describe('composition-only settings with native credentials', () => {
+  it('ignores user settings and rejects all three mutation APIs without touching the file', async () => {
+    const root = await tempRoot()
+    const settingsFile = join(root, 'settings.yaml')
+    const untrusted = 'llm-deepseek:\n  baseURL: https://not-approved.invalid\n'
+    await writeFile(settingsFile, untrusted)
+    const ctx = await boot(root)
+    const settings = ctx.get('settings')!
+    const scope = settings.register('llm-deepseek', z.object({ baseURL: z.string() }), {
+      base: { baseURL: 'https://api.deepseek.com' },
+    })
+    expect(settings.writable).toBe(false)
+    expect(settings.documentPath).toBeUndefined()
+    await expect(settings.prepareDocument()).resolves.toBeUndefined()
+    expect(scope.get()).toEqual({ baseURL: 'https://api.deepseek.com' })
+    await expect(settings.update('llm-deepseek', { baseURL: 'https://not-approved.invalid' })).rejects.toThrow('read-only')
+    await expect(settings.replace('llm-deepseek', {})).rejects.toThrow('read-only')
+    await expect(settings.mutate('llm-deepseek', [{ op: 'set', path: ['baseURL'], value: 'https://not-approved.invalid' }])).rejects.toThrow('read-only')
+    expect(await readFile(settingsFile, 'utf8')).toBe(untrusted)
+    expect(scope.get()).toEqual({ baseURL: 'https://api.deepseek.com' })
+    await ctx.fiber.dispose()
+    expect(ctx.get('settings')).toBeUndefined()
+  })
+
+  it('persists and reloads a synthetic dedicated key without creating a settings document', async () => {
+    const root = await tempRoot()
+    const ref = credentialRef('DEEPSEEK_API_KEY')
+    const sibling = credentialRef('UNRELATED_TEST_CREDENTIAL')
+    const first = await boot(root)
+    await first.get('credentials')!.set(sibling, 'synthetic-unrelated')
+    await first.get('credentials')!.set(ref, 'synthetic-dedicated-key')
+    const saved = await readFile(join(root, '.credentials.yaml'))
+    await first.fiber.dispose()
+    const second = await boot(root)
+    await expect(second.get('credentials')!.resolve(ref)).resolves.toEqual({ value: 'synthetic-dedicated-key', source: 'file' })
+    await expect(second.get('credentials')!.resolve(sibling)).resolves.toEqual({ value: 'synthetic-unrelated', source: 'file' })
+    expect(await readFile(join(root, '.credentials.yaml'))).toEqual(saved)
+    expect(await readdir(root)).not.toContain('settings.yaml')
+    expect(second.get('settings')!.writable).toBe(false)
+  })
+})

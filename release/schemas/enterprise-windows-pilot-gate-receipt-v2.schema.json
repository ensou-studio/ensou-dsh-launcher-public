{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ensou.example/enterprise-windows-pilot-gate-receipt-v2.schema.json",
  "title": "Ensou DSH Enterprise Windows Pilot gate receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "receiptType",
    "sequenceNumber",
    "testRunId",
    "customerAudienceId",
    "gate",
    "status",
    "deviceLane",
    "startedAtUtc",
    "completedAtUtc",
    "observedProcess",
    "networkMode",
    "resultCode",
    "releaseTuple",
    "externalEvidence"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "receiptType": {
      "const": "ensou-dsh-enterprise-windows-pilot-gate-receipt"
    },
    "sequenceNumber": { "type": "integer", "minimum": 1, "maximum": 21 },
    "testRunId": { "$ref": "#/$defs/uuid" },
    "customerAudienceId": { "$ref": "#/$defs/uuid" },
    "gate": { "$ref": "#/$defs/gate" },
    "status": { "const": "PASS" },
    "deviceLane": { "enum": ["clean-install", "legacy-migration"] },
    "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "completedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "observedProcess": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "state", "executableSha256"],
      "properties": {
        "role": {
          "enum": [
            "installer",
            "bootstrapper",
            "launcher",
            "maintenance",
            "runtime",
            "previous-runtime",
            "pilot-observer"
          ]
        },
        "state": {
          "enum": [
            "completed",
            "started-and-healthy",
            "denied-as-expected",
            "locked-as-expected"
          ]
        },
        "executableSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "networkMode": { "enum": ["controlled", "offline"] },
    "resultCode": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,127}$" },
    "releaseTuple": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "rollbackTarget", "attempted"],
      "properties": {
        "active": { "$ref": "#/$defs/releaseIdentity" },
        "rollbackTarget": {
          "oneOf": [{ "$ref": "#/$defs/releaseIdentity" }, { "type": "null" }]
        },
        "attempted": {
          "oneOf": [{ "$ref": "#/$defs/releaseIdentity" }, { "type": "null" }]
        }
      }
    },
    "externalEvidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/externalEvidence" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{7}Z$"
    },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSetId",
        "generation",
        "sequence",
        "manifestSha256",
        "runtimeEntryPointSha256"
      ],
      "properties": {
        "releaseSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "generation": { "$ref": "#/$defs/safePositiveInteger" },
        "sequence": { "$ref": "#/$defs/safePositiveInteger" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "runtimeEntryPointSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "externalEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceClass",
        "mediaType",
        "sizeBytes",
        "sha256",
        "custodianIdSha256"
      ],
      "properties": {
        "evidenceClass": {
          "enum": [
            "process-inventory",
            "window-observation",
            "event-log-export",
            "network-observation",
            "filesystem-witness",
            "control-plane-audit-receipt",
            "screen-recording"
          ]
        },
        "mediaType": {
          "enum": [
            "application/octet-stream",
            "application/vnd.ensou.redacted-structured-evidence+json",
            "image/png",
            "video/mp4"
          ]
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": { "$ref": "#/$defs/sha256" },
        "custodianIdSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gate": {
      "enum": [
        "clean-standard-user-install",
        "no-visible-console-window",
        "tray-surface-open",
        "actual-runtime-start",
        "webui-open",
        "wecom-unregistered-denied",
        "wecom-authorized-scan",
        "single-device-binding",
        "second-device-binding-denied",
        "restart-without-rescan",
        "first-pilot-feed-upgrade",
        "second-consecutive-pilot-feed-upgrade",
        "failed-health-rollback",
        "previous-runtime-restart",
        "recovery-target-upgrade",
        "legacy-install-migration",
        "offline-repair",
        "device-revocation-lockout",
        "api-policy-revocation-lockout",
        "history-preservation",
        "workspace-preservation"
      ]
    }
  }
}

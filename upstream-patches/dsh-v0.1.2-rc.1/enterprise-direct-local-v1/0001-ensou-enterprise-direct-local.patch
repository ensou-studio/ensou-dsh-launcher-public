+    },
+    {
+      id: 'web-runtime',
+      config: {
+        openBrowser: false,
+        printUrl: true,
+        surfaceContext: true,
+        trustedHosts: [],
+      },
+    },
+    {
+      id: 'agent-presets',
+      config: {
+        ...structuredClone(presetConfig),
+        default: preset,
+        roots: [
+          ...structuredClone(configuredRoots ?? []),
+          { path: presetRoot, trust: 'system' },
+        ],
+        includeShippedRoot: false,
+        includeUserRoot: false,
+      },
+    },
+  ]
+}
+
+/** Narrow an untrusted config value without introducing `any[]`. */
+function isUnknownArray(value: unknown): value is readonly unknown[] {
+  return Array.isArray(value)
+}
+
+/** Return a row's object config, failing on an unexpected value. */
+function rowConfig(row: EntryOptions, id: string): Record<string, unknown> {
+  if (typeof row.config !== 'object' || row.config === null || Array.isArray(row.config)) {
+    throw new Error(`dsh: managed row ${JSON.stringify(id)} has no object config`)
+  }
+  return row.config as Record<string, unknown>
+}
+
+/** Serialize one parsed YAML value with recursively sorted object keys. */
+function canonicalJson(value: unknown): string {
+  if (value === null) return 'null'
+  if (typeof value === 'string' || typeof value === 'boolean') return JSON.stringify(value)
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) throw new Error('dsh: managed document contains a non-finite number')
+    return JSON.stringify(value)
+  }
+  if (Array.isArray(value)) return `[${value.map(canonicalJson).join(',')}]`
+  if (typeof value !== 'object') {
+    throw new Error(`dsh: managed document contains unsupported ${typeof value} value`)
+  }
+  const prototype = Reflect.getPrototypeOf(value)
+  if (prototype !== Object.prototype && prototype !== null) {
+    throw new Error('dsh: managed document contains a non-plain object')
+  }
+  const record = value as Record<string, unknown>
+  return `{${Object.keys(record).sort().map(key => `${JSON.stringify(key)}:${canonicalJson(record[key])}`).join(',')}}`
+}
+
+/** Return the recursive canonical SHA-256 of one parsed managed document. */
+function canonicalDigest(value: unknown): string {
+  return createHash('sha256').update(canonicalJson(value)).digest('hex')
+}
+
+/**
+ * Hash the complete host rows after replacing the installation-dependent
+ * managed preset path with a fixed marker.
+ * @param rows - final managed host rows.
+ * @returns lowercase SHA-256 hex.
+ */
+export function managedHostCompositionDigest(rows: readonly EntryOptions[]): string {
+  const normalized = structuredClone(rows) as EntryOptions[]
+  const sandbox = normalized.find(row => row.id === 'sandbox-policy')
+  if (sandbox !== undefined) {
+    rowConfig(sandbox, 'sandbox-policy').workspaceRoot = '<MANAGED_RUNTIME_CWD>'
+  }
+  const roster = normalized.find(row => row.id === 'agent-presets')
+  if (roster !== undefined) {
+    const config = rowConfig(roster, 'agent-presets')
+    const roots = config.roots
+    if (Array.isArray(roots) && roots.length === 1 && typeof roots[0] === 'object' && roots[0] !== null) {
+      const root = roots[0] as Record<string, unknown>
+      root.path = '<MANAGED_PRESET_ROOT>'
+    }
+  }
+  const skillFilesystem = normalized.find(row => row.id === 'skill-filesystem')
+  if (skillFilesystem !== undefined) {
+    rowConfig(skillFilesystem, 'skill-filesystem').customSkillDirs = ['<MANAGED_ENTERPRISE_SKILLS_ROOT>']
+  }
+  return createHash('sha256').update(JSON.stringify(normalized)).digest('hex')
+}
+
+/**
+ * Validate the final managed host composition after every policy patch.
+ * @param profile - loaded reserved profile.
+ * @param rows - final rows that will be passed to the root Include.
+ */
+export function assertManagedHostComposition(
+  profile: Profile,
+  rows: readonly EntryOptions[],
+  skillsRoot: string,
+  managedProfile: ManagedProfile = MANAGED_PROFILE,
+): void {
+  if (profile.patchReload !== 'startup') {
+    throw new Error('dsh: managed profile patch reload must be frozen at startup')
+  }
+  const bundles = profile.layers.map(layer => layer.packageName)
+  if (bundles.length !== MANAGED_PROFILE_BUNDLES.length
+    || !bundles.every((bundle, index) => bundle === MANAGED_PROFILE_BUNDLES[index])) {
+    throw new Error(`dsh: managed profile bundle tuple changed: ${JSON.stringify(bundles)}`)
+  }
+  for (const layer of profile.layers) {
+    const fromProfile = relative(profile.dir, layer.packageDir)
+    if (fromProfile === '' || (!fromProfile.startsWith('..') && !fromProfile.includes(':'))) {
+      throw new Error(`dsh: managed bundle ${JSON.stringify(layer.packageName)} resolved from the writable profile`)
+    }
+  }
+
+  const seen = new Set<string>()
+  const byId = new Map<string, EntryOptions>()
+  for (const row of rows) {
+    if (typeof row.id !== 'string' || typeof row.name !== 'string') {
+      throw new Error('dsh: managed host composition contains a row without a string id and name')
+    }
+    if (seen.has(row.id)) throw new Error(`dsh: managed host composition repeats row ${JSON.stringify(row.id)}`)
+    seen.add(row.id)
+    byId.set(row.id, row)
+    const expected = managedProfile === DIRECT_LOCAL_PROFILE && row.id === 'settings-composition-only'
+      ? DIRECT_LOCAL_SETTINGS_PROVIDER
+      : MANAGED_HOST_CAPABILITIES[row.id]
+    if (expected === undefined) {
+      throw new Error(`dsh: managed host composition contains unknown row ${JSON.stringify(row.id)}`)
+    }
+    if (row.name !== expected) {
+      throw new Error(
+        `dsh: managed host row ${JSON.stringify(row.id)} changed plugin from ${JSON.stringify(expected)} to ${JSON.stringify(row.name)}`,
+      )
+    }
+    if (row.group === true) {
+      throw new Error(`dsh: managed host row ${JSON.stringify(row.id)} may not contain nested plugin rows`)
+    }
+  }
+  for (const id of Object.keys(MANAGED_HOST_CAPABILITIES)) {
+    if (!seen.has(id)) throw new Error(`dsh: managed host composition is missing row ${JSON.stringify(id)}`)
+  }
+  const disabledRows = managedProfile === MANAGED_PROFILE
+    ? MANAGED_DISABLED_ROWS
+    : DIRECT_LOCAL_DISABLED_ROWS
+  for (const id of disabledRows) {
+    if (byId.get(id)?.disabled !== true) {
+      throw new Error(`dsh: managed host row ${JSON.stringify(id)} must be disabled`)
+    }
+  }
+  const requiredEnabled = [
+    'skill',
+    'skill-filesystem',
+    'skill-badge',
+    'ui-brand-official',
+    ...(managedProfile === DIRECT_LOCAL_PROFILE
+      ? [
+        'settings-composition-only',
+        'credentials',
+        'llm-deepseek',
+        'web',
+        'web-search-deepseek',
+        'web-fetch-http',
+        'tool-web',
+        'settings-controller',
+        'ui-settings',
+        'ui-settings-general',
+        'ui-settings-models',
+      ]
+      : []),
+  ]
+  for (const id of requiredEnabled) {
+    if (byId.get(id)?.disabled === true) {
+      throw new Error(`dsh: managed host row ${JSON.stringify(id)} must be enabled`)
+    }
+  }
+
+  const skillFilesystemConfig = rowConfig(
+    byId.get('skill-filesystem') as EntryOptions,
+    'skill-filesystem',
+  )
+  const customSkillDirs = skillFilesystemConfig.customSkillDirs
+  if (skillFilesystemConfig.includeDefaultRoots !== false
+    || !Array.isArray(customSkillDirs) || customSkillDirs.length !== 1
+    || customSkillDirs[0] !== skillsRoot
+    || skillFilesystemConfig.watch !== false
+    || skillFilesystemConfig.watchFollowSymlinks !== false
+    || Object.keys(skillFilesystemConfig).length !== 4) {
+    throw new Error('dsh: managed skill filesystem must expose only the Launcher-owned root without watchers')
+  }
+
+  const sandboxConfig = rowConfig(byId.get('sandbox-policy') as EntryOptions, 'sandbox-policy')
+  if (sandboxConfig.mode !== 'workspace-write' || sandboxConfig.maximumMode !== 'workspace-write'
+    || sandboxConfig.lockWorkspaceRoot !== true || sandboxConfig.workspaceRoot !== process.cwd()
+    || Object.keys(sandboxConfig).length !== 4) {
+    throw new Error('dsh: managed sandbox policy must be locked at workspace-write at the runtime working directory')
+  }
+  const approvalConfig = rowConfig(byId.get('approval') as EntryOptions, 'approval')
+  if (approvalConfig.policy !== 'ask' || Object.keys(approvalConfig).length !== 1) {
+    throw new Error('dsh: managed approval policy must be ask')
+  }
+  const permissionConfig = rowConfig(byId.get('permission') as EntryOptions, 'permission')
+  const presets = permissionConfig.presets
+  if (permissionConfig.defaultPreset !== 'workspace-write'
+    || Object.keys(permissionConfig).length !== 2
+    || typeof presets !== 'object' || presets === null || Array.isArray(presets)
+    || Object.keys(presets).length !== 1) {
+    throw new Error('dsh: managed permission presets must contain only workspace-write')
+  }
+  const workspacePreset = (presets as Record<string, unknown>)['workspace-write']
+  if (typeof workspacePreset !== 'object' || workspacePreset === null || Array.isArray(workspacePreset)
+    || (workspacePreset as Record<string, unknown>).sandbox !== 'workspace-write'
+    || (workspacePreset as Record<string, unknown>).approval !== 'ask'
+    || Object.keys(workspacePreset).length !== 2) {
+    throw new Error('dsh: managed workspace-write preset must retain sandboxing and approval')
+  }
+
+  const webRuntimeConfig = rowConfig(byId.get('web-runtime') as EntryOptions, 'web-runtime')
+  const trustedHosts = webRuntimeConfig.trustedHosts
+  if (webRuntimeConfig.openBrowser !== false || webRuntimeConfig.printUrl !== true
+    || webRuntimeConfig.surfaceContext !== true || !Array.isArray(trustedHosts)
+    || trustedHosts.length !== 0 || Object.keys(webRuntimeConfig).length !== 4) {
+    throw new Error('dsh: managed Web runtime must leave browser opening to the enterprise Launcher')
+  }
+
+  if (managedProfile === DIRECT_LOCAL_PROFILE) {
+    const settingsConfig = rowConfig(
+      byId.get('settings-composition-only') as EntryOptions,
+      'settings-composition-only',
+    )
+    if (Object.keys(settingsConfig).length !== 0) {
+      throw new Error('dsh: enterprise direct-local settings must use the empty composition-only document')
+    }
+    const settingsControllerConfig = rowConfig(
+      byId.get('settings-controller') as EntryOptions,
+      'settings-controller',
+    )
+    if (settingsControllerConfig.nativeOpen !== false
+      || Object.keys(settingsControllerConfig).length !== 1) {
+      throw new Error('dsh: enterprise direct-local settings document opening must be disabled')
+    }
+    const modelConfig = rowConfig(byId.get('llm-deepseek') as EntryOptions, 'llm-deepseek')
+    if (modelConfig.apiKeyEnv !== 'DEEPSEEK_API_KEY'
+      || modelConfig.baseURL !== DIRECT_LOCAL_MODEL_BASE_URL) {
+      throw new Error('dsh: enterprise direct-local model must use the official endpoint and local credential reference')
+    }
+    const searchConfig = rowConfig(
+      byId.get('web-search-deepseek') as EntryOptions,
+      'web-search-deepseek',
+    )
+    if (searchConfig.apiKeyEnv !== 'DEEPSEEK_API_KEY'
+      || searchConfig.baseURL !== DIRECT_LOCAL_SEARCH_BASE_URL
+      || Object.keys(searchConfig).length !== 2) {
+      throw new Error('dsh: enterprise direct-local search must use the official endpoint and local credential reference')
+    }
+  }
+
+  const presetConfig = rowConfig(byId.get('agent-presets') as EntryOptions, 'agent-presets')
+  const roots = presetConfig.roots
+  const preset = managedProfile === MANAGED_PROFILE ? MANAGED_PRESET : DIRECT_LOCAL_PRESET
+  const presetRoot = managedProfile === MANAGED_PROFILE ? MANAGED_PRESET_ROOT : DIRECT_LOCAL_PRESET_ROOT
+  if (presetConfig.default !== preset || presetConfig.includeShippedRoot !== false
+    || presetConfig.includeUserRoot !== false || Object.keys(presetConfig).length !== 4
+    || !Array.isArray(roots) || roots.length !== 1
+    || typeof roots[0] !== 'object' || roots[0] === null
+    || (roots[0] as Record<string, unknown>).path !== presetRoot
+    || (roots[0] as Record<string, unknown>).trust !== 'system'
+    || Object.keys(roots[0] as Record<string, unknown>).length !== 2) {
+    throw new Error('dsh: managed agent preset roster is not locked to the installation-owned root')
+  }
+  const digest = managedHostCompositionDigest(rows)
+  const expectedDigest = managedProfile === MANAGED_PROFILE
+    ? MANAGED_HOST_COMPOSITION_SHA256
+    : DIRECT_LOCAL_HOST_COMPOSITION_SHA256
+  if (digest !== expectedDigest) {
+    throw new Error(`dsh: managed host composition digest changed: ${digest}`)
+  }
+}
+
+/** Walk a preset composition and validate every row against its exact path. */
+function validatePresetRows(
+  rows: readonly EntryOptions[],
+  parent: string,
+  seen: Set<string>,
+  capabilities: Readonly<Record<string, string>>,
+): void {
+  for (const row of rows) {
+    if (typeof row.id !== 'string' || typeof row.name !== 'string') {
+      throw new Error('dsh: managed preset contains a row without a string id and name')
+    }
+    const path = parent === '' ? row.id : `${parent}/${row.id}`
+    if (seen.has(path)) throw new Error(`dsh: managed preset repeats row ${JSON.stringify(path)}`)
+    seen.add(path)
+    const expected = capabilities[path]
+    if (expected === undefined) throw new Error(`dsh: managed preset contains unknown row ${JSON.stringify(path)}`)
+    if (row.name !== expected) {
+      throw new Error(
+        `dsh: managed preset row ${JSON.stringify(path)} changed plugin from ${JSON.stringify(expected)} to ${JSON.stringify(row.name)}`,
+      )
+    }
+    if (row.group === true) {
+      if (!Array.isArray(row.config)) throw new Error(`dsh: managed preset group ${JSON.stringify(path)} has no row list`)
+      validatePresetRows(row.config as EntryOptions[], path, seen, capabilities)
+    }
+  }
+}
+
+/**
+ * Validate parsed managed preset rows against the exact agent capability list.
+ * @param rows - parsed preset composition.
+ */
+export function assertManagedPresetRows(
+  rows: readonly EntryOptions[],
+  profile: ManagedProfile = MANAGED_PROFILE,
+): void {
+  const capabilities = profile === MANAGED_PROFILE
+    ? MANAGED_PRESET_CAPABILITIES
+    : DIRECT_LOCAL_PRESET_CAPABILITIES
+  const seen = new Set<string>()
+  validatePresetRows(rows, '', seen, capabilities)
+  for (const path of Object.keys(capabilities)) {
+    if (!seen.has(path)) throw new Error(`dsh: managed preset is missing row ${JSON.stringify(path)}`)
+  }
+  const digest = managedPresetCompositionDigest(rows)
+  const expectedDigest = profile === MANAGED_PROFILE
+    ? MANAGED_PRESET_COMPOSITION_SHA256
+    : DIRECT_LOCAL_PRESET_COMPOSITION_SHA256
+  if (digest !== expectedDigest) {
+    throw new Error(`dsh: managed preset composition digest changed: ${digest}`)
+  }
+}
+
+/** Recursively hash every managed preset row field, including config, disabled, group, and isolate. */
+export function managedPresetCompositionDigest(rows: readonly EntryOptions[]): string {
+  return canonicalDigest(rows)
+}
+
+/** Validate the exact parsed `preset.yml` metadata document. */
+export function assertManagedPresetMetadata(
+  metadata: unknown,
+  profile: ManagedProfile = MANAGED_PROFILE,
+): void {
+  if (metadata === null || typeof metadata !== 'object' || Array.isArray(metadata)) {
+    throw new Error('dsh: managed preset metadata must be an object')
+  }
+  const digest = canonicalDigest(metadata)
+  const expectedDigest = profile === MANAGED_PROFILE
+    ? MANAGED_PRESET_METADATA_SHA256
+    : DIRECT_LOCAL_PRESET_METADATA_SHA256
+  if (digest !== expectedDigest) {
+    throw new Error(`dsh: managed preset metadata digest changed: ${digest}`)
+  }
+}
+
+/** Validate the exact parsed installation-owned root `cordis.yml`. */
+export function assertManagedRootRows(
+  rows: unknown,
+  profile: ManagedProfile = MANAGED_PROFILE,
+): asserts rows is EntryOptions[] {
+  if (!Array.isArray(rows)) throw new Error('dsh: managed root composition must be a top-level row list')
+  const digest = canonicalDigest(rows)
+  const expectedDigest = profile === MANAGED_PROFILE
+    ? MANAGED_ROOT_COMPOSITION_SHA256
+    : DIRECT_LOCAL_ROOT_COMPOSITION_SHA256
+  if (digest !== expectedDigest) {
+    throw new Error(`dsh: managed root composition digest changed: ${digest}`)
+  }
+}
+
+/** Refuse an installation config path that is missing, aliased, or a reparse point. */
+function assertPhysicalManagedConfigPath(path: string, kind: 'file' | 'directory'): void {
+  const canonicalSpelling = kind === 'directory' && path.length > parse(path).root.length && path.endsWith(sep)
+    ? path.slice(0, -1)
+    : path
+  if (!isAbsolute(path) || resolve(path) !== canonicalSpelling) {
+    throw new Error(`dsh: managed installation ${kind} path is not exact: ${path}`)
+  }
+  let status: ReturnType<typeof lstatSync>
+  let physical: string
+  try {
+    status = lstatSync(path)
+    physical = realpathSync.native(path)
+  } catch {
+    throw new Error(`dsh: managed installation ${kind} is missing: ${path}`)
+  }
+  const kindMatches = kind === 'file' ? status.isFile() : status.isDirectory()
+  if (!kindMatches || status.isSymbolicLink() || physical !== canonicalSpelling) {
+    throw new Error(`dsh: managed installation ${kind} is not a physical canonical path: ${path}`)
+  }
+}
+
+/**
+ * Validate the installation-owned root and its one preset before host boot.
+ * @param rootConfig - exact physical Loader root document (injectable only for isolated verification).
+ * @param presetRoot - exact physical preset root (injectable only for isolated verification).
+ * @returns parsed, validated preset rows.
+ */
+export function validateManagedPresetRoot(
+  rootConfig?: string,
+  presetRoot?: string,
+  profile: ManagedProfile = MANAGED_PROFILE,
+): EntryOptions[] {
+  rootConfig ??= profile === MANAGED_PROFILE ? MANAGED_ROOT_CONFIG : DIRECT_LOCAL_ROOT_CONFIG
+  presetRoot ??= profile === MANAGED_PROFILE ? MANAGED_PRESET_ROOT : DIRECT_LOCAL_PRESET_ROOT
+  const loaderRoot = dirname(rootConfig)
+  assertPhysicalManagedConfigPath(loaderRoot, 'directory')
+  assertPhysicalManagedConfigPath(rootConfig, 'file')
+  const rootFiles = readdirSync(loaderRoot, { withFileTypes: true })
+  if (rootFiles.length !== 1 || rootFiles[0]?.name !== 'cordis.yml' || !rootFiles[0].isFile()) {
+    throw new Error('dsh: managed Loader root contains unexpected files')
+  }
+  const rootRows = load(readFileSync(rootConfig, 'utf8'), { schema: entryListSchema })
+  assertManagedRootRows(rootRows, profile)
+  assertPhysicalManagedConfigPath(presetRoot, 'directory')
+  const rootEntries = readdirSync(presetRoot, { withFileTypes: true })
+  const preset = profile === MANAGED_PROFILE ? MANAGED_PRESET : DIRECT_LOCAL_PRESET
+  if (rootEntries.length !== 1 || rootEntries[0]?.name !== preset || !rootEntries[0].isDirectory()) {
+    throw new Error(`dsh: managed preset root must contain only ${JSON.stringify(preset)}`)
+  }
+  const presetDir = join(presetRoot, preset)
+  assertPhysicalManagedConfigPath(presetDir, 'directory')
+  const files = readdirSync(presetDir, { withFileTypes: true })
+  const names = files.map(file => file.name).sort()
+  if (files.some(file => !file.isFile())
+    || names.length !== 2 || names[0] !== 'agent.cordis.yml' || names[1] !== 'preset.yml') {
+    throw new Error('dsh: managed preset directory contains unexpected files')
+  }
+  const agentConfig = join(presetDir, 'agent.cordis.yml')
+  const metadataConfig = join(presetDir, 'preset.yml')
+  assertPhysicalManagedConfigPath(agentConfig, 'file')
+  assertPhysicalManagedConfigPath(metadataConfig, 'file')
+  const parsed = load(readFileSync(agentConfig, 'utf8'), { schema: entryListSchema })
+  if (!Array.isArray(parsed)) throw new Error('dsh: managed preset composition must be a top-level row list')
+  const rows = parsed as EntryOptions[]
+  assertManagedPresetRows(rows, profile)
+  assertManagedPresetMetadata(load(readFileSync(metadataConfig, 'utf8')), profile)
+  return rows
+}

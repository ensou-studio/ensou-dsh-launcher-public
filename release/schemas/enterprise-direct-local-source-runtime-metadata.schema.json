{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensou.example/schemas/dsh/enterprise-direct-local-source-runtime-metadata.schema.json",
  "title": "Ensou production direct-local source runtime metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "releaseId", "promotionEligible", "artifactType", "sourceBuilt", "platform",
    "sourceIdentity", "sourceRepository", "sourceTag", "sourceCommit", "sourceTree", "dshVersion",
    "baseLockfileSha256", "lockfileSha256", "runtimeWebAuthProtocol", "runtimeProfile",
    "managedUpdateProtocol", "managedPatch", "managedPolicy", "builtAtUtc", "toolchain",
    "verification", "artifact", "licensing"
  ],
  "oneOf": [
    {
      "properties": {
        "promotionEligible": { "const": true },
        "releaseId": { "pattern": "^managed-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$" }
      }
    },
    {
      "properties": {
        "promotionEligible": { "const": false },
        "releaseId": { "pattern": "^lab-[A-Za-z0-9][A-Za-z0-9._-]{0,123}$" }
      }
    }
  ],
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "directSmoke": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status", "resultStatus", "scope", "cycles", "kernelBootstrapVerified",
        "settingsReadOnly", "credentialsWritable", "exactChildExited",
        "authenticationNegativesVerified", "launchRefusalsVerified",
        "modelRequestsSent", "outputBytes"
      ],
      "properties": {
        "status": { "const": "PASS" },
        "resultStatus": { "const": "PASS" },
        "scope": { "const": "BUILT_ENTERPRISE_DIRECT_LOCAL_RUNTIME_CAPABILITY_ONLY" },
        "cycles": { "const": 2 },
        "kernelBootstrapVerified": { "const": true },
        "settingsReadOnly": { "const": true },
        "credentialsWritable": { "const": true },
        "exactChildExited": { "const": true },
        "authenticationNegativesVerified": { "const": true },
        "launchRefusalsVerified": { "const": true },
        "modelRequestsSent": { "const": 0 },
        "outputBytes": { "type": "integer", "minimum": 0, "maximum": 8388608 }
      }
    }
  },
  "properties": {
    "schemaVersion": { "const": 3 },
    "releaseId": {
      "type": "string", "maxLength": 128,
      "pattern": "^(?:managed-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*|lab-[A-Za-z0-9][A-Za-z0-9._-]{0,123})$"
    },
    "promotionEligible": { "type": "boolean" },
    "artifactType": { "const": "ensou-dsh-enterprise-direct-local-source-runtime" },
    "sourceBuilt": { "const": true },
    "platform": { "const": "win32-x64" },
    "sourceIdentity": { "const": "github-https-tag-plus-ensou-managed-patch" },
    "sourceRepository": { "const": "https://github.com/deepseek-ai/deepseek-harness.git" },
    "sourceTag": { "const": "dsh-v0.1.2-rc.1" },
    "sourceCommit": { "const": "a66e4702047846cdaa10c66c9d3df3951f5ea70d" },
    "sourceTree": { "const": "27ab636bb3d77e698f5637e518db44ae1f61e262" },
    "dshVersion": { "const": "0.1.2-rc.1" },
    "baseLockfileSha256": { "const": "e12083149a77f790d39b64d018b6b8745c6a7aa95777ecb73e0a2f5ed5fdd0d9" },
    "lockfileSha256": { "const": "07974704247ec18915df8fdf117c682bba2d861aafe7059ea4bca4aab1677080" },
    "runtimeWebAuthProtocol": { "const": "browser-launch-cookie-v1" },
    "runtimeProfile": { "const": "enterprise-direct-local" },
    "managedUpdateProtocol": { "const": "enterprise-direct-local-v1" },
    "managedPatch": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "manifestSchema", "manifestSha256", "patchSha256", "patchBytes", "changedFileCount", "modifiedPreimageCount"],
      "properties": {
        "id": { "const": "dsh-v0.1.2-rc.1-enterprise-direct-local-v1" },
        "manifestSchema": { "const": "ensou.dsh.upstream-patch-manifest.v4" },
        "manifestSha256": { "const": "977ebb374bf9449e34daa7b0ef393a06b2c862d944200abb69a30434a2597cf0" },
        "patchSha256": { "const": "7f10ec9492b399cede422428013b0c77bc932699fa3a14fa7ced158454272b6f" },
        "patchBytes": { "const": 415878 },
        "changedFileCount": { "const": 112 },
        "modifiedPreimageCount": { "const": 86 }
      }
    },
    "managedPolicy": {
      "type": "object", "additionalProperties": false,
      "required": [
        "signal", "profile", "webArguments", "model", "maxTokens", "modelBaseUrl", "searchBaseUrl",
        "credentialEnvironment", "credentialSource", "launchEnvironmentProviderOverrides", "settingsProvider",
        "managedSkillsRootEnvironment", "sandboxMode", "sandboxMaximumMode", "approvalPolicy",
        "permissionPresets", "workspaceRootSource", "restoredSessionCwdPolicy",
        "hostCompositionCanonicalSha256", "presetCompositionCanonicalSha256",
        "presetMetadataCanonicalSha256", "loaderRootCanonicalSha256", "pluginResolutionPolicy"
      ],
      "properties": {
        "signal": { "const": "DSH_ENTERPRISE_MANAGED_BOOT=ensou-dsh-launcher/v1" },
        "profile": { "const": "enterprise-direct-local" },
        "webArguments": { "const": "--host 127.0.0.1 --port <canonical 1..65535>" },
        "model": { "const": "deepseek-v4-flash" },
        "maxTokens": { "const": 8192 },
        "modelBaseUrl": { "const": "https://api.deepseek.com" },
        "searchBaseUrl": { "const": "https://api.deepseek.com/anthropic/v1" },
        "credentialEnvironment": { "const": "DEEPSEEK_API_KEY" },
        "credentialSource": { "const": "@deepseek-ai/dsh-credentials-local writable local credential store" },
        "launchEnvironmentProviderOverrides": { "const": ["DEEPSEEK_BASE_URL", "DEEPSEEK_SEARCH_BASE_URL", "DEEPSEEK_API_KEY"] },
        "settingsProvider": { "const": "@deepseek-ai/dsh-settings-file/composition-only" },
        "managedSkillsRootEnvironment": { "const": "ENSOU_DSH_ENTERPRISE_SKILLS_ROOT" },
        "sandboxMode": { "const": "workspace-write" },
        "sandboxMaximumMode": { "const": "workspace-write" },
        "approvalPolicy": { "const": "ask" },
        "permissionPresets": { "const": ["workspace-write"] },
        "workspaceRootSource": { "const": "process.cwd()" },
        "restoredSessionCwdPolicy": { "const": "must-equal-workspace-root" },
        "hostCompositionCanonicalSha256": { "const": "cad7cdf7f1b13f1892a2b857e3f628de71579ab4bef89f3b97ac0fed03cc25ba" },
        "presetCompositionCanonicalSha256": { "const": "e3c01ae98d9bf12e57e3ba270169f7059e3b098615e21b4db11fd377367ea546" },
        "presetMetadataCanonicalSha256": { "const": "3590423cb2fb8809c0d11b18dec12f9e1df370a4f05dc93fff1c54e82abc75be" },
        "loaderRootCanonicalSha256": { "const": "4f53cda18c2baa0c0354bb5f9a3ecbe5ed12ab4d8e11ba873c2f11161202b945" },
        "pluginResolutionPolicy": { "const": "frozen exact installation map from managed base/web bundles; no ambient fallback" }
      }
    },
    "builtAtUtc": { "type": "string", "format": "date-time", "maxLength": 64 },
    "toolchain": {
      "type": "object", "additionalProperties": false,
      "required": ["nodeVersion", "nodeSha256", "pnpmVersion", "npmVersion"],
      "properties": {
        "nodeVersion": { "const": "24.19.0" },
        "nodeSha256": { "$ref": "#/$defs/sha256" },
        "pnpmVersion": { "const": "11.7.0" },
        "npmVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" }
      }
    },
    "verification": {
      "type": "object", "additionalProperties": false,
      "required": [
        "cleanCheckout", "tagCommitMatch", "remoteTagCommitMatch", "tagSignatureVerified",
        "officialCheckoutUnchanged", "patchManifestValidated", "patchPreimagesVerified", "patchApplyCheck",
        "patchPostimagesVerified", "frozenLockfileInstall", "managedFocusedTests",
        "managedWindowsExcludedFocusedTests", "managedChangedPackageTypeBuild", "managedCliBundle",
        "managedSourceGates", "sourceBuild", "builtPackageInvariants", "deploymentMode",
        "runtimeClosureAgainstPinnedSourceAndLock", "runtimeClosurePackageCount", "portableCommandShimGate",
        "symlinkFreeRuntime", "bundledNodeVersionSmoke", "nativeModuleSmoke", "webProfileDumpSmoke",
        "webHttpSmoke", "managedExactEnvironmentSmoke", "managedWorkspaceCwdSmoke", "managedRefusalSmoke",
        "extractedArtifactHashManifestVerified", "extractedArtifactSmoke", "buildToolingExcluded",
        "webSmokeUrl", "externalNetworkIsolation", "directLocalAssembledSmoke", "directLocalExtractedSmoke"
      ],
      "properties": {
        "cleanCheckout": { "const": true }, "tagCommitMatch": { "const": true },
        "remoteTagCommitMatch": { "const": true }, "tagSignatureVerified": { "const": false },
        "officialCheckoutUnchanged": { "const": true }, "patchManifestValidated": { "const": true },
        "patchPreimagesVerified": { "const": true }, "patchApplyCheck": { "const": true },
        "patchPostimagesVerified": { "const": true }, "frozenLockfileInstall": { "const": true },
        "managedFocusedTests": { "const": true }, "managedWindowsExcludedFocusedTests": { "const": true },
        "managedChangedPackageTypeBuild": { "const": true }, "managedCliBundle": { "const": true },
        "managedSourceGates": { "const": true },
        "sourceBuild": { "const": "pnpm run build (reviewed managed patch applied)" },
        "builtPackageInvariants": { "const": true },
        "deploymentMode": { "const": "pnpm-dedicated-lockfile-offline-deploy" },
        "runtimeClosureAgainstPinnedSourceAndLock": { "const": true },
        "runtimeClosurePackageCount": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "portableCommandShimGate": { "const": true }, "symlinkFreeRuntime": { "const": true },
        "bundledNodeVersionSmoke": { "const": true }, "nativeModuleSmoke": { "const": ["node-pty", "koffi"] },
        "webProfileDumpSmoke": { "const": true }, "webHttpSmoke": { "const": true },
        "managedExactEnvironmentSmoke": { "const": true }, "managedWorkspaceCwdSmoke": { "const": true },
        "managedRefusalSmoke": { "const": true }, "extractedArtifactHashManifestVerified": { "const": true },
        "extractedArtifactSmoke": { "const": true }, "buildToolingExcluded": { "const": true },
        "webSmokeUrl": { "const": "http://127.0.0.1:<ephemeral-port>/" },
        "externalNetworkIsolation": { "const": false },
        "directLocalAssembledSmoke": { "$ref": "#/$defs/directSmoke" },
        "directLocalExtractedSmoke": { "$ref": "#/$defs/directSmoke" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["fileName", "sizeBytes", "sha256"],
      "properties": {
        "fileName": { "type": "string", "maxLength": 255, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.zip$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "licensing": {
      "type": "object", "additionalProperties": false,
      "required": ["harnessLicense", "noticesIncluded", "organizationReviewRequired"],
      "properties": {
        "harnessLicense": { "const": "MIT" },
        "noticesIncluded": { "const": true },
        "organizationReviewRequired": { "const": true }
      }
    }
  }
}

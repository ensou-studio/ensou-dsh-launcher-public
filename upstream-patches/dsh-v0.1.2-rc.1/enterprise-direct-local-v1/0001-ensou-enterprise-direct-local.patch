+/** Whether one runtime inventory path is canonical POSIX and ends in its package name. */
+function isRuntimePackagePath(path: string, packageName: string): boolean {
+  const nameParts = packageNameParts(packageName)
+  if (nameParts === undefined || path.includes('\\') || posix.isAbsolute(path) || posix.normalize(path) !== path) {
+    return false
+  }
+  const parts = path.split('/')
+  if (parts[0] !== 'node_modules' || parts.some(part => part === '' || part === '.' || part === '..')) return false

+  if (Object.keys(providerOverride).length > 0) {
+    if (source === 'process') {
+      layers[0] = { source, values: { ...layers[0]?.values, ...providerOverride } }
+    } else {
+      layers.push({ source, values: providerOverride })
+    }
+  }

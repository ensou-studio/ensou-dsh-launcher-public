+function assertPhysicalRuntimeDirectory(runtimeRoot: string, directory: string): void {
+  if (!isWithin(runtimeRoot, directory)) {
+    throw new Error(`dsh-app-boot: runtime package directory is outside installation boundary: ${directory}`)
+  }
+  const relativeDirectory = relative(runtimeRoot, directory)
+  const parts = relativeDirectory === '' ? [] : relativeDirectory.split(sep)
+  let current = runtimeRoot
+  const assertCurrent = (): void => {
+    const stat = lstatSync(current)
+    if (!stat.isDirectory() || stat.isSymbolicLink() || realpathSync.native(current) !== current) {
+      throw new Error(`dsh-app-boot: runtime package path contains a non-physical directory: ${current}`)
+    }
+  }
+  assertCurrent()
+  for (const part of parts) {
+    current = join(current, part)
+    assertCurrent()
+  }

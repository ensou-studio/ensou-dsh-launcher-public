<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Ensou.Dsh.Enterprise.DirectLocalReleasePublisherTests</RootNamespace>
    <AssemblyName>Ensou.Dsh.Enterprise.DirectLocalReleasePublisherTests</AssemblyName>
    <EnterpriseDirectLocalRuntimeAdmission Condition="'$(EnterpriseDirectLocalRuntimeAdmission)' == ''">true</EnterpriseDirectLocalRuntimeAdmission>
    <DefineConstants Condition="'$(EnterpriseDirectLocalRuntimeAdmission)' == 'true'">$(DefineConstants);ENTERPRISE_DIRECT_LOCAL_RUNTIME_ADMISSION</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Ensou.Dsh.Enterprise.ReleasePublisher\Ensou.Dsh.Enterprise.ReleasePublisher.csproj">
      <AdditionalProperties>EnterpriseDirectLocalRuntimeAdmission=$(EnterpriseDirectLocalRuntimeAdmission)</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher target-channel signed-candidate response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "responseType",
    "orchestrationId",
    "edition",
    "releaseSetId",
    "channel",
    "planSha256",
    "requestSha256",
    "requestNonce",
    "baseHeadSha256",
    "admissionHeadSha256",
    "admissionRevision",
    "requestExpiresAtUtc",
    "completedAtUtc",
    "files",
    "authentication"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "responseType": { "const": "ensou-dsh-launcher-manifest-publishing-response" },
    "orchestrationId": { "$ref": "#/definitions/orchestrationId" },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "channel": { "enum": ["pilot", "stable"] },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "requestSha256": { "$ref": "#/definitions/sha256" },
    "requestNonce": { "$ref": "#/definitions/nonce" },
    "baseHeadSha256": { "$ref": "#/definitions/sha256" },
    "admissionHeadSha256": { "$ref": "#/definitions/sha256" },
    "admissionRevision": { "const": 4 },
    "requestExpiresAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "runtimeSourceReleaseAdmission": { "$ref": "#/definitions/runtimeSourceReleaseAdmission" },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": { "$ref": "#/definitions/file" }
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "payloadType", "value"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/token" },
        "purpose": { "const": "manifest-publishing-response" },
        "payloadType": {
          "const": "ensou-dsh-launcher-manifest-publishing-response-authentication-v1"
        },
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9_-]{86}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "required": ["runtimeSourceReleaseAdmission"] },
      "then": {
        "properties": {
          "edition": { "const": "Enterprise" },
          "channel": { "const": "stable" }
        }
      }
    },
    {
      "if": {
        "properties": { "edition": { "const": "Enterprise" } },
        "required": ["edition"]
      },
      "then": {
        "properties": {
          "channel": { "const": "stable" },
          "files": {
            "minItems": 5,
            "maxItems": 5,
            "items": [
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  {
                    "properties": {
                      "role": { "const": "release-manifest" },
                      "fileName": { "const": "release-set.v2.json" },
                      "relativePath": { "const": "candidate/release-set.v2.json" }
                    }
                  }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  {
                    "properties": {
                      "role": { "const": "release-public-key" },
                      "fileName": { "const": "release-public-key.v2.json" },
                      "relativePath": { "const": "candidate/release-public-key.v2.json" }
                    }
                  }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  { "properties": { "role": { "const": "launcher" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  { "properties": { "role": { "const": "runtime" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  { "properties": { "role": { "const": "plugin-policy" } } }
                ]
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": { "edition": { "const": "Personal" } },
        "required": ["edition"]
      },
      "then": {
        "properties": {
          "files": {
            "minItems": 3,
            "maxItems": 3,
            "items": [
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  {
                    "properties": {
                      "role": { "const": "release-manifest" },
                      "fileName": { "const": "release-set.v2.json" },
                      "relativePath": { "const": "candidate/release-set.v2.json" }
                    }
                  }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  { "properties": { "role": { "const": "client-bundle" } } }
                ]
              },
              {
                "allOf": [
                  { "$ref": "#/definitions/file" },
                  { "properties": { "role": { "const": "runtime" } } }
                ]
              }
            ]
          }
        }
      }
    }
  ],
  "definitions": {
    "githubRepository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 140,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?/[A-Za-z0-9](?:[A-Za-z0-9._-]{0,98}[A-Za-z0-9_-])?$"
    },
    "githubCommit": {
      "type": "string",
      "minLength": 40,
      "maxLength": 40,
      "pattern": "^[0-9a-f]{40}$"
    },
    "managedRuntimeTag": {
      "type": "string",
      "minLength": 21,
      "maxLength": 128,
      "pattern": "^managed-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "runtimeSourceReleaseAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "githubAssetId", "fileName", "sizeBytes", "sha256"],
      "properties": {
        "role": { "enum": ["archive", "metadata", "hash-evidence"] },
        "githubAssetId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "runtimeSourceRelease": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository", "githubReleaseId", "tagName", "targetCommit",
        "immutable", "assets"
      ],
      "properties": {
        "repository": { "$ref": "#/definitions/githubRepository" },
        "githubReleaseId": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "tagName": { "$ref": "#/definitions/managedRuntimeTag" },
        "targetCommit": { "$ref": "#/definitions/githubCommit" },
        "immutable": { "const": true },
        "assets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": [
            {
              "allOf": [
                { "$ref": "#/definitions/runtimeSourceReleaseAsset" },
                { "properties": { "role": { "const": "archive" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/runtimeSourceReleaseAsset" },
                { "properties": { "role": { "const": "metadata" } } }
              ]
            },
            {
              "allOf": [
                { "$ref": "#/definitions/runtimeSourceReleaseAsset" },
                { "properties": { "role": { "const": "hash-evidence" } } }
              ]
            }
          ],
          "additionalItems": false
        }
      }
    },
    "runtimeSourceReleaseAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["receiptSha256", "sourceRelease"],
      "properties": {
        "receiptSha256": { "$ref": "#/definitions/sha256" },
        "sourceRelease": { "$ref": "#/definitions/runtimeSourceRelease" }
      }
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9a-f]{64}$"
    },
    "nonce": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9_-]{43}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "orchestrationId": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "relativePath", "sizeBytes", "sha256"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[a-z][a-z0-9-]*$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^(?![\\s\\S]*\\p{Cc})[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 11,
          "maxLength": 265,
          "pattern": "^(?![\\s\\S]*\\p{Cc})candidate/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    }
  }
}

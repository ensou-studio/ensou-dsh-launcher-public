+      throw new Error(
+        `dsh-app-boot: trusted plugin ${JSON.stringify(specifier)} cannot resolve its declared package export: ${String(error)}`,
+        { cause: error },
+      )
+    }
+    const canonicalPackageResolved = realpathSync.native(packageResolvedPath)
+    if (!isWithin(installationRoot, canonicalPackageResolved)) {
+      throw new Error(
+        `dsh-app-boot: trusted plugin ${JSON.stringify(specifier)} package export resolves outside installation boundary: ${canonicalPackageResolved}`,
+      )

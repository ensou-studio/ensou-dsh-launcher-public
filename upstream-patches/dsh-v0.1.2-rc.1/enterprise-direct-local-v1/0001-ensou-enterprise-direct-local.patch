+    `dsh-app-boot: resolved plugin ${JSON.stringify(packageName)} has no matching package manifest inside ${installationRoot}`,
+  )
+}
+
+/** Freeze a null-prototype record and every resolution value it contains. */
+function freezeTrustedPluginResolutions(
+  installationRoot: string,
+  values: ReadonlyMap<string, TrustedPluginResolution>,
+): TrustedPluginResolutions {
+  const entries = Object.create(null) as Record<string, TrustedPluginResolution>

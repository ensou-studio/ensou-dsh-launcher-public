+    throw new Error(`dsh-app-boot: package manifest is outside installation boundary: ${manifestPath}`)
+  }
+  const stat = lstatSync(manifestPath)
+  if (!stat.isFile() || stat.isSymbolicLink() || realpathSync.native(manifestPath) !== manifestPath) {
+    throw new Error(`dsh-app-boot: package manifest is not a physical installation file: ${manifestPath}`)
+  }

diff --git a/packages/settings/settings/src/index.ts b/packages/settings/settings/src/index.ts
index 232364b4e877cac1363414df835c37b425a5bfdf..02ef439c8ed80d5fc651aaec94fa5f6b3e75b87d 100644
--- a/packages/settings/settings/src/index.ts
+++ b/packages/settings/settings/src/index.ts
@@ -394,0 +395,18 @@ export abstract class SettingsProvider extends Service {
+  /**
+   * Await the stable tail of every settings write admitted before this
+   * durability barrier. Provider persistence is awaited by each write queue,
+   * so no storage-specific approximation is needed here.
+   * @returns true after all currently admitted writes settle.
+   */
+  async durabilityCheckpoint(): Promise<boolean> {
+    let observed: Promise<unknown>[]
+    let current: Promise<unknown>[]
+    do {
+      observed = [...this.writeQueues.values()]
+      await Promise.all(observed)
+      current = [...this.writeQueues.values()]
+    } while (observed.length !== current.length
+      || observed.some((promise, index) => promise !== current[index]))
+    return true
+  }
+

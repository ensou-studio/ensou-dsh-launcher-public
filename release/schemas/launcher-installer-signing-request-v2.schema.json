{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher Installer signing request v2",
  "type": "object",
  "required": ["schemaVersion", "edition", "channel"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "channel": { "enum": ["pilot", "stable"] }
  },
  "oneOf": [
    {
      "allOf": [
        {
          "properties": {
            "edition": { "const": "Personal" },
            "channel": { "const": "pilot" }
          },
          "required": ["edition", "channel"]
        },
        {
          "$ref": "personal-installer-signing-request-v2.schema.json"
        }
      ]
    },
    {
      "$ref": "launcher-enterprise-installer-signing-request-v2.schema.json"
    }
  ]
}

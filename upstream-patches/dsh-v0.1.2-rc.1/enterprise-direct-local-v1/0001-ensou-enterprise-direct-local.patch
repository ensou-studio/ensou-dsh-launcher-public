+/**
+ * Launcher-owned managed replacement control for a running Web profile.
+ * The named pipe carries lifecycle commands only; browser authentication and
+ * model-provider traffic never cross this boundary.
+ * @module @deepseek-ai/dsh/managed-runtime-update
+ */
+
+import { createConnection, type Socket } from 'node:net'
+import { TextDecoder } from 'node:util'
+import type { Context } from '@deepseek-ai/cordis'
+import type { Agent, AgentRegistry } from '@deepseek-ai/dsh-agent'
+import type {} from '@deepseek-ai/dsh-credentials/types'
+import type { LaunchEnvironmentSnapshot } from '@deepseek-ai/dsh-launch-environment'
+import type { Session, SessionStore } from '@deepseek-ai/dsh-session'
+import type {} from '@deepseek-ai/dsh-settings/types'
+import { DIRECT_LOCAL_PROFILE, type ManagedProfile } from './managed-boot.ts'
+import type { ProcessShutdown } from './process-shutdown.ts'
+
+export const UPDATE_PROTOCOL = 'ensou.dsh.runtime-update.v1'
+export const UPDATE_PIPE_ENV = 'ENSOU_DSH_UPDATE_PIPE'
+export const UPDATE_INSTANCE_ENV = 'ENSOU_DSH_RUNTIME_INSTANCE_ID'
+export const PERSONAL_UPDATE_BOOT_ENV = 'ENSOU_DSH_PERSONAL_UPDATE_BOOT'
+export const PERSONAL_UPDATE_BOOT_MARKER = 'ensou-dsh-personal-launcher/v1'
+const MAX_LINE_BYTES = 8 * 1024
+const GUID_D = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/
+
+export type UpdateAction = 'drain' | 'status' | 'resume' | 'shutdown'
+export type UpdatePhase = 'draining' | 'ready' | 'resumed'
+
+export interface UpdateBootstrap {
+  readonly pipePath: string
+  readonly runtimeInstanceId: string
+}
+
+export interface UpdateRequest {
+  readonly protocol: typeof UPDATE_PROTOCOL
+  readonly runtimeInstanceId: string
+  readonly operationId: string
+  readonly action: UpdateAction
+}
+
+export interface UpdateReceipt {
+  readonly protocol: typeof UPDATE_PROTOCOL
+  readonly runtimeInstanceId: string
+  readonly processId: number
+  readonly operationId: string
+  readonly phase: UpdatePhase
+  readonly activeOperations: number
+  readonly persistenceFlushed: boolean
+}
+
+interface MaintenanceLease {
+  readonly release: () => void
+  readonly settled: Promise<void>
+}
+
+interface AdmissionController {
+  suspendAdmission(): Promise<void>
+  resumeAdmission(): Promise<void>
+}
+
+interface DurabilityCheckpoint {
+  durabilityCheckpoint(): Promise<boolean>
+}
+
+/** Narrow runtime capabilities whose owners establish one replacement checkpoint. */
+export interface ManagedUpdateRuntime {
+  readonly suspendAdmission: () => Promise<void>
+  readonly resumeAdmission: () => Promise<void>
+  readonly listAgents: () => readonly Agent[]
+  readonly listSessions: () => readonly Session[]
+  readonly flushSession: (session: Session) => Promise<boolean>
+  readonly checkpointCredentials: () => Promise<boolean>
+  readonly checkpointSettings: () => Promise<boolean>
+  readonly shutdown: () => Promise<void>
+}
+
+/** One parsed command result; shutdown is invoked only after its receipt is written. */
+export interface UpdateCommandResult {
+  readonly receipt: UpdateReceipt
+  readonly shutdownAfterWrite: boolean
+}
+
+/** Resolve an exact, profile-authorized bootstrap from inherited process state. */
+export function resolveUpdateBootstrap(
+  profile: string,
+  managedProfile: ManagedProfile | undefined,
+  environment: LaunchEnvironmentSnapshot,
+): UpdateBootstrap | undefined {
+  const pipe = environment.getFrom(UPDATE_PIPE_ENV, ['process'])
+  const instance = environment.getFrom(UPDATE_INSTANCE_ENV, ['process'])
+  const personal = environment.getFrom(PERSONAL_UPDATE_BOOT_ENV, ['process'])
+  const anyUpdateState = pipe !== undefined || instance !== undefined || personal !== undefined
+  if (!anyUpdateState) return undefined
+
+  const direct = managedProfile === DIRECT_LOCAL_PROFILE
+  const personalWeb = managedProfile === undefined
+    && profile === 'web'
+    && personal?.value === PERSONAL_UPDATE_BOOT_MARKER
+  if (!direct && !personalWeb) {
+    throw new Error('dsh: managed update bootstrap is not authorized for this profile')
+  }
+  if (direct && personal !== undefined) {
+    throw new Error('dsh: enterprise direct-local boot rejects the Personal update marker')
+  }
+  if (pipe === undefined || instance === undefined) {
+    throw new Error('dsh: managed update bootstrap is incomplete')
+  }
+  if (!GUID_D.test(instance.value)) {
+    throw new Error('dsh: managed update runtime instance id is not canonical')
+  }
+  const expectedPipe = `\\\\.\\pipe\\ensou-dsh-update-${instance.value.replaceAll('-', '')}`
+  if (pipe.value !== expectedPipe) {
+    throw new Error('dsh: managed update pipe does not match the runtime instance id')
+  }
+  return { pipePath: pipe.value, runtimeInstanceId: instance.value }
+}
+
+/** Parse one bounded request without accepting inherited properties or extra fields. */
+export function parseUpdateRequest(line: string, runtimeInstanceId: string): UpdateRequest {
+  let value: unknown
+  try {
+    value = JSON.parse(line)
+  } catch {
+    throw new Error('managed update request is not valid JSON')
+  }
+  if (typeof value !== 'object' || value === null || Array.isArray(value)
+    || Object.getPrototypeOf(value) !== Object.prototype) {
+    throw new Error('managed update request must be a plain object')
+  }
+  const record = value as Record<string, unknown>
+  const keys = Object.keys(record).sort()
+  if (keys.join(',') !== 'action,operationId,protocol,runtimeInstanceId') {
+    throw new Error('managed update request has an invalid shape')
+  }
+  if (record.protocol !== UPDATE_PROTOCOL
+    || record.runtimeInstanceId !== runtimeInstanceId
+    || typeof record.operationId !== 'string'
+    || !GUID_D.test(record.operationId)
+    || typeof record.action !== 'string'
+    || !['drain', 'status', 'resume', 'shutdown'].includes(record.action)) {
+    throw new Error('managed update request identity or action is invalid')
+  }
+  const request = record as unknown as UpdateRequest
+  if (line !== JSON.stringify(request)) {
+    throw new Error('managed update request is not canonical')
+  }
+  return request
+}
+
+/**
+ * Lifecycle coordinator independent of transport. Agent creation listeners
+ * call {@link observeAgentCreated} synchronously before the Agent driver starts.
+ */
+export class ManagedUpdateCoordinator {
+  private phase: UpdatePhase = 'resumed'
+  private operationId: string | undefined
+  private generation = 0
+  private dirtyRevision = 0
+  private checkpointTask: Promise<void> | undefined
+  private resumeTask: { readonly generation: number; readonly settled: Promise<void> } | undefined
+  private readonly leases = new Map<Agent, MaintenanceLease>()
+  private disposed = false
+  private shuttingDown = false
+
+  constructor(
+    private readonly runtimeInstanceId: string,
+    private readonly runtime: ManagedUpdateRuntime,
+    private readonly processId = process.pid,
+  ) {}
+
+  /** Fence a newly published Agent synchronously while drain or ready owns admission. */
+  observeAgentCreated(agent: Agent): void {
+    if (this.disposed || (this.phase !== 'draining' && this.phase !== 'ready')) return
+    this.dirtyRevision++
+    this.phase = 'draining'
+    this.tryLease(agent)
+    this.ensureCheckpoint()
+  }
+
+  /** Invalidate a ready checkpoint when a live Session is created or appended. */
+  observeSessionDirty(): void {
+    if (this.disposed || (this.phase !== 'draining' && this.phase !== 'ready')) return
+    this.dirtyRevision++
+    this.phase = 'draining'
+    this.ensureCheckpoint()
+  }
+
+  /** Invalidate ready when a credential or settings owner commits during the final pass. */
+  observePersistenceDirty(): void {
+    this.observeSessionDirty()
+  }
+
+  /** Execute one identity-bound command. */
+  async command(request: UpdateRequest): Promise<UpdateCommandResult> {
+    if (this.disposed || this.shuttingDown) throw new Error('managed update control is unavailable')
+    if (request.runtimeInstanceId !== this.runtimeInstanceId) {
+      throw new Error('managed update runtime identity mismatch')
+    }
+    if (request.action === 'drain') {
+      if (this.phase === 'resumed') {
+        this.operationId = request.operationId
+        this.phase = 'draining'
+        this.generation++
+        this.dirtyRevision++
+        this.ensureCheckpoint()
+      } else {
+        this.assertOperation(request.operationId)
+      }
+      return { receipt: this.receipt(request.operationId), shutdownAfterWrite: false }
+    }
+
+    this.assertOperation(request.operationId)
+    if (request.action === 'status') {
+      return { receipt: this.receipt(request.operationId), shutdownAfterWrite: false }
+    }
+    if (request.action === 'resume') {
+      await this.resume(request.operationId)
+      return { receipt: this.receipt(request.operationId), shutdownAfterWrite: false }
+    }
+    if (this.phase !== 'ready') throw new Error('managed update shutdown requires a ready checkpoint')
+    this.shuttingDown = true
+    return { receipt: this.receipt(request.operationId), shutdownAfterWrite: true }
+  }
+
+  /** Run graceful whole-tree disposal after the ready receipt reaches the pipe. */
+  async shutdownAfterReceipt(): Promise<void> {
+    if (!this.shuttingDown || this.phase !== 'ready') {
+      throw new Error('managed update shutdown was not committed')
+    }
+    await this.runtime.shutdown()
+  }
+
+  /** Pipe loss restores exact held owners; it never terminates another process. */
+  async disconnect(): Promise<void> {
+    if (this.disposed || this.shuttingDown || this.phase === 'resumed') return
+    const operationId = this.operationId
+    if (operationId !== undefined) await this.resume(operationId).catch(() => undefined)
+  }
+
+  /** Release maintenance holds during root teardown without reopening the listener. */
+  dispose(): void {
+    if (this.disposed) return
+    this.disposed = true
+    this.generation++
+    this.releaseLeases()
+  }
+
+  private ensureCheckpoint(): void {
+    if (this.checkpointTask !== undefined || this.operationId === undefined) return
+    const generation = this.generation
+    const task = this.checkpoint(generation).finally(() => {
+      if (this.checkpointTask !== task) return
+      this.checkpointTask = undefined
+      if (!this.disposed && this.phase === 'draining' && generation === this.generation) {
+        this.ensureCheckpoint()
+      }
+    })
+    this.checkpointTask = task
+    void task.catch(() => undefined)
+  }
+
+  private async checkpoint(generation: number): Promise<void> {
+    try {
+      await this.runtime.suspendAdmission()
+      while (this.isCurrent(generation)) {
+        await this.fenceEveryAgent(generation)
+        if (!this.isCurrent(generation)) return
+        const revision = this.dirtyRevision
+        if (!await this.runtime.checkpointCredentials()) {
+          throw new Error('credential durability checkpoint is unsupported')
+        }
+        if (!await this.runtime.checkpointSettings()) {
+          throw new Error('settings durability checkpoint is unsupported')
+        }
+        for (const session of this.runtime.listSessions()) {
+          if (!await this.runtime.flushSession(session)) {
+            throw new Error('session durability checkpoint is unsupported')
+          }
+        }
+        if (!this.isCurrent(generation)) return
+        await Promise.resolve()
+        if (revision !== this.dirtyRevision || !this.everyAgentLeased()) continue
+        this.phase = 'ready'
+        return
+      }
+    } catch {
+      if (!this.isCurrent(generation)) return
+      await this.restoreAfterCheckpointFailure(generation)
+    }
+  }
+
+  private async fenceEveryAgent(generation: number): Promise<void> {
+    while (this.isCurrent(generation)) {
+      const pending: Promise<void>[] = []
+      for (const agent of this.runtime.listAgents()) {
+        if (this.leases.has(agent) || this.tryLease(agent)) continue
+        pending.push(agent.whenIdle())
+      }
+      if (pending.length === 0 && this.everyAgentLeased()) return
+      await Promise.all(pending)
+    }
+  }
+
+  /** True means the claim happened synchronously in this stack. */
+  private tryLease(agent: Agent): boolean {
+    if (this.leases.has(agent)) return true
+    const hold = Promise.withResolvers<void>()
+    let settled: Promise<void>
+    try {
+      settled = agent.runMaintenance(async () => { await hold.promise })
+    } catch {
+      return false
+    }
+    const release = (): void => { hold.resolve() }
+    this.leases.set(agent, { release, settled })
+    void settled.catch(() => undefined).finally(() => {
+      if (this.leases.get(agent)?.settled === settled) this.leases.delete(agent)
+    })
+    return true
+  }
+
+  private everyAgentLeased(): boolean {
+    return this.runtime.listAgents().every(agent => this.leases.has(agent))
+  }
+
+  private isCurrent(generation: number): boolean {
+    return !this.disposed && this.phase === 'draining' && generation === this.generation
+  }
+
+  private async restoreAfterCheckpointFailure(generation: number): Promise<void> {
+    await this.restoreAdmission(generation).catch(() => undefined)
+  }
+
+  private async resume(operationId: string): Promise<void> {
+    this.assertOperation(operationId)
+    if (this.phase === 'resumed') return
+    const generation = this.generation
+    await this.restoreAdmission(generation)
+  }
+
+  /** Join the one admission restore that owns this drain generation. */
+  private restoreAdmission(generation: number): Promise<void> {
+    const existing = this.resumeTask
+    if (existing !== undefined) {
+      if (existing.generation !== generation) {
+        return Promise.reject(new Error('managed update resume lost ownership'))
+      }
+      return existing.settled
+    }
+    if (this.disposed
+      || generation !== this.generation
+      || (this.phase !== 'draining' && this.phase !== 'ready')) {
+      return Promise.reject(new Error('managed update resume lost ownership'))
+    }
+    const restoring = (async () => {
+      await this.runtime.resumeAdmission()
+      if (this.disposed
+        || generation !== this.generation
+        || (this.phase !== 'draining' && this.phase !== 'ready')) {
+        throw new Error('managed update resume lost ownership')
+      }
+      this.generation++
+      this.checkpointTask = undefined
+      this.releaseLeases()
+      this.phase = 'resumed'
+    })()
+    const settled = restoring.finally(() => {
+      if (this.resumeTask?.settled === settled) this.resumeTask = undefined
+    })
+    this.resumeTask = { generation, settled }
+    return settled
+  }
+
+  private releaseLeases(): void {
+    for (const lease of this.leases.values()) lease.release()
+    this.leases.clear()
+  }
+
+  private assertOperation(operationId: string): void {
+    if (this.operationId !== operationId) throw new Error('managed update operation identity mismatch')
+  }
+
+  private receipt(operationId: string): UpdateReceipt {
+    const activeOperations = this.phase === 'draining'
+      ? this.runtime.listAgents().filter(agent => !this.leases.has(agent)).length
+      : 0
+    return {
+      protocol: UPDATE_PROTOCOL,
+      runtimeInstanceId: this.runtimeInstanceId,
+      processId: this.processId,
+      operationId,
+      phase: this.phase,
+      activeOperations,
+      persistenceFlushed: this.phase === 'ready',
+    }
+  }
+}
+
+/** One bounded newline-framed client connection to the Host pipe. */
+export class ManagedUpdatePipeClient {
+  private socket: Socket | undefined
+  private bytes = Buffer.alloc(0)
+  private readonly decoder = new TextDecoder('utf-8', { fatal: true })
+  private queue = Promise.resolve()
+  private closing = false
+
+  constructor(
+    private readonly bootstrap: UpdateBootstrap,
+    private readonly coordinator: ManagedUpdateCoordinator,
+  ) {}
+
+  /** Connect before app readiness is committed. */
+  async start(): Promise<void> {
+    const socket = createConnection(this.bootstrap.pipePath)
+    this.socket = socket
+    socket.on('data', (chunk) => { this.receive(Buffer.from(chunk)) })
+    socket.once('close', () => {
+      if (!this.closing) void this.coordinator.disconnect()
+    })
+    socket.once('error', () => {
+      if (!this.closing) void this.coordinator.disconnect()
+    })
+    await new Promise<void>((resolve, reject) => {
+      const onConnect = (): void => {
+        socket.off('error', onError)
+        resolve()
+      }
+      const onError = (): void => {
+        socket.off('connect', onConnect)
+        reject(new Error('dsh: managed update pipe connection failed'))
+      }
+      socket.once('connect', onConnect)
+      socket.once('error', onError)
+    })
+  }
+
+  /** Close the private channel and release coordinator-owned holds. */
+  dispose(): void {
+    this.closing = true
+    this.socket?.destroy()
+    this.coordinator.dispose()
+  }
+
+  private receive(chunk: Buffer): void {
+    if (this.closing) return
+    if (this.bytes.length + chunk.length > MAX_LINE_BYTES + 1) {
+      this.failConnection()
+      return
+    }
+    this.bytes = Buffer.concat([this.bytes, chunk])
+    if (this.bytes.length > MAX_LINE_BYTES && !this.bytes.includes(0x0a)) {
+      this.failConnection()
+      return
+    }
+    while (true) {
+      const newline = this.bytes.indexOf(0x0a)
+      if (newline === -1) return
+      if (newline > MAX_LINE_BYTES) {
+        this.failConnection()
+        return
+      }
+      const frame = this.bytes.subarray(0, newline)
+      this.bytes = this.bytes.subarray(newline + 1)
+      let line: string
+      try {
+        line = this.decoder.decode(frame)
+      } catch {
+        this.failConnection()
+        return
+      }
+      this.queue = this.queue.then(() => this.handleLine(line)).catch(() => { this.failConnection() })
+    }
+  }
+
+  private async handleLine(line: string): Promise<void> {
+    const socket = this.socket
+    if (socket === undefined || this.closing) return
+    const request = parseUpdateRequest(line, this.bootstrap.runtimeInstanceId)
+    const result = await this.coordinator.command(request)
+    await new Promise<void>((resolve, reject) => {
+      socket.write(`${JSON.stringify(result.receipt)}\n`, (error) => {
+        if (error == null) resolve(); else reject(error)
+      })
+    })
+    if (result.shutdownAfterWrite) {
+      this.closing = true
+      await this.coordinator.shutdownAfterReceipt()
+    }
+  }
+
+  private failConnection(): void {
+    if (this.closing) return
+    this.closing = true
+    this.socket?.destroy()
+    void this.coordinator.disconnect()
+  }
+}
+
+/** Install listeners before entries mount, then connect after the tree is ready. */
+export function createManagedRuntimeUpdate(
+  ctx: Context,
+  bootstrap: UpdateBootstrap,
+  shutdown: ProcessShutdown,
+): ManagedUpdatePipeClient {
+  const required = (name: string): unknown => {
+    const service = (ctx as unknown as { get(key: string): unknown }).get(name)
+    if (service === undefined) throw new Error(`dsh: managed update requires ${name}`)
+    return service
+  }
+  const runtime: ManagedUpdateRuntime = {
+    suspendAdmission: () => (required('webServer') as AdmissionController).suspendAdmission(),
+    resumeAdmission: () => (required('webServer') as AdmissionController).resumeAdmission(),
+    listAgents: () => (required('agents') as AgentRegistry).list(),
+    listSessions: () => (required('sessions') as SessionStore).list(),
+    flushSession: session => (required('sessions') as SessionStore).flush(session),
+    checkpointCredentials: () => (required('credentials') as DurabilityCheckpoint).durabilityCheckpoint(),
+    checkpointSettings: () => (required('settings') as DurabilityCheckpoint).durabilityCheckpoint(),
+    shutdown: () => shutdown.shutdown(0),
+  }
+  const coordinator = new ManagedUpdateCoordinator(bootstrap.runtimeInstanceId, runtime)
+  ctx.on('agent/created', ({ agent }) => { coordinator.observeAgentCreated(agent) }, { global: true })
+  ctx.on('session/created', () => { coordinator.observeSessionDirty() }, { global: true })
+  ctx.on('session/event', () => { coordinator.observeSessionDirty() }, { global: true })
+  ctx.on('credentials/reference-updated', () => { coordinator.observePersistenceDirty() }, { global: true })
+  ctx.on('credentials/record-updated', () => { coordinator.observePersistenceDirty() }, { global: true })
+  ctx.on('settings/document-updated', () => { coordinator.observePersistenceDirty() }, { global: true })
+  return new ManagedUpdatePipeClient(bootstrap, coordinator)
+}

@@ -0,0 +1,791 @@
+/**
+ * Fail-closed composition policy for the Launcher-owned enterprise profile.
+ * Normal profiles never enter this module's managed path.
+ * @module @deepseek-ai/dsh/managed-boot
+ */
+
+import { lstatSync, readFileSync, readdirSync, realpathSync } from 'node:fs'
+import { createHash } from 'node:crypto'
+import { dirname, isAbsolute, join, normalize, parse, relative, resolve, sep } from 'node:path'
+import { fileURLToPath } from 'node:url'
+import { load } from 'js-yaml'
+import { entryListSchema, type PatchOptions } from '@deepseek-ai/cordis-plugin-include'
+import type { EntryOptions } from '@deepseek-ai/cordis-plugin-loader'
+import type { Profile } from '@deepseek-ai/dsh-app-boot'
+import type { LaunchEnvironmentSnapshot } from '@deepseek-ai/dsh-launch-environment'
+
+/** Inherited-process signal supplied by the enterprise Launcher. */
+export const MANAGED_BOOT_SIGNAL = 'DSH_ENTERPRISE_MANAGED_BOOT'
+
+/** Exact signal value understood by this runtime generation. */
+export const MANAGED_BOOT_SIGNAL_VALUE = 'ensou-dsh-launcher/v1'
+
+/** Reserved profile name used only with the exact managed signal. */
+export const MANAGED_PROFILE = 'enterprise-managed'
+
+/** The only installation-owned bundle tuple accepted for the managed host. */
+export const MANAGED_PROFILE_BUNDLES = ['@deepseek-ai/dsh-base', '@deepseek-ai/dsh-web-app'] as const
+
+/** The only preset id exposed by the managed roster. */
+export const MANAGED_PRESET = 'enterprise'
+
+/** The only model id advertised and selected by the managed runtime. */
+export const MANAGED_MODEL = 'deepseek-v4-flash'
+
+/** The fixed managed output budget; the control Gateway must enforce the same cap. */
+export const MANAGED_MAX_TOKENS = 8192
+
+/** Launcher-owned root containing the skills exposed to managed sessions. */
+export const MANAGED_SKILLS_ROOT_ENV = 'ENSOU_DSH_ENTERPRISE_SKILLS_ROOT'
+
+/** Launcher-controlled local model proxy variables. */
+const MANAGED_PROXY_BASE_URL = 'DEEPSEEK_BASE_URL'
+const MANAGED_PROXY_SEARCH_BASE_URL = 'DEEPSEEK_SEARCH_BASE_URL'
+const MANAGED_PROXY_BEARER = 'DEEPSEEK_API_KEY'
+
+/** Installation-owned preset root, outside the writable Harness home. */
+export const MANAGED_PRESET_ROOT = fileURLToPath(new URL('../config/managed-agent-presets/', import.meta.url))
+
+/** Installation-owned empty Loader root; it anchors plugin resolution outside the writable profile. */
+export const MANAGED_ROOT_CONFIG = fileURLToPath(new URL('../config/managed-profile/cordis.yml', import.meta.url))
+
+/**
+ * Resolve whether one profile boot is the enterprise managed boot.
+ * Presence of a wrong or mismatched signal fails instead of falling back to
+ * the normal composition path.
+ * @param profile - requested profile name.
+ * @param patchFiles - command-line overlays requested for this invocation.
+ * @param environment - frozen launch environment with source provenance.
+ * @returns true only for the exact Launcher signal and reserved profile pair.
+ */
+export function resolveManagedBoot(
+  profile: string,
+  patchFiles: readonly string[],
+  environment: LaunchEnvironmentSnapshot,
+): boolean {
+  const signal = environment.getFrom(MANAGED_BOOT_SIGNAL, ['process'])
+  if (signal === undefined) {
+    if (profile === MANAGED_PROFILE) {
+      throw new Error(`dsh: profile ${JSON.stringify(MANAGED_PROFILE)} requires the enterprise Launcher`)
+    }
+    return false
+  }
+  if (signal.value !== MANAGED_BOOT_SIGNAL_VALUE) {
+    throw new Error(`dsh: unsupported ${MANAGED_BOOT_SIGNAL} value`)
+  }
+  if (profile !== MANAGED_PROFILE) {
+    throw new Error(
+      `dsh: ${MANAGED_BOOT_SIGNAL} may boot only profile ${JSON.stringify(MANAGED_PROFILE)}`,
+    )
+  }
+  if (patchFiles.length > 0) {
+    throw new Error('dsh: --patch is disabled for the enterprise managed profile')
+  }
+  assertManagedProxyEnvironment(environment)
+  return true
+}
+
+/**
+ * Validate the exact loopback proxy values emitted by the enterprise Launcher.
+ * @param environment - frozen launch environment with source provenance.
+ */
+export function assertManagedProxyEnvironment(environment: LaunchEnvironmentSnapshot): void {
+  const baseEntry = environment.getFrom(MANAGED_PROXY_BASE_URL, ['process'])
+  const searchEntry = environment.getFrom(MANAGED_PROXY_SEARCH_BASE_URL, ['process'])
+  const bearerEntry = environment.getFrom(MANAGED_PROXY_BEARER, ['process'])
+  if (baseEntry === undefined || searchEntry === undefined || bearerEntry === undefined) {
+    throw new Error('dsh: enterprise Launcher did not provide the complete loopback model proxy environment')
+  }
+  let base: URL
+  try {
+    base = new URL(baseEntry.value)
+  } catch {
+    throw new Error('dsh: enterprise Launcher provided an invalid loopback model proxy URL')
+  }
+  if (base.protocol !== 'http:' || base.hostname !== '127.0.0.1' || base.port === ''
+    || base.username !== '' || base.password !== '' || base.pathname !== '/v1'
+    || base.search !== '' || base.hash !== '') {
+    throw new Error('dsh: enterprise model proxy must be an exact 127.0.0.1 HTTP /v1 endpoint')
+  }
+  if (searchEntry.value !== baseEntry.value) {
+    throw new Error('dsh: enterprise search endpoint must equal the loopback model proxy endpoint')
+  }
+  const bearer = bearerEntry.value
+  if (!/^[A-Za-z0-9_-]{43}$/.test(bearer)) {
+    throw new Error('dsh: enterprise model proxy bearer must be a canonical 32-byte base64url token')
+  }
+  const bytes = Buffer.from(bearer, 'base64url')
+  if (bytes.length !== 32 || bytes.toString('base64url') !== bearer) {
+    throw new Error('dsh: enterprise model proxy bearer must be a canonical 32-byte base64url token')
+  }
+}
+
+/**
+ * Resolve the one Launcher-owned skill directory accepted by managed mode.
+ * Every existing path component must be its exact filesystem spelling and
+ * must resolve without a symbolic-link, junction, or other path redirection.
+ * @param environment - frozen launch environment with source provenance.
+ * @returns the validated canonical fully-qualified directory.
+ */
+export function resolveManagedSkillsRoot(environment: LaunchEnvironmentSnapshot): string {
+  const entry = environment.getFrom(MANAGED_SKILLS_ROOT_ENV, ['process'])
+  if (entry === undefined) {
+    throw new Error(`dsh: enterprise Launcher did not provide ${MANAGED_SKILLS_ROOT_ENV}`)
+  }
+  const root = entry.value
+  if (root.includes('\0')) {
+    throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} may not contain NUL`)
+  }
+  if (!isAbsolute(root) || resolve(root) !== root || normalize(root) !== root) {
+    throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} must be an exact canonical fully-qualified path`)
+  }
+
+  const pathRoot = parse(root).root
+  const suffix = relative(pathRoot, root)
+  const components = suffix === '' ? [] : suffix.split(sep)
+  let current = pathRoot
+  let finalIsDirectory = false
+  for (const component of [undefined, ...components] as Array<string | undefined>) {
+    if (component !== undefined) current = join(current, component)
+    try {
+      const status = lstatSync(current)
+      if (status.isSymbolicLink()) {
+        throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} may not contain reparse points or path aliases`)
+      }
+      if (current === root) finalIsDirectory = status.isDirectory()
+    } catch (error) {
+      if (error instanceof Error && error.message.startsWith('dsh:')) throw error
+      throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} must name an existing directory without reparse points`)
+    }
+  }
+  let physical: string
+  try {
+    physical = realpathSync.native(root)
+  } catch {
+    throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} must name an existing directory without reparse points`)
+  }
+  if (physical !== root) {
+    throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} may not contain reparse points or path aliases`)
+  }
+  if (!finalIsDirectory) {
+    throw new Error(`dsh: ${MANAGED_SKILLS_ROOT_ENV} must name an existing directory`)
+  }
+  return root
+}
+
+/**
+ * Refuse plugin management and config dumps for the reserved profile, and
+ * refuse every auxiliary mode while the managed Launcher signal is present.
+ * @param profile - profile named by the auxiliary invocation.
+ * @param inheritedSignal - raw inherited-process signal before any env file is loaded.
+ */
+export function assertAuxiliaryInvocationAllowed(profile: string, inheritedSignal: string | undefined): void {
+  if (profile === MANAGED_PROFILE || inheritedSignal !== undefined) {
+    throw new Error('dsh: plugin management and config dumps are disabled for enterprise managed launches')
+  }
+}
+
+/**
+ * Accept only the enterprise Launcher's exact Web bind tuple. The strict token
+ * shape rejects aliases, repeats, trusted-host expansion, help, and every
+ * unrelated app argument before any host plugin mounts.
+ * @param args - inner Web arguments passed through the top-level CLI parser.
+ * @returns the validated canonical port number.
+ */
+export function assertManagedWebArguments(args: readonly string[]): number {
+  if (args.length !== 4 || args[0] !== '--host' || args[1] !== '127.0.0.1' || args[2] !== '--port') {
+    throw new Error('dsh: enterprise Launcher must provide exactly --host 127.0.0.1 --port <canonical-port>')
+  }
+  const rawPort = args[3] as string
+  if (!/^[1-9][0-9]{0,4}$/.test(rawPort)) {
+    throw new Error('dsh: enterprise Launcher port must be a canonical integer from 1 through 65535')
+  }
+  const port = Number(rawPort)
+  if (port > 65535 || String(port) !== rawPort) {
+    throw new Error('dsh: enterprise Launcher port must be a canonical integer from 1 through 65535')
+  }
+  return port
+}
+

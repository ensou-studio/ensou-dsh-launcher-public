{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://updates.dsh.example.invalid/schemas/personal-two-clean-build-intent-v1.schema.json",
  "title": "Ensou DSH Personal two-clean production build intent v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "intentType",
    "buildIntentId",
    "sourceCommit",
    "sourceTree",
    "version",
    "configuration",
    "runtimeIdentifier",
    "selfContained",
    "publishSingleFile",
    "enableCompressionInSingleFile",
    "manifestOrigin",
    "artifactOrigin",
    "personalAccountOrigin",
    "channel",
    "releaseManifestTrust",
    "startupStubVersion",
    "canonicalLowSFromSequence",
    "authenticodeSignerSha256Thumbprint"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "intentType": {
      "const": "ensou-dsh-personal-two-clean-production-build-intent"
    },
    "buildIntentId": { "$ref": "#/definitions/uuidV4" },
    "sourceCommit": { "$ref": "#/definitions/gitObject" },
    "sourceTree": { "$ref": "#/definitions/gitObject" },
    "version": { "$ref": "#/definitions/version" },
    "configuration": { "const": "Release" },
    "runtimeIdentifier": { "const": "win-x64" },
    "selfContained": { "const": true },
    "publishSingleFile": { "const": true },
    "enableCompressionInSingleFile": { "const": true },
    "manifestOrigin": { "$ref": "#/definitions/httpsOrigin" },
    "artifactOrigin": { "$ref": "#/definitions/httpsOrigin" },
    "personalAccountOrigin": { "$ref": "#/definitions/httpsAccountOrigin" },
    "channel": { "const": "pilot" },
    "releaseManifestTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "x", "y"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/keyId" },
        "purpose": { "const": "release-manifest-signing" },
        "x": { "$ref": "#/definitions/p256Coordinate" },
        "y": { "$ref": "#/definitions/p256Coordinate" }
      }
    },
    "startupStubVersion": { "$ref": "#/definitions/version" },
    "canonicalLowSFromSequence": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "authenticodeSignerSha256Thumbprint": { "$ref": "#/definitions/sha256" }
  },
  "definitions": {
    "uuidV4": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "gitObject": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^[0-9]+[.][0-9]+[.][0-9]+(?:[-+][0-9A-Za-z][0-9A-Za-z.-]*)?$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "p256Coordinate": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "httpsOrigin": {
      "type": "string",
      "minLength": 12,
      "maxLength": 512,
      "pattern": "^https://[^/?#\\s]+(?::[0-9]{1,5})?/$"
    },
    "httpsAccountOrigin": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512,
      "pattern": "^https://(?!(?:localhost|[0-9]{1,3}(?:\\.[0-9]{1,3}){3})/)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?))*/$"
    }
  }
}

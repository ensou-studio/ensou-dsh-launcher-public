{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://updates.ensou.example/schemas/enterprise-plugin-promotion-journal-authorization-v1.schema.json",
  "title": "Ensou DSH enterprise plugin promotion journal authorization v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "authorizationType", "authorizationId", "journalInstanceId", "expectedStateRevision", "expectedHeadSha256", "issuedAtUtc", "expiresAtUtc", "intent", "signature"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "authorizationType": { "const": "managed-plugin-promotion-journal-authorization" },
    "authorizationId": { "$ref": "#/$defs/uuid" },
    "journalInstanceId": { "$ref": "#/$defs/uuid" },
    "expectedStateRevision": { "$ref": "#/$defs/nonNegativeSafeInteger" },
    "expectedHeadSha256": { "$ref": "#/$defs/sha256" },
    "issuedAtUtc": { "$ref": "#/$defs/wholeSecondOffsetUtc" },
    "expiresAtUtc": { "$ref": "#/$defs/wholeSecondOffsetUtc" },
    "intent": { "$ref": "#/$defs/intent" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "nonNegativeSafeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveSafeInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "releaseId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
    "wholeSecondOffsetUtc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{7}[+]00:00$" },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "releaseId", "uri", "sizeBytes", "sha256", "completeTreeSha256"],
      "properties": {
        "component": { "enum": ["launcher", "runtime", "plugin-policy"] },
        "releaseId": { "$ref": "#/$defs/releaseId" },
        "uri": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "completeTreeSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["environment", "channel", "releaseSetId", "releaseSigningKeyId", "generation", "sequence", "minAcceptedSequence", "launcher", "runtime", "pluginPolicy", "policyId", "policyGeneration", "pluginMetadataSha256", "rawPolicySha256", "promotionHandoffSha256", "compatibilityReceiptSha256", "reservationSha256", "runtimeSourceMetadataSha256", "generationLedgerNamespace", "generationLedgerPathSha256", "generationLedgerSha256", "organizationAdmissionReceiptSha256"],
      "properties": {
        "environment": { "const": "production" },
        "channel": { "type": "string", "minLength": 1, "maxLength": 64 },
        "releaseSetId": { "$ref": "#/$defs/releaseId" },
        "releaseSigningKeyId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
        "generation": { "$ref": "#/$defs/positiveSafeInteger" },
        "sequence": { "$ref": "#/$defs/positiveSafeInteger" },
        "minAcceptedSequence": { "$ref": "#/$defs/nonNegativeSafeInteger" },
        "launcher": { "$ref": "#/$defs/artifact" },
        "runtime": { "$ref": "#/$defs/artifact" },
        "pluginPolicy": { "$ref": "#/$defs/artifact" },
        "policyId": { "$ref": "#/$defs/uuid" },
        "policyGeneration": { "$ref": "#/$defs/positiveSafeInteger" },
        "pluginMetadataSha256": { "$ref": "#/$defs/sha256" },
        "rawPolicySha256": { "$ref": "#/$defs/sha256" },
        "promotionHandoffSha256": { "$ref": "#/$defs/sha256" },
        "compatibilityReceiptSha256": { "$ref": "#/$defs/sha256" },
        "reservationSha256": { "$ref": "#/$defs/sha256" },
        "runtimeSourceMetadataSha256": { "$ref": "#/$defs/sha256" },
        "generationLedgerNamespace": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$" },
        "generationLedgerPathSha256": { "$ref": "#/$defs/sha256" },
        "generationLedgerSha256": { "$ref": "#/$defs/sha256" },
        "organizationAdmissionReceiptSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{86}$" }
      }
    }
  }
}

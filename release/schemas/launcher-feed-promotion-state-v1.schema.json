{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher offline feed-promotion state v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stateType",
    "operationId",
    "requestSha256",
    "requestNonce",
    "sourceStateHeadSha256",
    "payloadSetSha256",
    "status",
    "productionAdmission",
    "networkPublishPerformed",
    "updatedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "stateType": {
      "const": "ensou-dsh-launcher-offline-feed-promotion-state"
    },
    "operationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "requestSha256": { "$ref": "#/definitions/sha256" },
    "requestNonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "sourceStateHeadSha256": { "$ref": "#/definitions/sha256" },
    "payloadSetSha256": { "$ref": "#/definitions/sha256" },
    "status": { "const": "PROMOTION_REQUEST_READY" },
    "productionAdmission": { "const": "NO_GO" },
    "networkPublishPerformed": { "const": false },
    "updatedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" }
  },
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wholeSecondUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

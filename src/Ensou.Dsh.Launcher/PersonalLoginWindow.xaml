<Window x:Class="Ensou.Dsh.Launcher.PersonalLoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 Personal 内测" Width="480" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" Foreground="{StaticResource TextBrush}">
  <StackPanel Margin="32">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
      <Border Background="White" Width="44" Height="44" Padding="7" CornerRadius="12">
        <Image Source="/Ensou.Dsh.Launcher;component/Assets/dsh-official-whale.png" Stretch="Uniform" />
      </Border>
      <StackPanel Margin="14,0,0,0">
        <TextBlock Text="Personal 内测" FontSize="23" FontWeight="SemiBold" />
        <TextBlock Text="ENSOU DSH LAUNCHER" FontSize="10" Foreground="{StaticResource MutedTextBrush}" />
      </StackPanel>
    </StackPanel>
    <TextBlock Text="使用你已登记的邮箱登录" FontSize="17" FontWeight="SemiBold" />
    <TextBlock Text="仅向已获批准的邮箱发送验证码。尚未登记，请联系 ensou。"
               Margin="0,8,0,18" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
    <Label Content="邮箱地址" Target="{Binding ElementName=EmailInput}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,6" />
    <TextBox x:Name="EmailInput" MaxLength="254" FontSize="15" Padding="10"
             Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}"
             BorderBrush="{StaticResource MutedTextBrush}" TextChanged="EmailInput_TextChanged"
             AutomationProperties.Name="已登记的邮箱地址" />
    <Button x:Name="RequestCodeButton" Content="发送验证码" Margin="0,12,0,20"
            Style="{StaticResource SecondaryButton}" Click="RequestCodeButton_Click" />
    <Label Content="六位验证码" Target="{Binding ElementName=CodeInput}" Foreground="{StaticResource TextBrush}" Padding="0,0,0,6" />
    <PasswordBox x:Name="CodeInput" MaxLength="6" FontSize="18" Padding="10"
                 Background="{StaticResource PanelRaisedBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource MutedTextBrush}" AutomationProperties.Name="六位邮箱验证码" />
    <TextBlock x:Name="MessageText" Text="验证码不会替代你单独配置的模型 token。"
               MinHeight="48" Margin="0,14,0,8" TextWrapping="Wrap"
               Foreground="{StaticResource MutedTextBrush}" AutomationProperties.LiveSetting="Polite" />
    <Button x:Name="SignInButton" Content="验证并登录" IsDefault="True" Click="SignInButton_Click" />
    <Button Content="暂不登录" IsCancel="True" Margin="0,10,0,0" Style="{StaticResource SecondaryButton}" />
    <TextBlock Text="聊天和工作区留在本机。未登录时仍可更新和恢复。"
               Margin="0,20,0,0" FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
  </StackPanel>
</Window>

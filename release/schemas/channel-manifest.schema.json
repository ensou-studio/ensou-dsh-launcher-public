{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensou.example/schemas/dsh/channel-manifest.schema.json",
  "title": "Ensou DSH managed update channel manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "releaseId",
    "channel",
    "launcherVersion",
    "dshVersion",
    "publishedAtUtc",
    "minimumBootstrapperVersion",
    "artifact",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "releaseId": {
      "type": "string",
      "pattern": "^managed-v[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[1-9][0-9]*$"
    },
    "channel": {
      "enum": ["lab", "pilot", "stable"]
    },
    "launcherVersion": {
      "description": "Minimum Launcher version compatible with this DSH runtime. This manifest does not update Launcher.",
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "dshVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "publishedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{7}Z$"
    },
    "minimumBootstrapperVersion": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "fileName", "sizeBytes", "sha256"],
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://[A-Za-z0-9._~:/?\\[\\]@!$&'()*+,;=%-]+$"
        },
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 180,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": {
          "const": "ES256"
        },
        "keyId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  }
}

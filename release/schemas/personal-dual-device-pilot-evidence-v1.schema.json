{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://updates.dsh.example.invalid/schemas/personal-dual-device-pilot-evidence-v1.schema.json",
  "title": "Ensou DSH Personal dual-device Pilot evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "product",
    "environment",
    "planSha256",
    "releaseSetId",
    "reproducibleBuild",
    "candidateClosure",
    "candidateClosureSha256",
    "devices",
    "completedAtUtc",
    "overallResult"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": { "const": "ensou-dsh-personal-dual-device-pilot-evidence" },
    "product": { "const": "ensou-dsh-personal" },
    "environment": { "const": "production-pilot" },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "releaseSetId": { "$ref": "#/definitions/releaseSetId" },
    "reproducibleBuild": { "$ref": "#/definitions/reproducibleBuild" },
    "candidateClosure": { "$ref": "#/definitions/candidateClosure" },
    "candidateClosureSha256": { "$ref": "#/definitions/sha256" },
    "devices": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": [
        { "$ref": "#/definitions/existingUpgradeDevice" },
        { "$ref": "#/definitions/cleanInstallDevice" }
      ],
      "additionalItems": false
    },
    "completedAtUtc": { "$ref": "#/definitions/utcTimestamp" },
    "overallResult": { "const": "PASS" }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "uuidV4": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "releaseSetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "minLength": 28,
      "maxLength": 28,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{7}Z$"
    },
    "evidenceFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sizeBytes", "sha256"],
      "properties": {
        "relativePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 52428800
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "candidateComponent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "relativePath", "sizeBytes", "sha256"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "relativePath": {
          "type": "string",
          "minLength": 11,
          "maxLength": 512,
          "pattern": "^candidate/[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8589934592
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "candidateClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installer", "manifest", "client", "runtime"],
      "properties": {
        "installer": {
          "allOf": [
            { "$ref": "#/definitions/candidateComponent" },
            {
              "properties": {
                "fileName": { "const": "Ensou.Dsh.Personal.Installer.exe" },
                "relativePath": { "const": "candidate/Ensou.Dsh.Personal.Installer.exe" }
              }
            }
          ]
        },
        "manifest": {
          "allOf": [
            { "$ref": "#/definitions/candidateComponent" },
            {
              "properties": {
                "fileName": { "const": "release-set.v2.json" },
                "relativePath": { "const": "candidate/release-set.v2.json" }
              }
            }
          ]
        },
        "client": { "$ref": "#/definitions/candidateComponent" },
        "runtime": { "$ref": "#/definitions/candidateComponent" }
      }
    },
    "reproducibleBuild": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "sourceCommit",
        "sourceTree",
        "sdkVersion",
        "receipt",
        "result"
      ],
      "properties": {
        "contract": { "const": "two-clean-four-client-builds-v1" },
        "sourceCommit": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "sourceTree": {
          "type": "string",
          "minLength": 40,
          "maxLength": 64,
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "sdkVersion": { "const": "10.0.302" },
        "receipt": {
          "allOf": [
            { "$ref": "#/definitions/evidenceFile" },
            { "properties": { "relativePath": { "const": "builds/two-clean-build-evidence.v1.json" } } }
          ]
        },
        "result": { "const": "PASS" }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkId",
        "deviceId",
        "installationId",
        "identityReceiptSha256",
        "candidateClosureSha256",
        "observedAtUtc",
        "source",
        "result",
        "evidence"
      ],
      "properties": {
        "checkId": {
          "enum": [
            "first-install",
            "existing-version-upgrade",
            "startup-update-detection",
            "runtime-only-update",
            "launcher-only-update",
            "failed-update-rollback",
            "offline-last-known-good",
            "local-chat-and-workspace-unchanged",
            "no-command-window"
          ]
        },
        "deviceId": { "enum": ["pilot-desktop-desktop", "pilot-notebook"] },
        "installationId": { "$ref": "#/definitions/uuidV4" },
        "identityReceiptSha256": { "$ref": "#/definitions/sha256" },
        "candidateClosureSha256": { "$ref": "#/definitions/sha256" },
        "observedAtUtc": { "$ref": "#/definitions/utcTimestamp" },
        "source": { "const": "real-device" },
        "result": { "const": "PASS" },
        "evidence": { "$ref": "#/definitions/evidenceFile" }
      }
    },
    "device": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deviceId",
        "hostLabel",
        "lane",
        "lanePrecondition",
        "installationId",
        "identityReceipt",
        "results"
      ],
      "properties": {
        "deviceId": { "enum": ["pilot-desktop-desktop", "pilot-notebook"] },
        "hostLabel": { "enum": ["PILOT-DESKTOP", "PilotNotebook notebook"] },
        "lane": { "enum": ["existing-install-upgrade", "clean-first-install"] },
        "lanePrecondition": { "$ref": "#/definitions/evidenceFile" },
        "installationId": { "$ref": "#/definitions/uuidV4" },
        "identityReceipt": { "$ref": "#/definitions/evidenceFile" },
        "results": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "existingUpgradeDevice": {
      "allOf": [
        { "$ref": "#/definitions/device" },
        {
          "properties": {
            "deviceId": { "const": "pilot-desktop-desktop" },
            "hostLabel": { "const": "PILOT-DESKTOP" },
            "lane": { "const": "existing-install-upgrade" },
            "results": {
              "items": [
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "existing-version-upgrade" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "startup-update-detection" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "runtime-only-update" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "launcher-only-update" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "failed-update-rollback" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "offline-last-known-good" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "local-chat-and-workspace-unchanged" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "no-command-window" } } }] }
              ],
              "additionalItems": false
            }
          }
        }
      ]
    },
    "cleanInstallDevice": {
      "allOf": [
        { "$ref": "#/definitions/device" },
        {
          "properties": {
            "deviceId": { "const": "pilot-notebook" },
            "hostLabel": { "const": "PilotNotebook notebook" },
            "lane": { "const": "clean-first-install" },
            "results": {
              "items": [
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "first-install" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "startup-update-detection" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "runtime-only-update" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "launcher-only-update" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "failed-update-rollback" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "offline-last-known-good" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "local-chat-and-workspace-unchanged" } } }] },
                { "allOf": [{ "$ref": "#/definitions/result" }, { "properties": { "checkId": { "const": "no-command-window" } } }] }
              ],
              "additionalItems": false
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Personal Installer trusted build evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "buildId",
    "edition",
    "channel",
    "releaseSetId",
    "source",
    "payload",
    "compiledTrust",
    "packageClosure",
    "sdkClosure",
    "buildExecution",
    "unsignedInstaller",
    "resourceBinding",
    "signingRequestEligibility"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": {
      "const": "ensou-dsh-personal-installer-trusted-build"
    },
    "buildId": { "$ref": "#/definitions/uuid" },
    "edition": { "const": "Personal" },
    "channel": { "const": "pilot" },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "source": { "$ref": "#/definitions/source" },
    "payload": { "$ref": "#/definitions/payload" },
    "compiledTrust": { "$ref": "#/definitions/compiledTrust" },
    "packageClosure": { "$ref": "#/definitions/packageClosure" },
    "sdkClosure": { "$ref": "#/definitions/sdkClosure" },
    "buildExecution": { "$ref": "#/definitions/buildExecution" },
    "unsignedInstaller": { "$ref": "#/definitions/unsignedInstaller" },
    "resourceBinding": { "$ref": "#/definitions/resourceBinding" },
    "signingRequestEligibility": { "$ref": "#/definitions/admission" }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "minLength": 128,
      "maxLength": 128,
      "pattern": "^[0-9a-f]{128}$"
    },
    "gitObject": {
      "type": "string",
      "minLength": 40,
      "maxLength": 64,
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "relativePath", "sizeBytes", "sha256"],
      "properties": {
        "role": {
          "enum": ["release-manifest", "startup-stub", "client-bundle", "runtime"]
        },
        "fileName": {
          "enum": [
            "release-set.v2.json",
            "Ensou.Dsh.Bootstrapper.exe",
            "client-bundle.zip",
            "runtime.zip"
          ]
        },
        "relativePath": {
          "type": "string",
          "pattern": "^payload/(?:release-set[.]v2[.]json|Ensou[.]Dsh[.]Bootstrapper[.]exe|client-bundle[.]zip|runtime[.]zip)$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commit", "tree", "status", "snapshotContract", "rootProject",
        "fileCount", "totalSizeBytes", "inventorySha256"
      ],
      "properties": {
        "commit": { "$ref": "#/definitions/gitObject" },
        "tree": { "$ref": "#/definitions/gitObject" },
        "status": { "const": "CLEAN_TRACKED_HEAD" },
        "snapshotContract": { "const": "git-head-archive-held-file-leases-directory-identity-mutation-monitor-v2" },
        "rootProject": {
          "const": "src/Ensou.Dsh.Personal.Installer/Ensou.Dsh.Personal.Installer.csproj"
        },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "totalSizeBytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "inventorySha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "authenticationStatus", "inventorySha256", "files"],
      "properties": {
        "status": { "const": "EXACT_FOUR_FILE_BYTE_CLOSURE_VERIFIED" },
        "authenticationStatus": {
          "const": "STRUCTURE_AND_ARTIFACT_HASHES_VERIFIED_SIGNED_MANIFEST_TRUST_NOT_YET_SHARED_R6_ADMITTED"
        },
        "inventorySha256": { "$ref": "#/definitions/sha256" },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "additionalItems": false,
          "items": [
            { "allOf": [{ "$ref": "#/definitions/file" }, { "properties": { "role": { "const": "release-manifest" }, "fileName": { "const": "release-set.v2.json" }, "relativePath": { "const": "payload/release-set.v2.json" } } }] },
            { "allOf": [{ "$ref": "#/definitions/file" }, { "properties": { "role": { "const": "startup-stub" }, "fileName": { "const": "Ensou.Dsh.Bootstrapper.exe" }, "relativePath": { "const": "payload/Ensou.Dsh.Bootstrapper.exe" } } }] },
            { "allOf": [{ "$ref": "#/definitions/file" }, { "properties": { "role": { "const": "client-bundle" }, "fileName": { "const": "client-bundle.zip" }, "relativePath": { "const": "payload/client-bundle.zip" } } }] },
            { "allOf": [{ "$ref": "#/definitions/file" }, { "properties": { "role": { "const": "runtime" }, "fileName": { "const": "runtime.zip" }, "relativePath": { "const": "payload/runtime.zip" } } }] }
          ]
        }
      }
    },
    "compiledTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestOrigin", "artifactOrigin", "channel", "releaseKeyId",
        "releaseKeyIdentitySha256", "startupStubVersion",
        "canonicalLowSFromSequence", "authenticodeSignerSha256Thumbprint"
      ],
      "properties": {
        "manifestOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "artifactOrigin": { "type": "string", "format": "uri", "pattern": "^https://" },
        "channel": { "const": "pilot" },
        "releaseKeyId": { "$ref": "#/definitions/token" },
        "releaseKeyIdentitySha256": { "$ref": "#/definitions/sha256" },
        "startupStubVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "canonicalLowSFromSequence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "authenticodeSignerSha256Thumbprint": { "$ref": "#/definitions/sha256" }
      }
    },
    "packageClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockRelativePath", "lockSha256", "packageCount", "inventorySha256"],
      "properties": {
        "lockRelativePath": { "const": "repo/installer/personal-publish-runtime-packs.lock.json" },
        "lockSha256": { "$ref": "#/definitions/sha256" },
        "packageCount": { "const": 4 },
        "inventorySha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "sdkClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdkVersion", "archiveFileName", "archiveSha512", "lockRelativePath",
        "lockSha256", "inventorySha256", "fileCount", "totalSizeBytes",
        "status", "privateCopyPolicy"
      ],
      "properties": {
        "sdkVersion": { "const": "10.0.302" },
        "archiveFileName": { "const": "dotnet-sdk-10.0.302-win-x64.zip" },
        "archiveSha512": { "$ref": "#/definitions/sha512" },
        "lockRelativePath": { "const": "repo/release/locks/dotnet-sdk-10.0.302-win-x64.files.lock.json" },
        "lockSha256": { "$ref": "#/definitions/sha256" },
        "inventorySha256": { "$ref": "#/definitions/sha256" },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "totalSizeBytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
        "status": { "const": "VERIFIED" },
        "privateCopyPolicy": {
          "const": "create-only-private-copy-held-open-through-version-restore-publish-v1"
        }
      }
    },
    "buildExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "startedAtUtc", "completedAtUtc", "exitCode", "runtimeIdentifier",
        "selfContained", "singleFile", "offlineRestore", "inheritedEnvironmentCleared",
        "unsignedArtifactExecution"
      ],
      "properties": {
        "startedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "exitCode": { "const": 0 },
        "runtimeIdentifier": { "const": "win-x64" },
        "selfContained": { "const": true },
        "singleFile": { "const": true },
        "offlineRestore": { "const": true },
        "inheritedEnvironmentCleared": { "const": true },
        "unsignedArtifactExecution": { "const": "FORBIDDEN_AND_NOT_PERFORMED" }
      }
    },
    "unsignedInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "fileName", "relativePath", "sizeBytes", "sha256", "peContentSha256", "authenticodeStatus"],
      "properties": {
        "role": { "const": "installer" },
        "fileName": { "const": "Ensou.Dsh.Personal.Installer.exe" },
        "relativePath": { "const": "unsigned/Ensou.Dsh.Personal.Installer.exe" },
        "sizeBytes": { "type": "integer", "minimum": 256, "maximum": 1073741824 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "peContentSha256": { "$ref": "#/definitions/sha256" },
        "authenticodeStatus": { "const": "NotSigned" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "logicalName", "sizeBytes", "sha256", "status"],
      "properties": {
        "role": { "enum": ["release-manifest", "startup-stub", "client-bundle", "runtime"] },
        "logicalName": { "type": "string", "pattern": "^Ensou[.]Dsh[.]Personal[.]Installer[.]Payload[.]" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "status": { "const": "VERIFIED" }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verificationMethod", "status", "resourceSetSha256", "resources", "unsignedInstallerSha256"],
      "properties": {
        "verificationMethod": { "const": "pe-metadata-embedded-resource-inspection-no-assembly-load-v1" },
        "status": { "const": "VERIFIED" },
        "resourceSetSha256": { "$ref": "#/definitions/sha256" },
        "resources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/resource" }
        },
        "unsignedInstallerSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "blocker", "productionAdmission", "reason"],
      "properties": {
        "status": { "const": "READY" },
        "blocker": { "const": "INSTALLER_SIGNING_RESPONSE_REQUIRED" },
        "productionAdmission": { "const": "NO_GO" },
        "reason": { "type": "string", "minLength": 32, "maxLength": 1024 }
      }
    }
  }
}

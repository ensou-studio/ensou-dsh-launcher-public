{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensou.example/schemas/managed-plugin-generation-ledger-v1.schema.json",
  "title": "Managed plugin Development-E2E generation ledger v1",
  "description": "Development-E2E-only ledger. Production ReleasePublisher requires namespaced ledger v2 and rejects this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "policyId", "highestPromotedGeneration"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "policyId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "highestPromotedGeneration": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  }
}

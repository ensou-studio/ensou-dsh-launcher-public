+
+/** Find and verify the package directory that contains one resolved entry. */
+function findResolvedPackageRoot(
+  installationRoot: string,
+  resolved: string,
+  packageName: string,
+): string {
+  let current = dirname(resolved)
+  while (isWithin(installationRoot, current)) {
+    const manifestPath = join(current, 'package.json')
+    if (existsSync(manifestPath)) {
+      const manifest = readPhysicalPackageManifest(installationRoot, manifestPath)
+      if (manifest.name === packageName) return current
+    }
+    if (current === installationRoot) break
+    current = dirname(current)
+  }

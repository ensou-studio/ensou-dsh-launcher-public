{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensou.example/schemas/managed-plugin-generation-reservation-v1.schema.json",
  "title": "Managed plugin exclusive generation reservation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "reservationType",
    "reservationStatus",
    "policyId",
    "generation",
    "targetEnvironment",
    "digests",
    "harnessCompatibilityReceiptSha256",
    "createdAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reservationType": { "const": "managed-plugin-policy-generation" },
    "reservationStatus": { "const": "EXCLUSIVE_UNSIGNED_CANDIDATE_RESERVATION" },
    "policyId": { "$ref": "#/$defs/uuid" },
    "generation": { "$ref": "#/$defs/positiveSafeInteger" },
    "targetEnvironment": { "const": "production-release-candidate" },
    "digests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["archiveSha256", "metadataSha256", "rawPolicySha256"],
      "properties": {
        "archiveSha256": { "$ref": "#/$defs/sha256" },
        "metadataSha256": { "$ref": "#/$defs/sha256" },
        "rawPolicySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "harnessCompatibilityReceiptSha256": { "$ref": "#/$defs/sha256" },
    "createdAtUtc": { "$ref": "#/$defs/wholeSecondUtc" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "positiveSafeInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "wholeSecondUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH portable .NET SDK byte closure v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "sdkVersion",
    "os",
    "architecture",
    "archiveSource",
    "archiveSha512",
    "fileCount",
    "totalSizeBytes",
    "inventorySha256",
    "files"
  ],
  "properties": {
    "contract": {
      "const": "portable-dotnet-sdk-byte-closure-v1"
    },
    "sdkVersion": {
      "const": "10.0.302"
    },
    "os": {
      "const": "windows"
    },
    "architecture": {
      "const": "x64"
    },
    "archiveSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "officialMicrosoft"],
      "properties": {
        "url": {
          "type": "string",
          "minLength": 32,
          "maxLength": 2048,
          "format": "uri",
          "pattern": "^https://(?:builds[.]dotnet[.]microsoft[.]com|download[.]visualstudio[.]microsoft[.]com)/[A-Za-z0-9_+-][A-Za-z0-9._+-]*(?:/[A-Za-z0-9_+-][A-Za-z0-9._+-]*)*$"
        },
        "officialMicrosoft": {
          "const": true
        }
      }
    },
    "archiveSha512": {
      "$ref": "#/definitions/sha512"
    },
    "fileCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16384
    },
    "totalSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967296
    },
    "inventorySha256": {
      "$ref": "#/definitions/sha256"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16384,
      "uniqueItems": true,
      "items": {
        "$ref": "#/definitions/file"
      }
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "minLength": 128,
      "maxLength": 128,
      "pattern": "^[0-9a-f]{128}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![.]{1,2}(?:/|$))(?!.*[/][.]{1,2}(?:/|$))[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relativePath", "sizeBytes", "sha256"],
      "properties": {
        "relativePath": {
          "$ref": "#/definitions/relativePath"
        },
        "sizeBytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        },
        "sha256": {
          "$ref": "#/definitions/sha256"
        }
      }
    }
  }
}

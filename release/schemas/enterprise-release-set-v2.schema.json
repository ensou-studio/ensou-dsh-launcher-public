{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ensou.example/schemas/enterprise-release-set-v2.schema.json",
  "title": "Ensou DSH Enterprise signed release-set v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "product",
    "environment",
    "channel",
    "releaseSetId",
    "generation",
    "sequence",
    "minAcceptedSequence",
    "issuedAtUtc",
    "expiresAtUtc",
    "startupStub",
    "revokedReleaseSetIds",
    "artifacts",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "product": { "const": "ensou-dsh-enterprise" },
    "environment": { "enum": ["production", "development-e2e"] },
    "channel": { "$ref": "#/$defs/token" },
    "releaseSetId": { "$ref": "#/$defs/token" },
    "generation": { "type": "integer", "minimum": 1 },
    "sequence": { "type": "integer", "minimum": 1 },
    "minAcceptedSequence": { "type": "integer", "minimum": 0 },
    "issuedAtUtc": { "type": "string", "format": "date-time" },
    "expiresAtUtc": { "type": "string", "format": "date-time" },
    "startupStub": { "$ref": "#/$defs/startupStub" },
    "revokedReleaseSetIds": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/token" }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": ["component"],
            "properties": { "component": { "const": "launcher" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["component"],
            "properties": { "component": { "const": "runtime" } }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": ["component"],
            "properties": { "component": { "const": "plugin-policy" } }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/$defs/token" },
        "value": {
          "type": "string",
          "minLength": 86,
          "maxLength": 86,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "startupStub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimumProtocol", "maximumProtocol"],
      "properties": {
        "minimumProtocol": { "type": "integer", "minimum": 1 },
        "maximumProtocol": { "type": "integer", "minimum": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "releaseId", "uri", "sizeBytes", "sha256", "completeTreeSha256", "signature"],
      "properties": {
        "component": { "enum": ["launcher", "runtime", "plugin-policy"] },
        "releaseId": { "$ref": "#/$defs/token" },
        "uri": { "type": "string", "format": "uri", "pattern": "^https://" },
        "sizeBytes": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "completeTreeSha256": { "$ref": "#/$defs/sha256" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}

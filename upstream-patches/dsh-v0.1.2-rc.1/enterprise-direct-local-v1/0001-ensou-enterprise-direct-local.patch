+  const canonicalAnchorDir = realpathSync.native(anchorDir)
+  const sourceRoot = findSourceInstallation(canonicalAnchorDir)
+  if (sourceRoot === undefined) {
+    throw new Error(`dsh-app-boot: installation anchor is outside a source workspace or deployed runtime closure: ${anchorPath}`)
+  }
+  const packageManifests = indexSourcePackages(sourceRoot)
+  if (packageManifests.get(anchorManifest.name) !== anchorPath) {
+    throw new Error('dsh-app-boot: installation anchor is not a unique physical source package')
+  }
+  return { kind: 'source', root: sourceRoot, packageManifests }

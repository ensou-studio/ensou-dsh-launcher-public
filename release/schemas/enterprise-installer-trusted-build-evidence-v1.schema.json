{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Enterprise Installer trusted build evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "orchestrationId",
    "releaseSetId",
    "edition",
    "channel",
    "planSha256",
    "baseHeadSha256",
    "r5ReceiptSha256",
    "sourceCommit",
    "sourceTree",
    "sourceBuildInputs",
    "packageClosure",
    "installerPayload",
    "toolchainLock",
    "toolchainLockSha256",
    "buildExecution",
    "unsignedInstaller",
    "resourceBinding",
    "signingRequestEligibility"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": {
      "const": "ensou-dsh-enterprise-installer-trusted-build"
    },
    "orchestrationId": { "$ref": "#/definitions/orchestrationId" },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "edition": { "const": "Enterprise" },
    "channel": { "const": "stable" },
    "planSha256": { "$ref": "#/definitions/sha256" },
    "baseHeadSha256": { "$ref": "#/definitions/sha256" },
    "r5ReceiptSha256": { "$ref": "#/definitions/sha256" },
    "sourceCommit": { "$ref": "#/definitions/gitObject" },
    "sourceTree": { "$ref": "#/definitions/gitObject" },
    "sourceBuildInputs": { "$ref": "#/definitions/sourceBuildInputs" },
    "packageClosure": { "$ref": "#/definitions/packageClosure" },
    "installerPayload": { "$ref": "#/definitions/installerPayload" },
    "toolchainLock": { "$ref": "#/definitions/toolchainLock" },
    "toolchainLockSha256": { "$ref": "#/definitions/sha256" },
    "buildExecution": { "$ref": "#/definitions/buildExecution" },
    "unsignedInstaller": { "$ref": "#/definitions/unsignedInstaller" },
    "resourceBinding": { "$ref": "#/definitions/resourceBinding" },
    "signingRequestEligibility": {
      "$ref": "#/definitions/signingRequestEligibility"
    }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "sha512": {
      "type": "string",
      "minLength": 88,
      "maxLength": 88,
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "sha512Hex": {
      "type": "string",
      "minLength": 128,
      "maxLength": 128,
      "pattern": "^[0-9a-f]{128}$"
    },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "orchestrationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "wholeSecondUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "identityPath": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1024,
      "pattern": "^(?:repo|generated|runtime-pack)/[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "snapshotPath": {
      "type": "string",
      "minLength": 21,
      "maxLength": 1200,
      "pattern": "^build-inputs/[A-Za-z0-9._+-]+(?:/[A-Za-z0-9._+-]+)*$"
    },
    "presentSourceInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identityPath",
        "snapshotRelativePath",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "project",
            "directory-build-props",
            "directory-build-targets",
            "global-json",
            "packages-lock",
            "restore-graph",
            "runtime-pack",
            "generated-input"
          ]
        },
        "identityPath": { "$ref": "#/definitions/identityPath" },
        "snapshotRelativePath": { "$ref": "#/definitions/snapshotPath" },
        "sizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "absentTargetsInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identityPath", "absenceStatus"],
      "properties": {
        "kind": { "const": "directory-build-targets-absent" },
        "identityPath": { "const": "repo/Directory.Build.targets" },
        "absenceStatus": { "const": "VERIFIED_ABSENT" }
      }
    },
    "sourceInput": {
      "oneOf": [
        { "$ref": "#/definitions/presentSourceInput" },
        { "$ref": "#/definitions/absentTargetsInput" }
      ]
    },
    "sourceBuildInputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract",
        "sourceTree",
        "rootProjectIdentityPath",
        "trackedClean",
        "dirtyPathCount",
        "untrackedPathCount",
        "linkedInputCount",
        "raceCheckStatus",
        "inventorySha256",
        "preBuildInventorySha256",
        "postBuildInventorySha256",
        "totalSizeBytes",
        "transitiveProjects",
        "files"
      ],
      "properties": {
        "contract": {
          "const": "tracked-clean-ordinary-single-link-exact-msbuild-graph-v1"
        },
        "sourceTree": { "$ref": "#/definitions/gitObject" },
        "rootProjectIdentityPath": {
          "const": "repo/src/Ensou.Dsh.Enterprise.Installer/Ensou.Dsh.Enterprise.Installer.csproj"
        },
        "trackedClean": { "const": true },
        "dirtyPathCount": { "const": 0 },
        "untrackedPathCount": { "const": 0 },
        "linkedInputCount": { "const": 0 },
        "raceCheckStatus": { "const": "VERIFIED_UNCHANGED" },
        "inventorySha256": { "$ref": "#/definitions/sha256" },
        "preBuildInventorySha256": { "$ref": "#/definitions/sha256" },
        "postBuildInventorySha256": { "$ref": "#/definitions/sha256" },
        "totalSizeBytes": { "type": "integer", "minimum": 1 },
        "transitiveProjects": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^src/[A-Za-z0-9._+-]+/[A-Za-z0-9._+-]+[.]csproj$"
          }
        },
        "files": {
          "type": "array",
          "minItems": 12,
          "items": { "$ref": "#/definitions/sourceInput" }
        }
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind", "id", "version", "fileName", "sizeBytes", "sha256", "sha512"
      ],
      "properties": {
        "kind": { "enum": ["runtime-pack", "publish-tool"] },
        "id": { "type": "string", "pattern": "^[A-Za-z0-9.-]+$" },
        "version": { "const": "10.0.10" },
        "fileName": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+[.]10[.]0[.]10[.]nupkg$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "sha512": { "$ref": "#/definitions/sha512" }
      }
    },
    "packageClosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lockRelativePath", "lockSha256", "packageCount", "packages"],
      "properties": {
        "lockRelativePath": {
          "const": "repo/installer/enterprise-publish-runtime-packs.lock.json"
        },
        "lockSha256": { "$ref": "#/definitions/sha256" },
        "packageCount": { "const": 4 },
        "packages": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/package" }
        }
      }
    },
    "payloadFile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "fileName",
        "embeddedLogicalName",
        "sourceKind",
        "sourceRole",
        "sourceSha256",
        "sizeBytes",
        "sha256"
      ],
      "properties": {
        "role": {
          "enum": ["install-manifest", "launcher", "runtime", "bootstrapper"]
        },
        "fileName": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "embeddedLogicalName": {
          "type": "string",
          "pattern": "^Ensou[.]Dsh[.]Enterprise[.]Installer[.]Payload[.][A-Za-z0-9._-]+$"
        },
        "sourceKind": {
          "enum": ["generated-descriptor", "r5-candidate", "r3-signed-client"]
        },
        "sourceRole": {
          "enum": ["install-manifest", "launcher", "runtime", "bootstrapper"]
        },
        "sourceSha256": { "$ref": "#/definitions/sha256" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "installerPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventorySha256", "files"],
      "properties": {
        "inventorySha256": { "$ref": "#/definitions/sha256" },
        "files": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/payloadFile" }
        }
      }
    },
    "requestToolchainLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sdkVersion",
        "globalJsonRelativePath",
        "globalJsonSha256",
        "projectFileName",
        "projectRelativePath",
        "projectSha256",
        "restoreGraphRelativePath",
        "restoreGraphSha256",
        "packagesLockRelativePath",
        "packagesLockSha256",
        "packagesLockStatus",
        "dependencyClosureSha256",
        "runtimePackSetSha256",
        "sdkInfoRelativePath",
        "sdkInfoSha256",
        "publishArgumentsSha256",
        "configuration",
        "runtimeIdentifier",
        "selfContained",
        "publishSingleFile",
        "deterministic",
        "continuousIntegrationBuild",
        "restoreMode",
        "networkAccess"
      ],
      "properties": {
        "sdkVersion": { "const": "10.0.302" },
        "globalJsonRelativePath": { "const": "toolchain/global.json" },
        "globalJsonSha256": { "$ref": "#/definitions/sha256" },
        "projectFileName": {
          "const": "Ensou.Dsh.Enterprise.Installer.csproj"
        },
        "projectRelativePath": {
          "const": "toolchain/Ensou.Dsh.Enterprise.Installer.csproj"
        },
        "projectSha256": { "$ref": "#/definitions/sha256" },
        "restoreGraphRelativePath": {
          "const": "toolchain/project.assets.json"
        },
        "restoreGraphSha256": { "$ref": "#/definitions/sha256" },
        "packagesLockRelativePath": {
          "const": "toolchain/packages.lock.json"
        },
        "packagesLockSha256": { "$ref": "#/definitions/sha256" },
        "packagesLockStatus": { "const": "VERIFIED" },
        "dependencyClosureSha256": { "$ref": "#/definitions/sha256" },
        "runtimePackSetSha256": { "$ref": "#/definitions/sha256" },
        "sdkInfoRelativePath": {
          "const": "toolchain/dotnet-sdk-info.v1.json"
        },
        "sdkInfoSha256": { "$ref": "#/definitions/sha256" },
        "publishArgumentsSha256": { "$ref": "#/definitions/sha256" },
        "configuration": { "const": "Release" },
        "runtimeIdentifier": { "const": "win-x64" },
        "selfContained": { "const": true },
        "publishSingleFile": { "const": true },
        "deterministic": { "const": true },
        "continuousIntegrationBuild": { "const": true },
        "restoreMode": { "const": "packages-lock-locked-offline" },
        "networkAccess": { "const": "disabled" }
      }
    },
    "toolchainLock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestContract",
        "requestContractSha256",
        "restoreArgumentsSha256",
        "networkEnforcement",
        "subprocessEnvironmentPolicy",
        "sdkFileClosureStatus",
        "archiveFileName",
        "archiveSourceUrl",
        "archiveSha512",
        "archiveBindingStatus",
        "trackedLockRelativePath",
        "trackedLockSha256",
        "inventorySha256",
        "fileCount",
        "totalSizeBytes",
        "privateCopyPolicy",
        "dotnetRootPolicy"
      ],
      "properties": {
        "requestContract": { "$ref": "#/definitions/requestToolchainLock" },
        "requestContractSha256": { "$ref": "#/definitions/sha256" },
        "restoreArgumentsSha256": { "$ref": "#/definitions/sha256" },
        "networkEnforcement": {
          "const": "local-source-clear-plus-loopback-proxy-sink"
        },
        "subprocessEnvironmentPolicy": {
          "const": "clear-all-inherited-then-explicit-allowlist-and-msbuild-property-pins-v1"
        },
        "sdkFileClosureStatus": { "const": "VERIFIED" },
        "archiveFileName": {
          "const": "dotnet-sdk-10.0.302-win-x64.zip"
        },
        "archiveSourceUrl": {
          "const": "https://builds.dotnet.microsoft.com/dotnet/Sdk/10.0.302/dotnet-sdk-10.0.302-win-x64.zip"
        },
        "archiveSha512": { "$ref": "#/definitions/sha512Hex" },
        "archiveBindingStatus": {
          "const": "ZIP_SHA512_AND_FILE_INVENTORY_VERIFIED"
        },
        "trackedLockRelativePath": {
          "const": "repo/release/locks/dotnet-sdk-10.0.302-win-x64.files.lock.json"
        },
        "trackedLockSha256": { "$ref": "#/definitions/sha256" },
        "inventorySha256": { "$ref": "#/definitions/sha256" },
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "totalSizeBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967296
        },
        "privateCopyPolicy": {
          "const": "create-only-output-work-copy-held-open-through-version-restore-publish-v1"
        },
        "dotnetRootPolicy": {
          "const": "private-root-only-multilevel-lookup-disabled-v1"
        }
      }
    },
    "buildExecution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "buildId",
        "targetBuildIdentitySha256",
        "reservationSha256",
        "buildOrdinal",
        "buildCountForTarget",
        "outputCreationMode",
        "rebuildPolicy",
        "startedAtUtc",
        "completedAtUtc",
        "exitCode"
      ],
      "properties": {
        "buildId": { "$ref": "#/definitions/orchestrationId" },
        "targetBuildIdentitySha256": { "$ref": "#/definitions/sha256" },
        "reservationSha256": { "$ref": "#/definitions/sha256" },
        "buildOrdinal": { "const": 1 },
        "buildCountForTarget": { "const": 1 },
        "outputCreationMode": { "const": "create-new" },
        "rebuildPolicy": {
          "const": "rebuild-forbidden-exact-reserved-unsigned-bytes-replay-only"
        },
        "startedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
        "exitCode": { "const": 0 }
      }
    },
    "unsignedInstaller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "fileName",
        "relativePath",
        "sizeBytes",
        "sha256",
        "peContentSha256",
        "authenticodeStatus"
      ],
      "properties": {
        "role": { "const": "installer" },
        "fileName": { "const": "Ensou.Dsh.Enterprise.Installer.exe" },
        "relativePath": {
          "const": "unsigned/Ensou.Dsh.Enterprise.Installer.exe"
        },
        "sizeBytes": { "type": "integer", "minimum": 256 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "peContentSha256": { "$ref": "#/definitions/sha256" },
        "authenticodeStatus": { "const": "NotSigned" }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "embeddedLogicalName", "sizeBytes", "sha256", "status"],
      "properties": {
        "role": {
          "enum": ["install-manifest", "launcher", "runtime", "bootstrapper"]
        },
        "embeddedLogicalName": {
          "type": "string",
          "pattern": "^Ensou[.]Dsh[.]Enterprise[.]Installer[.]Payload[.][A-Za-z0-9._-]+$"
        },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "status": { "const": "VERIFIED" }
      }
    },
    "resourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verificationType",
        "verificationMethod",
        "status",
        "managedAssembly",
        "resourceSetSha256",
        "resources",
        "unsignedInstallerSha256"
      ],
      "properties": {
        "verificationType": {
          "const": "managed-assembly-resource-to-single-file-build-input-v1"
        },
        "verificationMethod": {
          "const": "collectible-load-context-manifest-resource-inspection-no-entrypoint"
        },
        "status": { "const": "VERIFIED" },
        "managedAssembly": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fileName", "sizeBytes", "sha256"],
          "properties": {
            "fileName": { "const": "Ensou.Dsh.Enterprise.Installer.dll" },
            "sizeBytes": { "type": "integer", "minimum": 256 },
            "sha256": { "$ref": "#/definitions/sha256" }
          }
        },
        "resourceSetSha256": { "$ref": "#/definitions/sha256" },
        "resources": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": { "$ref": "#/definitions/resource" }
        },
        "unsignedInstallerSha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "signingRequestEligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "requestSchemaVersion",
        "productionAdmission",
        "blocker",
        "reason"
      ],
      "properties": {
        "status": { "const": "ELIGIBLE_FOR_PILOT_SIGNING" },
        "requestSchemaVersion": { "const": 2 },
        "productionAdmission": { "const": "NO_GO" },
        "blocker": {
          "const": "INSTALLER_SIGNING_RESPONSE_REQUIRED"
        },
        "reason": {
          "type": "string",
          "minLength": 80,
          "maxLength": 1024
        }
      }
    }
  }
}

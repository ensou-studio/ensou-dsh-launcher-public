+        setup: agentCtx => ctx.agentPresets.mount(agentCtx, 'enterprise').then(() => undefined),
+      })
+      try {
+        expect((await ctx.skills.list({ cwd: project, scope: handle.agent })).map(skill => skill.name).sort())
+          .toEqual(['dsh-badge', 'managed-only'])
+        const managedTools = ctx.tools.schemas(handle.agent).map(schema => schema.name)
+        expect(managedTools).toContain('skill')
+        expect(managedTools).not.toContain('web_search')
+        expect(managedTools).not.toContain('web_fetch')
+        for (const name of ['managed-only', 'dsh-badge']) {
+          const loaded = await ctx.tools.execute({
+            callId: ToolCallId(`managed-skill-load-${name}`),
+            name: 'skill',
+            arguments: { name },
+            signal: new AbortController().signal,
+            agent: handle.agent,
+          })
+          expect(loaded.isError).toBe(false)
+          expect(JSON.stringify(loaded.content)).toContain(
+            name === 'managed-only' ? 'Managed instructions.' : 'powered by dsh',
+          )
+        }
+      } finally {
+        await handle.dispose()
+      }
+    } finally {
+      await ctx.fiber.dispose()
+    }
+  }, 120_000)
+
+  it('preserves normal profile, home, overlay, and user-preset behavior without the signal', async () => {
+    const home = tempHome()
+    const profile = prepareProfile('web')
+    const sharedModules = join(home, 'profiles', 'node_modules')
+    const profileModules = join(profile.dir, 'node_modules')
+    const ownedModules = join(profile.dir, '.dsh-module-fallback', 'node_modules')
+    expect(existsSync(sharedModules)).toBe(false)
+    expect(existsSync(profileModules)).toBe(false)
+    expect(existsSync(ownedModules)).toBe(false)
+    writeFileSync(profile.patchPath, "- insert:\n    - id: normal-profile\n      name: '@test/profile'\n")
+    writeFileSync(join(home, 'cordis.patch.yml'), "- insert:\n    - id: normal-home\n      name: '@test/home'\n")
+    const overlay = join(home, 'normal-overlay.yml')
+    writeFileSync(overlay, "- insert:\n    - id: normal-overlay\n      name: '@test/overlay'\n")
+
+    const composed = await composeProfile('web', [overlay], environment(undefined, {
+      [MANAGED_SKILLS_ROOT_ENV]: 'invalid\0ordinary',
+    }))
+    expect(composed.managed).toBe(false)
+    expect(composed.rows.has('normal-profile')).toBe(true)
+    expect(composed.rows.has('normal-home')).toBe(true)
+    expect(composed.rows.has('normal-overlay')).toBe(true)
+    expect(existsSync(sharedModules)).toBe(true)
+    expect(existsSync(profileModules)).toBe(true)
+    expect(existsSync(ownedModules)).toBe(true)
+    const roster = row(composed, 'agent-presets').config as Record<string, unknown>
+    expect(roster).toEqual({ default: 'standard' })
+  })
+})
diff --git a/apps/cli/tests/managed-runtime-update.spec.ts b/apps/cli/tests/managed-runtime-update.spec.ts
new file mode 100644
index 0000000000000000000000000000000000000000..19b4a22ea0321829b49bb55b37b0721741320061
--- /dev/null
+++ b/apps/cli/tests/managed-runtime-update.spec.ts
@@ -0,0 +1,333 @@
+import { randomUUID } from 'node:crypto'
+import { createServer, type Socket } from 'node:net'
+import { describe, expect, it, vi } from 'vitest'
+import type { Agent } from '@deepseek-ai/dsh-agent'
+import type { LaunchEnvironmentSnapshot } from '@deepseek-ai/dsh-launch-environment'
+import type { Session } from '@deepseek-ai/dsh-session'
+import {
+  ManagedUpdateCoordinator,
+  ManagedUpdatePipeClient,
+  PERSONAL_UPDATE_BOOT_ENV,
+  PERSONAL_UPDATE_BOOT_MARKER,
+  parseUpdateRequest,
+  resolveUpdateBootstrap,
+  UPDATE_INSTANCE_ENV,
+  UPDATE_PIPE_ENV,
+  UPDATE_PROTOCOL,
+  type ManagedUpdateRuntime,
+  type UpdateAction,
+  type UpdateRequest,
+} from '../src/managed-runtime-update.ts'
+import { DIRECT_LOCAL_PROFILE } from '../src/managed-boot.ts'
+
+const INSTANCE = '11111111-1111-4111-8111-111111111111'
+const OPERATION = '22222222-2222-4222-8222-222222222222'
+
+function deferred(): { promise: Promise<void>; resolve(): void } {
+  const state = Promise.withResolvers<undefined>()
+  return { promise: state.promise, resolve: () => { state.resolve(undefined) } }
+}
+
+async function bounded<T>(label: string, promise: Promise<T>): Promise<T> {
+  return Promise.race([
+    promise,
+    new Promise<never>((_resolve, reject) => {
+      setTimeout(() => { reject(new Error(`fixture timed out: ${label}`)) }, 1_000).unref()
+    }),
+  ])
+}
+
+class FakeAgent {
+  readonly id: string
+  status: 'idle' | 'running'
+  held = false
+  private idle = deferred()
+
+  constructor(id: string, running = false) {
+    this.id = id
+    this.status = running ? 'running' : 'idle'
+    if (!running) this.idle.resolve()
+  }
+
+  finishWork(): void {
+    this.status = 'idle'
+    this.idle.resolve()
+  }
+
+  whenIdle(): Promise<void> {
+    return this.idle.promise
+  }
+
+  runMaintenance<T>(task: () => Promise<T>): Promise<T> {
+    if (this.status !== 'idle' || this.held) throw new Error('busy')
+    this.held = true
+    return task().finally(() => { this.held = false })
+  }
+}
+
+function request(action: UpdateAction, operationId = OPERATION): UpdateRequest {
+  return { protocol: UPDATE_PROTOCOL, runtimeInstanceId: INSTANCE, operationId, action }
+}
+
+function fixture(options: {
+  readonly agents?: FakeAgent[]
+  readonly flush?: (session: Session) => Promise<boolean>
+  readonly credentials?: () => Promise<boolean>
+} = {}): {
+  readonly coordinator: ManagedUpdateCoordinator
+  readonly agents: FakeAgent[]
+  readonly sessions: Session[]
+  readonly runtime: ManagedUpdateRuntime
+} {
+  const agents = options.agents ?? []
+  const sessions = [{} as Session]
+  const runtime: ManagedUpdateRuntime = {
+    suspendAdmission: vi.fn(() => Promise.resolve()),
+    resumeAdmission: vi.fn(() => Promise.resolve()),
+    listAgents: () => agents as unknown as Agent[],
+    listSessions: () => sessions,
+    flushSession: options.flush ?? (() => Promise.resolve(true)),
+    checkpointCredentials: options.credentials ?? (() => Promise.resolve(true)),
+    checkpointSettings: () => Promise.resolve(true),
+    shutdown: vi.fn(() => Promise.resolve()),
+  }
+  return { coordinator: new ManagedUpdateCoordinator(INSTANCE, runtime, 731), agents, sessions, runtime }
+}
+
+async function waitForPhase(coordinator: ManagedUpdateCoordinator, phase: 'ready' | 'resumed'): Promise<void> {
+  await vi.waitFor(async () => {
+    const result = await coordinator.command(request('status'))
+    expect(result.receipt.phase).toBe(phase)
+  })
+}
+
+describe('managed runtime update lifecycle', () => {
+  it('fences active work and synchronously captures an Agent created during final flush', async () => {
+    const active = new FakeAgent('active', true)
+    const finalFlush = deferred()
+    let created: FakeAgent | undefined
+    let flushCalls = 0
+    const test = fixture({
+      agents: [active],
+      flush: async () => {
+        flushCalls++
+        if (flushCalls === 1) {
+          created = new FakeAgent('created-during-flush')
+          test.agents.push(created)
+          test.sessions.push({} as Session)
+          test.coordinator.observeAgentCreated(created as unknown as Agent)
+          test.coordinator.observeSessionDirty()
+          test.coordinator.observePersistenceDirty()
+          expect(created.held).toBe(true)
+          await finalFlush.promise
+        }
+        return true
+      },
+    })
+    const draining = await test.coordinator.command(request('drain'))
+    expect(draining.receipt).toMatchObject({ phase: 'draining', persistenceFlushed: false, processId: 731 })
+    expect(active.held).toBe(false)
+    active.finishWork()
+    await vi.waitFor(() => { expect(active.held).toBe(true) })
+    finalFlush.resolve()
+    await waitForPhase(test.coordinator, 'ready')
+    expect(flushCalls).toBeGreaterThanOrEqual(3)
+    expect(created?.held).toBe(true)
+
+    const resumed = await test.coordinator.command(request('resume'))
+    expect(resumed.receipt).toMatchObject({ phase: 'resumed', persistenceFlushed: false })
+    expect(active.held).toBe(false)
+    expect(created?.held).toBe(false)
+  })
+
+  it('restores admission and refuses shutdown after a failed or unsupported flush', async () => {
+    const failure = fixture({ flush: () => Promise.reject(new Error('fixture disk failure')) })
+    await failure.coordinator.command(request('drain'))
+    await waitForPhase(failure.coordinator, 'resumed')
+    expect(failure.runtime.resumeAdmission).toHaveBeenCalledOnce()
+    await expect(failure.coordinator.command(request('shutdown'))).rejects.toThrow(/ready checkpoint/)
+
+    const unsupported = fixture({ credentials: () => Promise.resolve(false) })
+    await unsupported.coordinator.command(request('drain'))
+    await waitForPhase(unsupported.coordinator, 'resumed')
+    await expect(unsupported.coordinator.command(request('shutdown'))).rejects.toThrow(/ready checkpoint/)
+  })
+
+  it('joins explicit Resume to the same-operation automatic restore', async () => {
+    const restoring = deferred()
+    const agent = new FakeAgent('held')
+    const test = fixture({
+      agents: [agent],
+      flush: () => Promise.reject(new Error('fixture disk failure')),
+    })
+    vi.mocked(test.runtime.resumeAdmission).mockImplementation(() => restoring.promise)
+    await test.coordinator.command(request('drain'))
+    await vi.waitFor(() => { expect(test.runtime.resumeAdmission).toHaveBeenCalledOnce() })
+    expect(agent.held).toBe(true)
+
+    const resumed = test.coordinator.command(request('resume'))
+    expect(test.runtime.resumeAdmission).toHaveBeenCalledOnce()
+    restoring.resolve()
+
+    await expect(resumed).resolves.toMatchObject({ receipt: { phase: 'resumed', persistenceFlushed: false } })
+    expect(agent.held).toBe(false)
+    await expect(test.coordinator.command(request('resume'))).resolves
+      .toMatchObject({ receipt: { phase: 'resumed' } })
+    expect(test.runtime.resumeAdmission).toHaveBeenCalledOnce()
+  })
+
+  it('keeps restore failure retryable and rejects an earlier operation after a new drain', async () => {
+    const agent = new FakeAgent('retry-held')
+    const test = fixture({ agents: [agent] })
+    await test.coordinator.command(request('drain'))
+    await waitForPhase(test.coordinator, 'ready')
+    vi.mocked(test.runtime.resumeAdmission).mockRejectedValueOnce(new Error('fixture bind failure'))
+
+    await expect(test.coordinator.command(request('resume'))).rejects.toThrow('fixture bind failure')
+    expect(agent.held).toBe(true)
+    expect((await test.coordinator.command(request('status'))).receipt.phase).toBe('ready')
+    await expect(test.coordinator.command(request('resume'))).resolves
+      .toMatchObject({ receipt: { phase: 'resumed' } })
+    expect(agent.held).toBe(false)
+
+    const nextOperation = '33333333-3333-4333-8333-333333333333'
+    await test.coordinator.command(request('drain', nextOperation))
+    await expect(test.coordinator.command(request('resume'))).rejects.toThrow(/operation identity/)
+    await expect(test.coordinator.command(request('resume', nextOperation))).resolves
+      .toMatchObject({ receipt: { operationId: nextOperation, phase: 'resumed' } })
+    expect(test.runtime.resumeAdmission).toHaveBeenCalledTimes(3)
+  })
+
+  it('binds every command to one operation and shuts down only after a ready receipt', async () => {
+    const test = fixture()
+    await test.coordinator.command(request('drain'))
+    await waitForPhase(test.coordinator, 'ready')
+    await expect(test.coordinator.command(request('status', '33333333-3333-4333-8333-333333333333')))
+      .rejects.toThrow(/operation identity/)
+    const shutdown = await test.coordinator.command(request('shutdown'))
+    expect(shutdown).toMatchObject({ shutdownAfterWrite: true, receipt: { phase: 'ready', persistenceFlushed: true } })
+    expect(test.runtime.shutdown).not.toHaveBeenCalled()
+    await test.coordinator.shutdownAfterReceipt()
+    expect(test.runtime.shutdown).toHaveBeenCalledOnce()
+  })
+
+  it('auto-resumes exact held owners on control disconnect', async () => {
+    const agent = new FakeAgent('held')
+    const test = fixture({ agents: [agent] })
+    await test.coordinator.command(request('drain'))
+    await waitForPhase(test.coordinator, 'ready')
+    expect(agent.held).toBe(true)
+    await test.coordinator.disconnect()
+    expect(agent.held).toBe(false)
+    expect((await test.coordinator.command(request('status'))).receipt.phase).toBe('resumed')
+  })
+
+  it('releases exact maintenance owners when the application tree disposes', async () => {
+    const agent = new FakeAgent('teardown-held')
+    const test = fixture({ agents: [agent] })
+    await test.coordinator.command(request('drain'))
+    await waitForPhase(test.coordinator, 'ready')
+    expect(agent.held).toBe(true)
+
+    test.coordinator.dispose()
+
+    await vi.waitFor(() => { expect(agent.held).toBe(false) })
+    await expect(test.coordinator.command(request('status'))).rejects.toThrow(/unavailable/)
+  })
+})
+
+describe('managed update wire admission', () => {
+  it.runIf(process.platform === 'win32')('exchanges bounded receipts over the real named-pipe transport', async () => {
+    const instance = randomUUID()
+    const operationId = randomUUID()
+    const pipePath = `\\\\.\\pipe\\ensou-dsh-update-${instance.replaceAll('-', '')}`
+    const connected = Promise.withResolvers<Socket>()
+    const server = createServer((socket) => { connected.resolve(socket) })
+    await new Promise<void>((resolve, reject) => {
+      server.once('error', reject)
+      server.listen(pipePath, resolve)
+    })
+    const test = fixture()
+    const coordinator = new ManagedUpdateCoordinator(instance, test.runtime, process.pid)
+    const client = new ManagedUpdatePipeClient({ pipePath, runtimeInstanceId: instance }, coordinator)
+    let hostSocket: Socket | undefined
+    try {
+      const starting = client.start()
+      const socket = await bounded('accept', connected.promise)
+      hostSocket = socket
+      await bounded('connect', starting)
+      const readLine = (): Promise<Record<string, unknown>> => new Promise((resolve) => {
+        socket.once('data', (data) => { resolve(JSON.parse(String(data).trim()) as Record<string, unknown>) })
+      })
+      const wireRequest = (action: UpdateAction): string => JSON.stringify({
+        protocol: UPDATE_PROTOCOL, runtimeInstanceId: instance, operationId, action,
+      }) + '\n'
+
+      let response = readLine()
+      socket.write(wireRequest('drain'))
+      expect(await bounded('drain receipt', response)).toMatchObject({ runtimeInstanceId: instance, processId: process.pid })
+      await vi.waitFor(async () => {
+        expect((await coordinator.command({
+          ...request('status'), runtimeInstanceId: instance, operationId,
+        })).receipt.phase).toBe('ready')
+      })
+      response = readLine()
+      socket.write(wireRequest('shutdown'))
+      let shutdownReceipt: Record<string, unknown>
+      try {
+        shutdownReceipt = await bounded('shutdown receipt', response)
+      } catch {
+        throw new Error(`fixture shutdown observation failed (shutdown calls: ${String(vi.mocked(test.runtime.shutdown).mock.calls.length)})`)
+      }
+      expect(shutdownReceipt).toMatchObject({ phase: 'ready', persistenceFlushed: true })
+      await vi.waitFor(() => { expect(test.runtime.shutdown).toHaveBeenCalledOnce() })
+    } finally {
+      client.dispose()
+      hostSocket?.destroy()
+      await bounded('server close', new Promise<void>(resolve => server.close(() => { resolve() })))
+    }
+  })
+
+  it('accepts only the exact direct-local or explicitly opted Personal bootstrap', () => {
+    const values = new Map<string, string>([
+      [UPDATE_INSTANCE_ENV, INSTANCE],
+      [UPDATE_PIPE_ENV, `\\\\.\\pipe\\ensou-dsh-update-${INSTANCE.replaceAll('-', '')}`],
+    ])
+    const read = (name: string) => values.has(name)
+      ? { value: values.get(name)!, source: 'process' as const }
+      : undefined
+    const environment: LaunchEnvironmentSnapshot = {
+      get: read,
+      getFrom: (name, sources) => sources.includes('process') ? read(name) : undefined,
+    }
+    expect(resolveUpdateBootstrap(DIRECT_LOCAL_PROFILE, DIRECT_LOCAL_PROFILE, environment)).toEqual({
+      pipePath: values.get(UPDATE_PIPE_ENV), runtimeInstanceId: INSTANCE,
+    })
+    expect(() => resolveUpdateBootstrap('web', undefined, environment)).toThrow(/not authorized/)
+    values.set(PERSONAL_UPDATE_BOOT_ENV, PERSONAL_UPDATE_BOOT_MARKER)
+    expect(resolveUpdateBootstrap('web', undefined, environment)).toBeDefined()
+    expect(() => resolveUpdateBootstrap(DIRECT_LOCAL_PROFILE, DIRECT_LOCAL_PROFILE, environment))
+      .toThrow(/rejects the Personal/)
+  })
+
+  it('rejects malformed, extra-field, wrong-instance, and noncanonical-operation requests', () => {
+    expect(() => parseUpdateRequest('{', INSTANCE)).toThrow(/valid JSON/)
+    expect(() => parseUpdateRequest(JSON.stringify({ ...request('drain'), extra: true }), INSTANCE)).toThrow(/shape/)
+    expect(() => parseUpdateRequest(
+      `{"protocol":"${UPDATE_PROTOCOL}","runtimeInstanceId":"${INSTANCE}","operationId":"${OPERATION}","action":"drain","action":"drain"}`,
+      INSTANCE,
+    )).toThrow(/shape|canonical/)
+    expect(() => parseUpdateRequest(JSON.stringify({ ...request('drain'), runtimeInstanceId: OPERATION }), INSTANCE))
+      .toThrow(/identity or action/)
+    expect(() => parseUpdateRequest(JSON.stringify({
+      ...request('drain'), operationId: 'aaaaaaaa-aaaa-4aaa-8aaa-aaaaaaaaaaaa'.toUpperCase(),
+    }), INSTANCE))
+      .toThrow(/identity or action/)
+    for (const action of [
+      ['drain'], ['status'], ['resume'], ['shutdown'], null, 1, { value: 'shutdown' },
+    ]) {
+      expect(() => parseUpdateRequest(JSON.stringify({ ...request('drain'), action }), INSTANCE))
+        .toThrow(/identity or action/)
+    }
+  })
+})

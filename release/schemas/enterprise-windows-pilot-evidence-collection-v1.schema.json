{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ensou.example/enterprise-windows-pilot-evidence-collection-v1.schema.json",
  "title": "Ensou DSH Enterprise Windows Pilot evidence collection v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "collectionType",
    "testRunId",
    "customerAudienceId",
    "startedAtUtc",
    "completedAtUtc",
    "pilotManifestUri",
    "readiness",
    "deviceLanes",
    "pilotObserverExecutablePath",
    "weComAdmission",
    "legacySource",
    "localDataWitness",
    "releaseChain",
    "signedExecutables",
    "gateReceiptPaths"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "collectionType": {
      "const": "ensou-dsh-enterprise-windows-pilot-evidence-collection"
    },
    "testRunId": { "$ref": "#/$defs/uuid" },
    "customerAudienceId": { "$ref": "#/$defs/uuid" },
    "startedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "completedAtUtc": { "$ref": "#/$defs/utcTimestamp" },
    "pilotManifestUri": {
      "type": "string",
      "pattern": "^https://[^/?#@\\s]+/v2/channels/pilot/release-set[.]v2[.]json$"
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["configPath", "reportPath", "target"],
      "properties": {
        "configPath": { "$ref": "#/$defs/absolutePath" },
        "reportPath": { "$ref": "#/$defs/absolutePath" },
        "target": { "$ref": "#/$defs/releaseIdentity" }
      }
    },
    "deviceLanes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/deviceLaneInput" },
            { "properties": { "lane": { "const": "clean-install" } } }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/deviceLaneInput" },
            { "properties": { "lane": { "const": "legacy-migration" } } }
          ]
        }
      ],
      "items": false
    },
    "pilotObserverExecutablePath": { "$ref": "#/$defs/absolutePath" },
    "weComAdmission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizedEmployeeSubjectSha256",
        "unregisteredEmployeeSubjectSha256",
        "installationIdSha256",
        "deviceProofPublicKeySha256"
      ],
      "properties": {
        "authorizedEmployeeSubjectSha256": { "$ref": "#/$defs/sha256" },
        "unregisteredEmployeeSubjectSha256": { "$ref": "#/$defs/sha256" },
        "installationIdSha256": { "$ref": "#/$defs/sha256" },
        "deviceProofPublicKeySha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "legacySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "inventoryPath"],
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "inventoryPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "localDataWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "historyTreeBeforeSha256",
        "historyTreeAfterSha256",
        "workspaceTreeBeforeSha256",
        "workspaceTreeAfterSha256"
      ],
      "properties": {
        "historyTreeBeforeSha256": { "$ref": "#/$defs/sha256" },
        "historyTreeAfterSha256": { "$ref": "#/$defs/sha256" },
        "workspaceTreeBeforeSha256": { "$ref": "#/$defs/sha256" },
        "workspaceTreeAfterSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "releaseChain": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/releaseInput" }, { "properties": { "stage": { "const": "baseline" } } }] },
        { "allOf": [{ "$ref": "#/$defs/releaseInput" }, { "properties": { "stage": { "const": "first-update" } } }] },
        { "allOf": [{ "$ref": "#/$defs/releaseInput" }, { "properties": { "stage": { "const": "second-update" } } }] },
        { "allOf": [{ "$ref": "#/$defs/releaseInput" }, { "properties": { "stage": { "const": "failed-health-probe" } } }] },
        { "allOf": [{ "$ref": "#/$defs/releaseInput" }, { "properties": { "stage": { "const": "recovery-target" } } }] }
      ],
      "items": false
    },
    "signedExecutables": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/signedExecutableInput" }, { "properties": { "role": { "const": "release-publisher" } } }] },
        { "allOf": [{ "$ref": "#/$defs/signedExecutableInput" }, { "properties": { "role": { "const": "installer" } } }] },
        { "allOf": [{ "$ref": "#/$defs/signedExecutableInput" }, { "properties": { "role": { "const": "bootstrapper" } } }] },
        { "allOf": [{ "$ref": "#/$defs/signedExecutableInput" }, { "properties": { "role": { "const": "launcher" } } }] },
        { "allOf": [{ "$ref": "#/$defs/signedExecutableInput" }, { "properties": { "role": { "const": "client-bootstrapper" } } }] },
        { "allOf": [{ "$ref": "#/$defs/signedExecutableInput" }, { "properties": { "role": { "const": "maintenance" } } }] }
      ],
      "items": false
    },
    "gateReceiptPaths": {
      "type": "array",
      "minItems": 21,
      "maxItems": 21,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/absolutePath" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "safePositiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "utcTimestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{7}Z$"
    },
    "absolutePath": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1024,
      "pattern": "^[A-Za-z]:\\\\"
    },
    "releaseIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "releaseSetId", "generation", "sequence", "manifestSha256",
        "runtimeEntryPointSha256"
      ],
      "properties": {
        "releaseSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "generation": { "$ref": "#/$defs/safePositiveInteger" },
        "sequence": { "$ref": "#/$defs/safePositiveInteger" },
        "manifestSha256": { "$ref": "#/$defs/sha256" },
        "runtimeEntryPointSha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "deviceLaneInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane", "osFamily", "osBuild", "nativeArchitecture",
        "standardUser", "installationIdSha256", "deviceInventoryPath"
      ],
      "properties": {
        "lane": { "enum": ["clean-install", "legacy-migration"] },
        "osFamily": { "const": "windows" },
        "osBuild": {
          "type": "string",
          "pattern": "^(10|11)[.][0-9]{4,6}[.][0-9]{1,6}$"
        },
        "nativeArchitecture": { "const": "x64" },
        "standardUser": { "const": true },
        "installationIdSha256": { "$ref": "#/$defs/sha256" },
        "deviceInventoryPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "releaseInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stage", "releaseSetId", "generation", "sequence",
        "runtimeEntryPointSha256", "manifestPath"
      ],
      "properties": {
        "stage": {
          "enum": ["baseline", "first-update", "second-update", "failed-health-probe", "recovery-target"]
        },
        "releaseSetId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
        },
        "generation": { "$ref": "#/$defs/safePositiveInteger" },
        "sequence": { "$ref": "#/$defs/safePositiveInteger" },
        "runtimeEntryPointSha256": { "$ref": "#/$defs/sha256" },
        "manifestPath": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "signedExecutableInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path"],
      "properties": {
        "role": {
          "enum": ["release-publisher", "installer", "bootstrapper", "launcher", "client-bootstrapper", "maintenance"]
        },
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    }
  }
}

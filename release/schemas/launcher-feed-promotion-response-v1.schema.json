{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Launcher offline feed-promotion authorization response v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "responseType",
    "operationId",
    "orchestrationId",
    "edition",
    "exposureRing",
    "feedChannel",
    "publishScope",
    "releaseSetId",
    "requestSha256",
    "requestNonce",
    "basePromotionHeadSha256",
    "sourceStateHeadSha256",
    "payloadSetSha256",
    "feedCasSha256",
    "decision",
    "completedAtUtc",
    "requestExpiresAtUtc",
    "productionAdmission",
    "networkPublishPerformed",
    "authentication"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "responseType": {
      "const": "ensou-dsh-launcher-offline-feed-promotion-response"
    },
    "operationId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "orchestrationId": { "$ref": "#/definitions/orchestrationId" },
    "edition": { "enum": ["Personal", "Enterprise"] },
    "exposureRing": { "enum": ["pilot", "stable"] },
    "feedChannel": { "enum": ["pilot", "stable"] },
    "publishScope": {
      "enum": ["channel-head", "private-pilot-allowlist", "public-stable"]
    },
    "releaseSetId": { "$ref": "#/definitions/token" },
    "requestSha256": { "$ref": "#/definitions/sha256" },
    "requestNonce": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "basePromotionHeadSha256": { "$ref": "#/definitions/sha256" },
    "sourceStateHeadSha256": { "$ref": "#/definitions/sha256" },
    "payloadSetSha256": { "$ref": "#/definitions/sha256" },
    "feedCasSha256": { "$ref": "#/definitions/sha256" },
    "decision": { "const": "AUTHORIZE_OFFLINE_BUNDLE" },
    "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "requestExpiresAtUtc": { "$ref": "#/definitions/wholeSecondUtc" },
    "productionAdmission": { "const": "OFFLINE_BUNDLE_ONLY" },
    "networkPublishPerformed": { "const": false },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "purpose", "payloadType", "value"],
      "properties": {
        "algorithm": { "const": "ES256" },
        "keyId": { "$ref": "#/definitions/keyId" },
        "purpose": { "const": "feed-promotion-response" },
        "payloadType": {
          "const": "ensou-dsh-launcher-feed-promotion-response-authentication-v1"
        },
        "value": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{86}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "edition": { "const": "Personal" },
          "exposureRing": { "const": "pilot" }
        }
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "pilot" },
          "publishScope": { "const": "channel-head" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": { "const": "Personal" },
          "exposureRing": { "const": "stable" }
        }
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "stable" },
          "publishScope": { "const": "channel-head" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": { "const": "Enterprise" },
          "exposureRing": { "const": "pilot" }
        }
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "stable" },
          "publishScope": { "const": "private-pilot-allowlist" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "edition": { "const": "Enterprise" },
          "exposureRing": { "const": "stable" }
        }
      },
      "then": {
        "properties": {
          "feedChannel": { "const": "stable" },
          "publishScope": { "const": "public-stable" }
        }
      }
    }
  ],
  "definitions": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "wholeSecondUtc": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "orchestrationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "keyId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}

{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Ensou DSH Personal Installer production payload self-check consumption evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "evidenceType",
    "command",
    "status",
    "exitCode",
    "inspectedInstallerSha256",
    "releaseSetId",
    "manifestSha256",
    "manifestSizeBytes",
    "startupStubSha256",
    "startupStubSizeBytes",
    "clientBundleSha256",
    "clientBundleSizeBytes",
    "runtimeSha256",
    "runtimeSizeBytes",
    "canonicalJsonSizeBytes",
    "canonicalJsonSha256",
    "canonicalLineSizeBytes",
    "canonicalLineSha256",
    "completedAtUtc"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "evidenceType": {
      "const": "ensou-dsh-personal-installer-production-payload-self-check-consumption"
    },
    "command": { "const": "--production-payload-self-check" },
    "status": { "const": "VERIFIED" },
    "exitCode": { "const": 0 },
    "inspectedInstallerSha256": { "$ref": "#/definitions/sha256" },
    "releaseSetId": { "$ref": "#/definitions/releaseSetId" },
    "manifestSha256": { "$ref": "#/definitions/sha256" },
    "manifestSizeBytes": { "$ref": "#/definitions/manifestSize" },
    "startupStubSha256": { "$ref": "#/definitions/sha256" },
    "startupStubSizeBytes": { "$ref": "#/definitions/startupStubSize" },
    "clientBundleSha256": { "$ref": "#/definitions/sha256" },
    "clientBundleSizeBytes": { "$ref": "#/definitions/clientBundleSize" },
    "runtimeSha256": { "$ref": "#/definitions/sha256" },
    "runtimeSizeBytes": { "$ref": "#/definitions/runtimeSize" },
    "canonicalJsonSizeBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4095
    },
    "canonicalJsonSha256": { "$ref": "#/definitions/sha256" },
    "canonicalLineSizeBytes": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4096
    },
    "canonicalLineSha256": { "$ref": "#/definitions/sha256" },
    "completedAtUtc": { "$ref": "#/definitions/wholeSecondUtc" }
  },
  "definitions": {
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "releaseSetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,127}$"
    },
    "manifestSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2097152
    },
    "startupStubSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 536870912
    },
    "clientBundleSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1073741824
    },
    "runtimeSize": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8589934592
    },
    "wholeSecondUtc": {
      "type": "string",
      "minLength": 20,
      "maxLength": 20,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    }
  }
}

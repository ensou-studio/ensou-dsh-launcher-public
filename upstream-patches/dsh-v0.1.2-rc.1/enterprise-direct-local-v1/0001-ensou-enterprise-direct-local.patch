@@ -87,0 +88,45 @@ function text(result: { content: { type: string; text?: string }[] }): string {
+/** Persist and reopen a session so its cwd comes from a real JSONL header. */
+async function restoredJsonlAgent(id: string, cwd: string): Promise<{ agent: Agent; dispose: () => Promise<void> }> {
+  const root = mkdtempSync(join(tmpdir(), 'dsh-tool-bash-restored-jsonl-'))
+  const writer = new Context()
+  const reader = new Context()
+  const sessionId = SessionId(id)
+  const active = Session.create(sessionId, undefined, {
+    version: 0,
+    id: sessionId,
+    createdAt: 0,
+    cwd,
+    isSeeded: false,
+  })
+  setSandboxMode(active, 'workspace-write')
+  try {
+    await writer.plugin(SessionStore)
+    await writer.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+    await writer.sessionPersistence.create(active.header)
+    await writer.sessionPersistence.append(active.id, active.snapshotEvents())
+    await writer.fiber.dispose()
+
+    await reader.plugin(SessionStore)
+    await reader.plugin(JsonlSessionPersistence, { root, compression: 'none' })
+    const loaded = await reader.sessionPersistence.load(sessionId)
+    const resumed = Session.fromRestore(
+      loaded.meta.id,
+      loaded.events,
+      loaded.meta,
+      loaded.inheritedEventCount,
+    )
+    return {
+      agent: { id: sessionId, session: resumed } as unknown as Agent,
+      dispose: async () => {
+        await reader.fiber.dispose().catch(() => undefined)
+        rmSync(root, { recursive: true, force: true })
+      },
+    }
+  } catch (error) {
+    await writer.fiber.dispose().catch(() => undefined)
+    await reader.fiber.dispose().catch(() => undefined)
+    rmSync(root, { recursive: true, force: true })
+    throw error
+  }
+}
+
